{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}{{ enigme.title }} – {{ enigme.raid.raidTemplate.name }} – Zeminal{% endblock %}

{% block body %}
{# ── Lightbox plein écran ── #}
<div id="lightbox"
     onclick="this.style.display='none'"
     style="display:none"
     class="fixed inset-0 z-50 bg-black/95 flex items-center justify-center cursor-zoom-out">
    <button onclick="event.stopPropagation(); document.getElementById('lightbox').style.display='none'"
            class="absolute top-4 right-4 text-white/60 hover:text-white text-3xl leading-none z-10"
            aria-label="Fermer">✕</button>
    <img id="lightbox-img" src="" alt=""
         class="max-w-full max-h-full object-contain select-none"
         style="max-width:100vw;max-height:100vh">
</div>
<script>
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.getElementById('lightbox').style.display = 'none';
});
</script>

<div class="max-w-6xl mx-auto px-6 py-10"
     data-controller="enigme"
     data-enigme-id-value="{{ enigme.id }}"
     data-enigme-token-value="{{ csrf_token('enigme_' ~ enigme.id) }}"
     data-enigme-updated-at-value="{{ enigme.updatedAt|date('c') }}"
     data-enigme-resolved-value="{{ enigme.resolved ? 1 : 0 }}">

    {# ── Breadcrumb ── #}
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a href="{{ path('app_guild_show', {slug: enigme.raid.guild.slug}) }}"
           class="hover:text-gray-300 transition">{{ enigme.raid.guild.name }}</a>
        <span class="text-gray-700">/</span>
        <a href="{{ path('app_raid_show', {id: enigme.raid.id}) }}"
           class="hover:text-gray-300 transition">{{ enigme.raid.raidTemplate.name }}</a>
        <span class="text-gray-700">/</span>
        <span class="text-gray-300">{{ enigme.title }}</span>
    </nav>

    {# ── Bannière raid terminé ── #}
    {% if raidClosed %}
        <div class="mb-6 flex items-center gap-3 bg-gray-800/60 border border-gray-700/50 rounded-xl px-5 py-3 text-sm text-gray-400">
            <span class="text-base">🔒</span>
            Ce raid est <span class="text-white font-medium mx-1">terminé</span> — consultation en lecture seule.
        </div>
    {% endif %}

    {# ── Header ── #}
    <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-3">
            <h1 class="text-2xl font-bold text-white">{{ enigme.title }}</h1>
            <span data-enigme-target="resolvedBadge"
                  {{ not enigme.resolved ? 'hidden' : '' }}
                  class="inline-flex items-center gap-1 text-xs font-medium bg-green-900/50 text-green-400 border border-green-800/50 rounded-full px-2.5 py-1">
                Résolue
            </span>
        </div>
        {% if canComment and not raidClosed %}
            <button data-action="click->enigme#resolve"
                    data-enigme-target="resolveBtn"
                    {{ enigme.resolved ? 'hidden' : '' }}
                    class="inline-flex items-center gap-2 text-sm font-medium bg-green-700 hover:bg-green-600 text-white rounded-lg px-4 py-2 transition">
                Marquer comme résolue
            </button>
        {% endif %}
    </div>

    {# ── Two-column layout ── #}
    <div class="grid gap-6 lg:grid-cols-3">

        {# ── Left: paste + images ── #}
        <div class="lg:col-span-2 space-y-4">

            {# Paste zone — masquée si raid terminé, non-participant ou invité #}
            {% if canComment and not raidClosed %}
            <div class="{{ ui.card_classes('overflow-hidden') }}">
                <div class="px-5 py-4 border-b border-gray-800">
                    <h2 class="font-semibold text-white text-sm">Ajouter une image</h2>
                </div>
                <div class="p-5">
                    <div data-enigme-target="pasteZone"
                         data-action="click->enigme#focusPasteZone"
                         tabindex="0"
                         class="flex flex-col items-center justify-center gap-1 border-2 border-dashed border-gray-700 hover:border-indigo-600/50 rounded-xl py-10 px-6
                                text-center text-sm text-gray-500 select-none transition cursor-pointer outline-none">
                        <span class="block text-2xl mb-1">📋</span>
                        Cliquer ici puis coller une image (Ctrl+V)
                    </div>
                </div>
            </div>
            {% endif %}

            {# Images grid — en dessous #}
            <div class="{{ ui.card_classes('overflow-hidden') }}">
                <div class="px-5 py-4 border-b border-gray-800">
                    <h2 class="font-semibold text-white text-sm">Images</h2>
                </div>
                <div class="p-5">
                    <div data-enigme-target="images">
                        {% include 'enigme/_images.html.twig' with {enigme: enigme} only %}
                    </div>
                </div>
            </div>

        </div>

        {# ── Right: comments ── #}
        <div class="lg:col-span-1">
            <div class="{{ ui.card_classes('overflow-hidden flex flex-col') }}"
                 style="max-height: 36rem">
                <div class="px-5 py-4 border-b border-gray-800 shrink-0">
                    <h2 class="font-semibold text-white text-sm">Commentaires</h2>
                </div>

                <div class="flex-1 min-h-0 p-5 flex flex-col gap-4 overflow-hidden">
                    <div data-enigme-target="comments" data-controller="scroll-bottom"
                         class="flex-1 min-h-0 overflow-y-auto pr-1">
                        {% include 'enigme/_comments.html.twig' with {enigme: enigme} only %}
                    </div>

                    {% if canComment and not raidClosed %}
                    <form data-action="submit->enigme#submitComment" class="shrink-0 space-y-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('comment_enigme_' ~ enigme.id) }}">
                        <textarea name="content"
                                  data-enigme-target="commentInput"
                                  rows="3"
                                  placeholder="Écrire un commentaire…"
                                  class="w-full bg-gray-800 border border-gray-700 text-white text-sm rounded-lg px-3 py-2.5
                                         focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent
                                         resize-none placeholder-gray-600"></textarea>
                        <button type="submit"
                                class="w-full bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg py-2 transition">
                            Envoyer
                        </button>
                    </form>
                    {% elseif app.user and not raidClosed %}
                    <p class="text-xs text-red-400 text-center py-2">
                        Seuls les participants acceptés peuvent commenter.
                    </p>
                    {% elseif not app.user %}
                    <a href="{{ path('app_login') }}"
                       class="block w-full text-center text-sm text-gray-500 hover:text-indigo-400 transition py-2 border border-gray-800 rounded-lg">
                        Connectez-vous pour commenter
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>

</div>
{% endblock %}
