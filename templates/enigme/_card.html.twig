<div data-controller="enigme"
     data-enigme-id-value="{{ enigme.id }}"
     data-enigme-token-value="{{ csrf_token('enigme_' ~ enigme.id) }}"
     data-enigme-updated-at-value="{{ enigme.updatedAt|date('c') }}"
     data-enigme-resolved-value="{{ enigme.resolved ? 1 : 0 }}"
     class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">

    {# Header #}
    <div class="px-6 py-4 border-b border-gray-800 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <h3 class="font-semibold text-white">{{ enigme.title }}</h3>
            <span data-enigme-target="resolvedBadge"
                  {% if not enigme.resolved %}hidden{% endif %}
                  class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-900/60 text-green-300 border border-green-700/40">
                ✓ Résolue
            </span>
        </div>
        <button type="button"
                data-action="click->enigme#resolve"
                data-enigme-target="resolveBtn"
                {% if enigme.resolved %}hidden{% endif %}
                class="text-xs text-gray-400 hover:text-green-300 border border-gray-700 hover:border-green-700/60 rounded-lg px-3 py-1.5 transition shrink-0">
            ✓ Marquer résolue
        </button>
    </div>

    <div class="px-6 py-5 space-y-4">

        {# Images #}
        <div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Images</p>
            <div data-enigme-target="images">
                {% include 'enigme/_images.html.twig' with {enigme: enigme} only %}
            </div>
        </div>

        {# Paste zone #}
        <div data-enigme-target="pasteZone"
             data-action="paste->enigme#handlePaste"
             tabindex="0"
             class="border-2 border-dashed border-gray-700 rounded-xl p-4 text-center text-gray-500 text-sm
                    cursor-pointer hover:border-gray-600 hover:text-gray-400 focus:outline-none focus:border-indigo-500 transition">
            <span class="block text-xl mb-1">📋</span>
            Cliquer ici puis coller une image (Ctrl+V)
        </div>

        {# Comments #}
        <div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Commentaires</p>
            <div data-enigme-target="comments">
                {% include 'enigme/_comments.html.twig' with {enigme: enigme} only %}
            </div>
        </div>

        {# Comment form #}
        <form data-action="submit->enigme#submitComment" class="flex gap-2">
            <input type="hidden" name="_token" value="{{ csrf_token('comment_enigme_' ~ enigme.id) }}">
            <input type="text"
                   name="content"
                   data-enigme-target="commentInput"
                   placeholder="Ajouter un commentaire…"
                   autocomplete="off"
                   class="flex-1 bg-gray-800 border border-gray-700 text-white text-sm rounded-lg px-3 py-2
                          focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent
                          placeholder-gray-500">
            <button type="submit"
                    class="inline-flex items-center justify-center px-4 py-2 bg-indigo-600 hover:bg-indigo-500
                           text-white text-sm font-medium rounded-lg transition shrink-0">
                Envoyer
            </button>
        </form>

    </div>
</div>
