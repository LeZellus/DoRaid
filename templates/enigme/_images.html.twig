{% if enigme.images is empty %}
    <p class="text-xs text-gray-600 italic">Aucune image.</p>
{% else %}
    <div class="grid grid-cols-2 gap-3">
        {% for image in enigme.images %}
            <div class="group relative rounded-lg overflow-hidden bg-gray-800 aspect-video">
                <img src="{{ asset('uploads/enigmes/' ~ enigme.id ~ '/' ~ image.filePath) }}"
                     alt="Image {{ loop.index }}"
                     class="w-full h-full object-cover cursor-zoom-in"
                     onclick="document.getElementById('lightbox-img').src=this.src;document.getElementById('lightbox').style.display='flex'">
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent
                            text-xs text-gray-300 px-2 py-1.5
                            opacity-0 group-hover:opacity-100 transition truncate">
                    {{ image.addedBy.name }} · {{ image.createdAt|date('H:i') }}
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
