{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}{{ guild.name }} – Guilde Dofus {{ guild.server.name }} – Zeminal{% endblock %}
{% block meta_description %}Guilde Dofus {{ guild.name }} sur {{ guild.server.name }}. Rejoignez la guilde et participez à leurs raids organisés sur Zeminal.{% endblock %}
{% block og_image %}{% if guild.imagePath %}{{ canonical_url }}{{ asset('uploads/guildes/' ~ guild.slug ~ '/' ~ guild.imagePath) }}{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-6 py-10" data-controller="reveal">

    {# ── Breadcrumb + actions meneur ── #}
    <div class="flex items-center justify-between mb-6">
        <a href="{{ path('app_guild_index') }}" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-300 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Toutes les guildes
        </a>
        {% if isLeader %}
            <div class="flex items-center gap-2">
                {{ ui.link_button('✏ Modifier', path('app_guild_edit', {slug: guild.slug}), 'secondary', 'py-1.5 px-3 text-xs') }}
                <form method="post" action="{{ path('app_guild_delete', {slug: guild.slug}) }}"
                      onsubmit="return confirm('Supprimer la guilde {{ guild.name }} ? Cette action est irréversible et supprime tous les raids et membres.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_guild_' ~ guild.id) }}">
                    {{ ui.button('Supprimer', 'danger', 'submit', 'py-1.5 px-3 text-xs') }}
                </form>
            </div>
        {% endif %}
    </div>

    {# ── Bandeau demandes en attente (meneur uniquement) ── #}
    {% if isLeader and guild.pending|length > 0 %}
        <a href="{{ path('app_guild_members', {slug: guild.slug}) }}"
           class="flex items-center gap-3 px-4 py-3 mb-6 rounded-xl bg-yellow-900/30 border border-yellow-700/40 text-yellow-200 hover:bg-yellow-900/50 transition">
            <span class="text-lg shrink-0">⚠</span>
            <span class="text-sm">
                <strong>{{ guild.pending|length }} demande{{ guild.pending|length > 1 ? 's' : '' }} en attente</strong>
                pour rejoindre la guilde.
            </span>
            <span class="ml-auto text-xs text-yellow-400/70 shrink-0">Voir les membres →</span>
        </a>
    {% endif %}

    {# ── Hero ── #}
    <div class="rounded-2xl bg-gradient-to-br from-indigo-950/70 via-gray-900 to-gray-950 border border-indigo-900/30 px-8 py-7 mb-8" data-reveal>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
            <div class="flex items-center gap-5">
                {# Avatar circulaire #}
                <div class="shrink-0">
                    {% if guild.imagePath %}
                        <img src="{{ asset('uploads/guildes/' ~ guild.slug ~ '/' ~ guild.imagePath) }}"
                             alt="{{ guild.name }}"
                             class="w-20 h-20 rounded-full object-contain">
                    {% else %}
                        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-indigo-600 to-indigo-800 flex items-center justify-center text-3xl font-bold text-white">
                            {{ guild.name|slice(0,1)|upper }}
                        </div>
                    {% endif %}
                </div>
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-xs font-semibold text-indigo-400 uppercase tracking-widest">Guilde</span>
                        <span class="text-gray-700">·</span>
                        <span class="text-xs text-gray-500">{{ guild.server.name }}</span>
                        {% if not guild.hasLeader() %}
                            {{ ui.badge('Sans meneur', 'warning') }}
                        {% endif %}
                    </div>
                    <h1 class="text-4xl font-bold text-white tracking-tight">{{ guild.name }}</h1>
                    <p class="text-gray-400 text-sm mt-2">
                        {% if guild.leaderCharacter %}
                            Meneur · <span class="text-gray-200 font-medium">{{ guild.leaderCharacter.name }}</span>
                            <span class="text-gray-700 mx-2">·</span>
                        {% endif %}
                        {{ guild.createdAt|date('d/m/Y') }}
                    </p>
                    {% if guild.description %}
                        <p class="text-gray-300 text-sm mt-3 leading-relaxed max-w-xl">{{ guild.description }}</p>
                    {% elseif isLeader %}
                        <p class="text-gray-600 text-sm mt-3 italic">
                            Aucune description —
                            <a href="{{ path('app_guild_edit', {slug: guild.slug}) }}" class="text-indigo-500 hover:text-indigo-400 transition">ajoutez-en une</a>.
                        </p>
                    {% endif %}
                </div>
            </div>
            <div class="flex gap-8 shrink-0">
                <div class="text-center">
                    <div class="text-3xl font-bold text-indigo-400">{{ guild.confirmed|length }}</div>
                    <div class="text-xs text-gray-500 uppercase tracking-wider mt-0.5">membres</div>
                </div>
                <div class="text-center">
                    <div class="text-3xl font-bold text-yellow-400">{{ guild.pending|length }}</div>
                    <div class="text-xs text-gray-500 uppercase tracking-wider mt-0.5">en attente</div>
                </div>
            </div>
        </div>
    </div>

    {# ── Alerte sans meneur ── #}
    {% if isOwner and not guild.hasLeader() %}
        <div class="mb-8">
            {{ ui.alert('Votre guilde est créée. Rejoignez-la avec un personnage pour en devenir le meneur.', 'info') }}
        </div>
    {% endif %}

    {# ── Grille principale ── #}
    <div class="grid gap-6 lg:grid-cols-2" data-reveal data-reveal-delay="1">

        {# ── Membres ── #}
        <div class="{{ ui.card_classes('overflow-hidden flex flex-col') }}">
            <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                <h2 class="font-semibold text-white">
                    Membres
                    <span class="ml-1.5 text-sm font-normal text-gray-500">{{ guild.confirmed|length }}</span>
                </h2>
                {% if isLeader and guild.pending|length > 0 %}
                    <a href="{{ path('app_guild_members', {slug: guild.slug}) }}"
                       class="text-xs font-medium text-yellow-400 hover:text-yellow-300 transition">
                        {{ guild.pending|length }} en attente →
                    </a>
                {% endif %}
            </div>

            {% if guild.confirmed is empty %}
                <div class="{{ ui.card_body_classes() }}">
                    <p class="text-sm text-gray-500">Aucun membre confirmé pour l'instant.</p>
                </div>
            {% else %}
                <ul class="divide-y divide-gray-800/60 overflow-y-auto" style="max-height: 16rem">
                    {% for m in guild.confirmed %}
                        <li class="flex items-center gap-3 px-5 py-3 hover:bg-gray-800/30 transition">
                            <img src="{{ asset('classes/' ~ m.character.gameClass.name|lower ~ '.png') }}"
                                 alt="{{ m.character.gameClass.name }}"
                                 class="w-8 h-8 rounded-lg object-cover shrink-0">
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-white truncate">{{ m.character.name }}</p>
                                <p class="text-xs text-gray-500 truncate">{{ m.character.gameClass.name }}</p>
                            </div>
                            {% if m.status.value == 'leader' %}
                                <span class="text-xs font-medium text-yellow-400 shrink-0">👑 Meneur</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
                <div class="px-5 py-3 border-t border-gray-800/60 mt-auto">
                    <a href="{{ path('app_guild_members', {slug: guild.slug}) }}"
                       class="inline-flex items-center gap-1.5 text-sm text-indigo-400 hover:text-indigo-300 transition font-medium">
                        {{ isLeader ? 'Gérer les membres' : 'Voir les membres' }}
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                        </svg>
                    </a>
                </div>
            {% endif %}
        </div>

        {# ── Rejoindre ── #}
        <div class="{{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes() }}">
                <h2 class="font-semibold text-white">
                    {% if isOwner and not guild.hasLeader() %}Choisir le meneur{% else %}Rejoindre{% endif %}
                </h2>
            </div>
            <div class="{{ ui.card_body_classes() }}">
                {% if not app.user %}
                    <p class="text-sm text-gray-500 leading-relaxed mb-4">
                        Rejoignez <span class="text-gray-300">{{ guild.name }}</span> en créant un compte.
                    </p>
                    {{ ui.link_button('Se connecter', path('app_login'), 'primary') }}
                {% elseif eligible is empty %}
                    <p class="text-sm text-gray-500 leading-relaxed mb-4">
                        Aucun personnage disponible sur <span class="text-gray-300">{{ guild.server.name }}</span>.
                    </p>
                    {{ ui.link_button('+ Créer un personnage', path('app_character_new'), 'secondary') }}
                {% else %}
                    <form method="post" action="{{ path('app_guild_join', {slug: guild.slug}) }}" class="space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('join_guild_' ~ guild.id) }}">
                        <div>
                            {{ ui.label('character_id', 'Personnage') }}
                            <div class="relative" data-controller="select">
                                <select id="character_id" name="character_id" class="hidden">
                                    {% for c in eligible %}
                                        <option value="{{ c.id }}">{{ c.name }} — {{ c.gameClass.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        {{ ui.button(
                            isOwner and not guild.hasLeader() ? '👑 Devenir meneur' : 'Envoyer une demande',
                            'primary', 'submit'
                        ) }}
                    </form>
                {% endif %}
            </div>
        </div>

    </div>

    {# ── Discord (meneur seulement) ── #}
    {% if isLeader %}
    <div class="mt-6 {{ ui.card_classes('px-6 py-4 flex items-center justify-between gap-4') }}" data-reveal data-reveal-delay="2">
        <div class="flex items-center gap-3 min-w-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="shrink-0 {{ guild.discordWebhookUrl ? 'text-indigo-400' : 'text-gray-600' }}"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
            <div class="min-w-0">
                <p class="text-sm font-medium text-white">Notifications Discord</p>
                {% if guild.discordWebhookUrl %}
                    <p class="text-xs text-green-400 mt-0.5">Webhook actif — les créations de raid envoient une notification</p>
                {% else %}
                    <p class="text-xs text-gray-500 mt-0.5">Non configuré — connectez un salon Discord pour notifier votre guilde</p>
                {% endif %}
            </div>
        </div>
        <a href="{{ path('app_guild_edit', {slug: guild.slug}) }}#discord"
           class="shrink-0 text-xs font-medium px-3 py-1.5 rounded-lg border transition
                  {{ guild.discordWebhookUrl
                      ? 'border-gray-700 text-gray-400 hover:text-white hover:border-gray-500'
                      : 'border-indigo-700/60 text-indigo-400 hover:text-indigo-300 hover:border-indigo-500 bg-indigo-950/40' }}">
            {{ guild.discordWebhookUrl ? 'Modifier' : 'Configurer →' }}
        </a>
    </div>
    {% endif %}

    {# ── Raids ── #}
    <div class="mt-6 {{ ui.card_classes('overflow-hidden') }}" data-reveal data-reveal-delay="3">
        <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
            <h2 class="font-semibold text-white">Raids</h2>
            {% if app.user and canCreateRaidCharacters is not empty %}
                {{ ui.link_button('+ Créer un raid', path('app_raid_new', {guild: guild.id}), 'primary', 'py-1.5 px-3 text-xs') }}
            {% endif %}
        </div>

        {% if activeRaids is empty and closedRaids is empty %}
            <div class="{{ ui.card_body_classes('py-8 text-center') }}">
                <p class="text-gray-500 text-sm">Aucun raid pour l'instant.</p>
                {% if app.user and canCreateRaidCharacters is not empty %}
                    <div class="mt-3">
                        {{ ui.link_button('Créer le premier raid', path('app_raid_new', {guild: guild.id}), 'secondary') }}
                    </div>
                {% endif %}
            </div>
        {% else %}

            {# Macro locale pour éviter la duplication #}
            {% macro raid_item(raid) %}
                {% import 'components/_ui.html.twig' as ui %}
                <li>
                    <a href="{{ path('app_raid_show', {id: raid.id}) }}"
                       class="flex items-center gap-4 px-6 py-4 hover:bg-gray-800/30 transition">
                        {% if raid.raidTemplate.imagePath %}
                            <img src="{{ asset('uploads/raid-templates/' ~ raid.raidTemplate.imagePath) }}"
                                 alt="{{ raid.raidTemplate.name }}"
                                 class="w-10 h-10 rounded-lg object-cover shrink-0">
                        {% else %}
                            <span class="w-10 h-10 rounded-lg bg-indigo-900/40 border border-indigo-800/30 flex items-center justify-center text-lg shrink-0">⚔</span>
                        {% endif %}
                        <div class="flex-1 min-w-0 flex items-center justify-between">
                            <div class="flex-1 min-w-0">
                                <span class="font-medium text-white truncate block">{{ raid.raidTemplate.name }}</span>
                                <div class="text-xs text-gray-500 mt-0.5">
                                    par <span class="text-gray-300">{{ raid.creator.name }}</span>
                                    {% if raid.scheduledAt %}
                                        · <span class="text-indigo-400">{{ raid.scheduledAt|date('d/m/Y') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="flex items-center gap-3 shrink-0 ml-4">
                                <span class="text-sm text-indigo-400">
                                    {{ raid.participants|length }}<span class="text-gray-600">/{{ raid.raidTemplate.maxParticipants }}</span>
                                    <span class="text-gray-500 ml-0.5">joueurs</span>
                                </span>
                                <span class="text-indigo-600">→</span>
                            </div>
                        </div>
                    </a>
                </li>
            {% endmacro %}

            {% if activeRaids is not empty %}
                <div class="px-6 py-2 bg-gray-800/20 border-b border-gray-800/60 flex items-center justify-between">
                    <span class="text-xs font-semibold text-green-400 uppercase tracking-wider">En cours</span>
                    <span class="text-xs text-gray-500">{{ activeRaids|length }} raid{{ activeRaids|length > 1 ? 's' : '' }}</span>
                </div>
                <ul class="divide-y divide-gray-800/60 overflow-y-auto" style="max-height: 20rem">
                    {% for raid in activeRaids %}{{ _self.raid_item(raid) }}{% endfor %}
                </ul>
            {% endif %}

            {% if closedRaids is not empty %}
                <div class="px-6 py-2 bg-gray-800/20 {{ activeRaids is not empty ? 'border-t' : '' }} border-b border-gray-800/60 flex items-center justify-between">
                    <span class="text-xs font-semibold text-red-400 uppercase tracking-wider">Terminés</span>
                    <span class="text-xs text-gray-500">{{ closedRaids|length }} raid{{ closedRaids|length > 1 ? 's' : '' }}</span>
                </div>
                <ul class="divide-y divide-gray-800/60 overflow-y-auto opacity-60" style="max-height: 14rem">
                    {% for raid in closedRaids %}{{ _self.raid_item(raid) }}{% endfor %}
                </ul>
            {% endif %}

        {% endif %}
    </div>

</div>
{% endblock %}
