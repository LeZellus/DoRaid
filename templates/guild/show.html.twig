{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}{{ guild.name }} – DoRaid{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-6 py-10">

    {# ── Breadcrumb + actions meneur ── #}
    <div class="flex items-center justify-between mb-6">
        <a href="{{ path('app_guild_index') }}" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-300 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Toutes les guildes
        </a>
        {% if isLeader %}
            <form method="post" action="{{ path('app_guild_delete', {slug: guild.slug}) }}"
                  onsubmit="return confirm('Supprimer la guilde {{ guild.name }} ? Cette action est irréversible et supprime tous les raids et membres.')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_guild_' ~ guild.id) }}">
                {{ ui.button('Supprimer la guilde', 'danger', 'submit', 'py-1.5 px-3 text-xs') }}
            </form>
        {% endif %}
    </div>

    {# ── Hero ── #}
    <div class="rounded-2xl bg-gradient-to-br from-indigo-950/70 via-gray-900 to-gray-950 border border-indigo-900/30 px-8 py-7 mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-xs font-semibold text-indigo-400 uppercase tracking-widest">Guilde</span>
                    <span class="text-gray-700">·</span>
                    <span class="text-xs text-gray-500">{{ guild.server.name }}</span>
                    {% if not guild.hasLeader() %}
                        {{ ui.badge('Sans meneur', 'warning') }}
                    {% endif %}
                </div>
                <h1 class="text-4xl font-bold text-white tracking-tight">{{ guild.name }}</h1>
                <p class="text-gray-400 text-sm mt-2">
                    Fondée par <span class="text-gray-200 font-medium">{{ guild.owner.username }}</span>
                    <span class="text-gray-700 mx-2">·</span>
                    {{ guild.createdAt|date('d/m/Y') }}
                </p>
                {% if guild.description %}
                    <p class="text-gray-300 text-sm mt-3 leading-relaxed max-w-xl">{{ guild.description }}</p>
                {% elseif isLeader %}
                    <p class="text-gray-600 text-sm mt-3 italic">Aucune description — ajoutez-en une ci-dessous.</p>
                {% endif %}
            </div>
            <div class="flex gap-8 shrink-0">
                <div class="text-center">
                    <div class="text-3xl font-bold text-indigo-400">{{ guild.confirmed|length }}</div>
                    <div class="text-xs text-gray-500 uppercase tracking-wider mt-0.5">membres</div>
                </div>
                <div class="text-center">
                    <div class="text-3xl font-bold text-yellow-400">{{ guild.pending|length }}</div>
                    <div class="text-xs text-gray-500 uppercase tracking-wider mt-0.5">en attente</div>
                </div>
            </div>
        </div>
    </div>

    {# ── Description (meneur) ── #}
    {% if isLeader %}
        <div class="{{ ui.card_classes('overflow-hidden mb-6') }}">
            <div class="{{ ui.card_header_classes() }}">
                <h2 class="font-semibold text-white text-sm">Description de la guilde</h2>
            </div>
            <div class="{{ ui.card_body_classes() }}">
                {{ form_start(descriptionForm) }}
                {{ form_widget(descriptionForm.description, {
                    attr: { class: 'w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder-gray-500 resize-y' }
                }) }}
                {{ form_errors(descriptionForm.description) }}
                <div class="flex justify-end mt-3">
                    {{ ui.button('Enregistrer', 'primary', 'submit', 'py-2 px-4 text-sm') }}
                </div>
                {{ form_end(descriptionForm) }}
            </div>
        </div>
    {% endif %}

    {# ── Alerte sans meneur ── #}
    {% if isOwner and not guild.hasLeader() %}
        <div class="mb-8">
            {{ ui.alert('Votre guilde est créée. Rejoignez-la avec un personnage pour en devenir le meneur.', 'info') }}
        </div>
    {% endif %}

    {# ── Grille principale ── #}
    <div class="grid gap-6 lg:grid-cols-2">

        {# ── Membres (widget compact) ── #}
        <div class="{{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                <h2 class="font-semibold text-white">Membres</h2>
                {% if isLeader and guild.pending|length > 0 %}
                    <a href="{{ path('app_guild_members', {slug: guild.slug}) }}"
                       class="text-xs font-medium text-yellow-400 hover:text-yellow-300 transition">
                        {{ guild.pending|length }} en attente →
                    </a>
                {% endif %}
            </div>
            <div class="{{ ui.card_body_classes() }}">
                {% if guild.confirmed is empty %}
                    <p class="text-sm text-gray-500">Aucun membre confirmé pour l'instant.</p>
                {% else %}
                    <div class="flex flex-nowrap gap-2 mb-4 overflow-hidden">
                        {% for m in guild.confirmed|slice(0, 7) %}
                            {% if m.status.value == 'leader' %}
                                <div class="w-9 h-9 rounded-full bg-yellow-900/40 border border-yellow-700/50 flex items-center justify-center text-sm font-bold text-yellow-300 shrink-0"
                                     title="{{ m.character.name }} 👑">
                                    {{ m.character.name|slice(0,1)|upper }}
                                </div>
                            {% else %}
                                <div class="w-9 h-9 rounded-full bg-indigo-900/30 border border-indigo-800/40 flex items-center justify-center text-sm font-bold text-indigo-300 shrink-0"
                                     title="{{ m.character.name }}">
                                    {{ m.character.name|slice(0,1)|upper }}
                                </div>
                            {% endif %}
                        {% endfor %}
                        {% if guild.confirmed|length > 7 %}
                            <div class="w-9 h-9 rounded-full bg-gray-800/60 border border-gray-700 flex items-center justify-center text-xs font-bold text-gray-400 shrink-0">
                                +{{ guild.confirmed|length - 7 }}
                            </div>
                        {% endif %}
                    </div>
                    <a href="{{ path('app_guild_members', {slug: guild.slug}) }}"
                       class="inline-flex items-center gap-1.5 text-sm text-indigo-400 hover:text-indigo-300 transition font-medium">
                        Voir les {{ guild.confirmed|length }} membres
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                        </svg>
                    </a>
                {% endif %}
            </div>
        </div>

        {# ── Rejoindre ── #}
        <div class="{{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes() }}">
                <h2 class="font-semibold text-white">
                    {% if isOwner and not guild.hasLeader() %}Choisir le meneur{% else %}Rejoindre{% endif %}
                </h2>
            </div>
            <div class="{{ ui.card_body_classes() }}">
                {% if eligible is empty %}
                    <p class="text-sm text-gray-500 leading-relaxed mb-4">
                        Aucun personnage disponible sur <span class="text-gray-300">{{ guild.server.name }}</span>.
                    </p>
                    {{ ui.link_button('+ Créer un personnage', path('app_character_new'), 'secondary') }}
                {% else %}
                    <form method="post" action="{{ path('app_guild_join', {slug: guild.slug}) }}" class="space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('join_guild_' ~ guild.id) }}">
                        <div>
                            {{ ui.label('character_id', 'Personnage') }}
                            <select id="character_id" name="character_id"
                                class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                                {% for c in eligible %}
                                    <option value="{{ c.id }}">{{ c.name }} — {{ c.gameClass.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        {{ ui.button(
                            isOwner and not guild.hasLeader() ? '👑 Devenir meneur' : 'Envoyer une demande',
                            'primary', 'submit'
                        ) }}
                    </form>
                {% endif %}
            </div>
        </div>

    </div>

    {# ── Raids ── #}
    <div class="mt-6 {{ ui.card_classes('overflow-hidden') }}">
        <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
            <h2 class="font-semibold text-white">Raids</h2>
            {% if confirmedCharacters is not empty %}
                {{ ui.link_button('+ Créer un raid', path('app_raid_new', {guild: guild.id}), 'primary', 'py-1.5 px-3 text-xs') }}
            {% endif %}
        </div>

        {% if raids is empty %}
            <div class="{{ ui.card_body_classes('py-8 text-center') }}">
                <p class="text-gray-500 text-sm">Aucun raid pour l'instant.</p>
                {% if confirmedCharacters is not empty %}
                    <div class="mt-3">
                        {{ ui.link_button('Créer le premier raid', path('app_raid_new', {guild: guild.id}), 'secondary') }}
                    </div>
                {% endif %}
            </div>
        {% else %}
            <ul class="divide-y divide-gray-800/60">
                {% for raid in raids %}
                    <li>
                        <a href="{{ path('app_raid_show', {id: raid.id}) }}"
                           class="flex items-center justify-between px-6 py-4 hover:bg-gray-800/30 transition">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-white truncate">{{ raid.raidTemplate.name }}</span>
                                    {% if raid.status.value == 'open' %}
                                        {{ ui.badge(raid.status.label(), 'success') }}
                                    {% else %}
                                        {{ ui.badge(raid.status.label(), 'default') }}
                                    {% endif %}
                                </div>
                                <div class="text-xs text-gray-500 mt-0.5">
                                    par <span class="text-gray-300">{{ raid.creator.name }}</span>
                                    {% if raid.scheduledAt %}
                                        · <span class="text-indigo-400">{{ raid.scheduledAt|date('d/m/Y') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="flex items-center gap-3 shrink-0 ml-4">
                                <span class="text-sm text-indigo-400">
                                    {{ raid.participants|length }}<span class="text-gray-600">/{{ raid.raidTemplate.maxParticipants }}</span>
                                    <span class="text-gray-500 ml-0.5">joueurs</span>
                                </span>
                                <span class="text-indigo-600">→</span>
                            </div>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

</div>
{% endblock %}
