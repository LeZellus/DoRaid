{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}{{ guild.name }} – DoRaid{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-6 py-10">

    {# ── Breadcrumb ── #}
    <a href="{{ path('app_guild_index') }}" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-300 transition mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        Toutes les guildes
    </a>

    {# ── Hero ── #}
    <div class="rounded-2xl bg-gradient-to-br from-indigo-950/70 via-gray-900 to-gray-950 border border-indigo-900/30 px-8 py-7 mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-xs font-semibold text-indigo-400 uppercase tracking-widest">Guilde</span>
                    <span class="text-gray-700">·</span>
                    <span class="text-xs text-gray-500">{{ guild.server.name }}</span>
                    {% if not guild.hasLeader() %}
                        {{ ui.badge('Sans meneur', 'warning') }}
                    {% endif %}
                </div>
                <h1 class="text-4xl font-bold text-white tracking-tight">{{ guild.name }}</h1>
                <p class="text-gray-400 text-sm mt-2">
                    Fondée par <span class="text-gray-200 font-medium">{{ guild.owner.username }}</span>
                    <span class="text-gray-700 mx-2">·</span>
                    {{ guild.createdAt|date('d/m/Y') }}
                </p>
            </div>
            <div class="flex gap-8 shrink-0">
                <div class="text-center">
                    <div class="text-3xl font-bold text-white">{{ guild.confirmed|length }}</div>
                    <div class="text-xs text-gray-500 uppercase tracking-wider mt-0.5">membres</div>
                </div>
                <div class="text-center">
                    <div class="text-3xl font-bold text-white">{{ guild.pending|length }}</div>
                    <div class="text-xs text-gray-500 uppercase tracking-wider mt-0.5">en attente</div>
                </div>
            </div>
        </div>
    </div>

    {# ── Alerte sans meneur ── #}
    {% if isOwner and not guild.hasLeader() %}
        <div class="mb-8">
            {{ ui.alert('Votre guilde est créée. Rejoignez-la avec un personnage pour en devenir le meneur.', 'info') }}
        </div>
    {% endif %}

    {# ── Grille principale ── #}
    <div class="grid gap-6 lg:grid-cols-5">

        {# ── Membres — 3/5 ── #}
        <div class="lg:col-span-3 {{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                <h2 class="font-semibold text-white">Membres</h2>
                {% if guild.confirmed|length > 0 %}
                    <span class="text-xs text-gray-500">{{ guild.confirmed|length }} confirmé{{ guild.confirmed|length > 1 ? 's' : '' }}</span>
                {% endif %}
            </div>

            {% if guild.confirmed is empty %}
                <div class="{{ ui.card_body_classes('py-10 text-center') }}">
                    <p class="text-gray-500 text-sm">Aucun membre confirmé pour l'instant.</p>
                </div>
            {% else %}
                <ul class="divide-y divide-gray-800/60">
                    {% for m in guild.confirmed %}
                        <li class="flex items-center gap-4 px-6 py-3.5 hover:bg-gray-800/30 transition">
                            <div class="w-9 h-9 rounded-full bg-gray-800 border border-gray-700 flex items-center justify-center text-sm font-bold text-gray-300 shrink-0">
                                {{ m.character.name|slice(0,1)|upper }}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-white truncate">{{ m.character.name }}</span>
                                    {% if m.status.value == 'leader' %}<span title="Meneur" class="text-base leading-none">👑</span>{% endif %}
                                </div>
                                <div class="flex items-center gap-1.5 mt-0.5">
                                    <span class="text-xs text-gray-400">{{ m.character.gameClass.name }}</span>
                                    {% if m.character.user == app.user %}
                                        <span class="text-xs text-indigo-400 font-medium">· vous</span>
                                    {% else %}
                                        <span class="text-xs text-gray-600">· {{ m.character.user.username }}</span>
                                        {{ ui.whisper(m.character.name) }}
                                    {% endif %}
                                </div>
                            </div>
                            {% if m.character.user == app.user and m.status.value != 'leader' %}
                                <form method="post" action="{{ path('app_guild_leave', {id: m.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('leave_' ~ m.id) }}">
                                    {{ ui.button('Quitter', 'ghost', 'submit', 'py-1.5 px-3 text-xs') }}
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        {# ── Rejoindre — 2/5 ── #}
        <div class="lg:col-span-2 {{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes() }}">
                <h2 class="font-semibold text-white">
                    {% if isOwner and not guild.hasLeader() %}Choisir le meneur{% else %}Rejoindre{% endif %}
                </h2>
            </div>
            <div class="{{ ui.card_body_classes() }}">
                {% if eligible is empty %}
                    <p class="text-sm text-gray-500 leading-relaxed mb-4">
                        Aucun personnage disponible sur <span class="text-gray-300">{{ guild.server.name }}</span>.
                    </p>
                    {{ ui.link_button('+ Créer un personnage', path('app_character_new'), 'secondary') }}
                {% else %}
                    <form method="post" action="{{ path('app_guild_join', {id: guild.id}) }}" class="space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('join_guild_' ~ guild.id) }}">
                        <div>
                            {{ ui.label('character_id', 'Personnage') }}
                            <select id="character_id" name="character_id"
                                class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                                {% for c in eligible %}
                                    <option value="{{ c.id }}">{{ c.name }} — {{ c.gameClass.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        {{ ui.button(
                            isOwner and not guild.hasLeader() ? '👑 Devenir meneur' : 'Envoyer une demande',
                            'primary', 'submit'
                        ) }}
                    </form>
                {% endif %}
            </div>
        </div>

    </div>

    {# ── Demandes en attente ── #}
    {% if isOwner and guild.pending|length > 0 %}
        <div class="mt-6 {{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes('flex items-center gap-3') }}">
                <h2 class="font-semibold text-white">Demandes en attente</h2>
                {{ ui.badge(guild.pending|length, 'warning') }}
            </div>
            <ul class="divide-y divide-gray-800/60">
                {% for m in guild.pending %}
                    <li class="flex items-center gap-4 px-6 py-3.5">
                        <div class="w-9 h-9 rounded-full bg-gray-800 border border-gray-700 flex items-center justify-center text-sm font-bold text-gray-400 shrink-0">
                            {{ m.character.name|slice(0,1)|upper }}
                        </div>
                        <div class="flex-1 min-w-0">
                            <span class="font-medium text-white">{{ m.character.name }}</span>
                            <div class="text-xs text-gray-500 mt-0.5">{{ m.character.gameClass.name }} · {{ m.character.user.username }}</div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <form method="post" action="{{ path('app_guild_approve', {id: m.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('membership_' ~ m.id) }}">
                                {{ ui.button('Accepter', 'success', 'submit', 'py-1.5 px-3 text-xs') }}
                            </form>
                            <form method="post" action="{{ path('app_guild_reject', {id: m.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('membership_' ~ m.id) }}">
                                {{ ui.button('Refuser', 'danger', 'submit', 'py-1.5 px-3 text-xs') }}
                            </form>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {# ── Raids ── #}
    <div class="mt-6 {{ ui.card_classes('overflow-hidden') }}">
        <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
            <h2 class="font-semibold text-white">Raids</h2>
            {% if confirmedCharacters is not empty %}
                {{ ui.link_button('+ Créer un raid', path('app_raid_new', {guild: guild.id}), 'primary', 'py-1.5 px-3 text-xs') }}
            {% endif %}
        </div>

        {% if raids is empty %}
            <div class="{{ ui.card_body_classes('py-8 text-center') }}">
                <p class="text-gray-500 text-sm">Aucun raid pour l'instant.</p>
                {% if confirmedCharacters is not empty %}
                    <div class="mt-3">
                        {{ ui.link_button('Créer le premier raid', path('app_raid_new', {guild: guild.id}), 'secondary') }}
                    </div>
                {% endif %}
            </div>
        {% else %}
            <ul class="divide-y divide-gray-800/60">
                {% for raid in raids %}
                    <li>
                        <a href="{{ path('app_raid_show', {id: raid.id}) }}"
                           class="flex items-center justify-between px-6 py-4 hover:bg-gray-800/30 transition">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-white truncate">{{ raid.raidTemplate.name }}</span>
                                    {% if raid.status.value == 'open' %}
                                        {{ ui.badge(raid.status.label(), 'success') }}
                                    {% else %}
                                        {{ ui.badge(raid.status.label(), 'default') }}
                                    {% endif %}
                                </div>
                                <div class="text-xs text-gray-500 mt-0.5">
                                    par {{ raid.creator.name }}
                                    {% if raid.scheduledAt %}
                                        · {{ raid.scheduledAt|date('d/m/Y') }}
                                    {% endif %}
                                </div>
                            </div>
                            <div class="flex items-center gap-3 shrink-0 ml-4">
                                <span class="text-sm text-gray-400">
                                    {{ raid.participants|length }} / {{ raid.raidTemplate.maxParticipants }}
                                    <span class="text-gray-600 ml-0.5">joueurs</span>
                                </span>
                                <span class="text-gray-600">→</span>
                            </div>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

</div>
{% endblock %}
