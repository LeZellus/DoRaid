{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Modifier {{ guild.name }} – Zeminal{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-6 py-10">

    <a href="{{ path('app_guild_show', {slug: guild.slug}) }}"
       class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-300 transition mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        {{ guild.name }}
    </a>

    {# ── Hero ── #}
    <div class="rounded-2xl bg-gradient-to-br from-indigo-950/60 via-gray-900 to-gray-950 border border-indigo-900/30 px-8 py-6 mb-8">
        <div class="flex items-center gap-5">
            {% if guild.imagePath %}
                <img src="{{ asset('uploads/guildes/' ~ guild.slug ~ '/' ~ guild.imagePath) }}"
                     alt="{{ guild.name }}"
                     class="w-16 h-16 rounded-full object-contain shrink-0">
            {% else %}
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-indigo-600 to-indigo-800 flex items-center justify-center text-2xl font-bold text-white shrink-0">
                    {{ guild.name|slice(0,1)|upper }}
                </div>
            {% endif %}
            <div>
                <p class="text-xs font-semibold text-indigo-400 uppercase tracking-widest mb-1">Modifier la guilde</p>
                <h1 class="text-2xl font-bold text-white leading-tight">{{ guild.name }}</h1>
                <p class="text-sm text-gray-500 mt-1">{{ guild.server.name }}</p>
            </div>
        </div>
    </div>

    {{ form_start(form, {attr: {enctype: 'multipart/form-data', class: 'space-y-4'}}) }}

        {# ── Nom ── #}
        <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-800">
                <h2 class="font-semibold text-white text-sm">Nom</h2>
            </div>
            <div class="px-6 py-5">
                {{ ui.label('guild_edit_name', 'Nom de la guilde') }}
                {{ form_widget(form.name, {
                    attr: { class: 'w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent' }
                }) }}
                {{ form_errors(form.name) }}
                <p class="text-xs text-gray-600 mt-2">L'URL de la guilde (<span class="font-mono text-gray-500">/guildes/{{ guild.slug }}</span>) ne change pas si vous renommez la guilde.</p>
            </div>
        </div>

        {# ── Image ── #}
        <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-800">
                <h2 class="font-semibold text-white text-sm">Image de couverture</h2>
            </div>
            <div class="px-6 py-5">
                {% if guild.imagePath %}
                    <div class="mb-4 flex items-center gap-4">
                        <img src="{{ asset('uploads/guildes/' ~ guild.slug ~ '/' ~ guild.imagePath) }}"
                             alt="Image actuelle"
                             class="w-20 h-20 rounded-full object-contain">
                        <p class="text-xs text-gray-500">Image actuelle — sélectionnez un nouveau fichier pour la remplacer.</p>
                    </div>
                {% endif %}
                <p class="text-xs text-gray-500 mb-3">
                    Pas encore de blason ? Créez-en un gratuitement sur
                    <a href="https://skin.souff.fr/" target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:text-indigo-300 underline">skin.souff.fr</a>,
                    puis téléchargez-le ci-dessous.
                </p>
                <label class="block">
                    <span class="block text-sm font-medium text-gray-300 mb-2">
                        {{ guild.imagePath ? 'Nouvelle image' : 'Choisir une image' }}
                        <span class="text-gray-600 font-normal">(JPG, PNG, WebP — max 2 Mo)</span>
                    </span>
                    {{ form_widget(form.imageFile, {
                        attr: {
                            class: 'block w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-600 file:text-white hover:file:bg-indigo-500 file:cursor-pointer cursor-pointer'
                        }
                    }) }}
                    {{ form_errors(form.imageFile) }}
                </label>
            </div>
        </div>

        {# ── Description ── #}
        <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-800">
                <h2 class="font-semibold text-white text-sm">Description</h2>
            </div>
            <div class="px-6 py-5">
                {{ form_widget(form.description, {
                    attr: {
                        class: 'w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder-gray-500 resize-y',
                        placeholder: 'Présentez votre guilde, vos objectifs, votre style de jeu…'
                    }
                }) }}
                {{ form_errors(form.description) }}
            </div>
        </div>

        {# ── Discord ── #}
        <div id="discord" class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-800 flex items-center gap-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-indigo-400 shrink-0"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
                <h2 class="font-semibold text-white text-sm">Intégration Discord</h2>
            </div>
            <div class="px-6 py-5 space-y-4">
                <ol class="space-y-3">
                    <li class="flex items-start gap-3 text-xs text-gray-400">
                        <span class="shrink-0 mt-0.5 w-5 h-5 rounded-full bg-indigo-900/60 border border-indigo-800/60 flex items-center justify-center text-indigo-300 font-bold" style="font-size:10px">1</span>
                        <span>Sur votre serveur Discord, faites un clic droit sur le salon souhaité → <span class="text-gray-200">Modifier le salon</span></span>
                    </li>
                    <li class="flex items-start gap-3 text-xs text-gray-400">
                        <span class="shrink-0 mt-0.5 w-5 h-5 rounded-full bg-indigo-900/60 border border-indigo-800/60 flex items-center justify-center text-indigo-300 font-bold" style="font-size:10px">2</span>
                        <span>Allez dans l'onglet <span class="text-gray-200">Intégrations</span> → <span class="text-gray-200">Webhooks</span> → cliquez sur <span class="text-gray-200">Nouveau webhook</span></span>
                    </li>
                    <li class="flex items-start gap-3 text-xs text-gray-400">
                        <span class="shrink-0 mt-0.5 w-5 h-5 rounded-full bg-indigo-900/60 border border-indigo-800/60 flex items-center justify-center text-indigo-300 font-bold" style="font-size:10px">3</span>
                        <span>Donnez-lui un nom (ex : <span class="text-gray-200 font-mono">Zeminal</span>), puis cliquez sur <span class="text-gray-200">Copier l'URL du webhook</span> et collez-la ci-dessous</span>
                    </li>
                </ol>
                {{ form_widget(form.discordWebhookUrl, {
                    attr: {
                        class: 'w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder-gray-600'
                    }
                }) }}
                {{ form_errors(form.discordWebhookUrl) }}
                <p class="text-xs text-gray-600">Une notification sera envoyée automatiquement sur Discord à chaque création de raid.</p>
            </div>
        </div>

        {# ── Actions ── #}
        <div class="flex items-center gap-3 pt-2">
            {{ ui.button('Enregistrer les modifications', 'primary', 'submit', 'flex-1') }}
            {{ ui.link_button('Annuler', path('app_guild_show', {slug: guild.slug}), 'secondary', 'flex-1') }}
        </div>

    {{ form_end(form) }}

</div>
{% endblock %}
