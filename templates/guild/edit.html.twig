{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Modifier {{ guild.name }} – DoRaid{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-6 py-10">

    {# ── Breadcrumb ── #}
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a href="{{ path('app_guild_index') }}" class="hover:text-gray-300 transition">Guildes</a>
        <span class="text-gray-700">/</span>
        <a href="{{ path('app_guild_show', {slug: guild.slug}) }}" class="hover:text-gray-300 transition">{{ guild.name }}</a>
        <span class="text-gray-700">/</span>
        <span class="text-gray-300">Modifier</span>
    </nav>

    <h1 class="text-2xl font-bold text-white mb-8">Modifier la guilde</h1>

    {{ form_start(form, {attr: {enctype: 'multipart/form-data', class: 'space-y-6'}}) }}

        {# ── Nom ── #}
        <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-800">
                <h2 class="font-semibold text-white text-sm">Nom</h2>
            </div>
            <div class="px-6 py-5">
                {{ ui.label('guild_edit_name', 'Nom de la guilde') }}
                {{ form_widget(form.name, {
                    attr: { class: 'w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent' }
                }) }}
                {{ form_errors(form.name) }}
                <p class="text-xs text-gray-600 mt-2">Changer le nom met aussi à jour l'URL de la guilde.</p>
            </div>
        </div>

        {# ── Image ── #}
        <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-800">
                <h2 class="font-semibold text-white text-sm">Image de couverture</h2>
            </div>
            <div class="px-6 py-5">
                {% if guild.imagePath %}
                    <div class="mb-4">
                        <img src="{{ asset('uploads/guildes/' ~ guild.slug ~ '/' ~ guild.imagePath) }}"
                             alt="Image actuelle"
                             class="h-32 w-full object-cover rounded-xl border border-gray-700">
                        <p class="text-xs text-gray-500 mt-1">Image actuelle — sélectionnez un nouveau fichier pour la remplacer.</p>
                    </div>
                {% endif %}
                <label class="block">
                    <span class="block text-sm font-medium text-gray-300 mb-2">
                        {{ guild.imagePath ? 'Nouvelle image' : 'Choisir une image' }}
                        <span class="text-gray-600 font-normal">(JPG, PNG, WebP — max 2 Mo)</span>
                    </span>
                    {{ form_widget(form.imageFile, {
                        attr: {
                            class: 'block w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-600 file:text-white hover:file:bg-indigo-500 file:cursor-pointer cursor-pointer'
                        }
                    }) }}
                    {{ form_errors(form.imageFile) }}
                </label>
            </div>
        </div>

        {# ── Description ── #}
        <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-800">
                <h2 class="font-semibold text-white text-sm">Description</h2>
            </div>
            <div class="px-6 py-5">
                {{ form_widget(form.description, {
                    attr: {
                        class: 'w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder-gray-500 resize-y',
                        placeholder: 'Présentez votre guilde, vos objectifs, votre style de jeu…'
                    }
                }) }}
                {{ form_errors(form.description) }}
            </div>
        </div>

        {# ── Actions ── #}
        <div class="flex items-center justify-between pt-2">
            <a href="{{ path('app_guild_show', {slug: guild.slug}) }}"
               class="text-sm text-gray-500 hover:text-gray-300 transition">
                ← Annuler
            </a>
            {{ ui.button('Enregistrer les modifications', 'primary', 'submit') }}
        </div>

    {{ form_end(form) }}

</div>
{% endblock %}
