{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Guildes – DoRaid{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-6 py-12">

    {# ── En-tête ── #}
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Guildes</h1>
            {% set total = 0 %}
            {% for _, guilds in byServer %}{% set total = total + guilds|length %}{% endfor %}
            <p class="text-sm text-gray-500 mt-1">{{ total }} guilde{{ total > 1 ? 's' : '' }}</p>
        </div>
        {{ ui.link_button('+ Créer une guilde', path('app_guild_new'), 'primary') }}
    </div>

    {% if byServer is empty %}
        <div class="{{ ui.card_classes('p-12 text-center') }}">
            <p class="text-gray-400 text-lg mb-6">Aucune guilde pour l'instant.</p>
            {{ ui.link_button('Créer la première guilde', path('app_guild_new'), 'primary') }}
        </div>
    {% else %}

        {# ── Barre de recherche + filtres serveur ── #}
        <div class="flex flex-col sm:flex-row gap-3 mb-6">
            <div class="relative flex-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500 pointer-events-none" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
                </svg>
                <input
                    id="guild-search"
                    type="text"
                    placeholder="Rechercher une guilde…"
                    autocomplete="off"
                    class="w-full bg-gray-900 border border-gray-700 text-white rounded-lg pl-10 pr-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder-gray-600"
                >
            </div>

            {% set preselectedServer = app.request.query.get('server', '') %}
            <select id="guild-server-filter"
                class="bg-gray-900 border border-gray-700 text-white rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                <option value="">Tous les serveurs</option>
                {% for serverName, guilds in byServer %}
                    <option value="{{ serverName }}" {{ serverName == preselectedServer ? 'selected' : '' }}>
                        {{ serverName }} ({{ guilds|length }})
                    </option>
                {% endfor %}
            </select>
        </div>

        {# ── Grille des guildes ── #}
        <div id="guild-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {% for serverName, guilds in byServer %}
                {% for guild in guilds %}
                    {% set memberCount = guild.confirmed|length %}
                    {% set raidCount   = guild.raids|length %}
                    <a href="{{ path('app_guild_show', {id: guild.id}) }}"
                       class="guild-card group block rounded-2xl bg-gray-900 border border-gray-800 hover:border-indigo-700/60 transition-all hover:shadow-lg hover:shadow-indigo-950/30"
                       data-name="{{ guild.name|lower }}"
                       data-server="{{ serverName }}">
                        <div class="p-5">
                            <div class="flex items-start gap-4">
                                {# Avatar initiale #}
                                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-600 to-indigo-800 flex items-center justify-center text-lg font-bold text-white shrink-0 group-hover:from-indigo-500 group-hover:to-indigo-700 transition-all">
                                    {{ guild.name|slice(0,1)|upper }}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="font-semibold text-white truncate group-hover:text-indigo-300 transition">
                                            {{ guild.name }}
                                        </span>
                                    </div>
                                    <div class="text-xs text-gray-500 mt-0.5">par <span class="text-gray-300">{{ guild.owner.username }}</span></div>
                                    <span class="inline-block mt-2 text-xs font-medium bg-indigo-900/20 border border-indigo-800/30 text-indigo-400 rounded-full px-2 py-0.5">
                                        ⚔ {{ serverName }}
                                    </span>
                                </div>
                            </div>

                            <div class="flex items-center gap-4 mt-4 pt-4 border-t border-gray-800/60">
                                <div class="flex items-center gap-1.5 text-xs text-blue-400">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-blue-500" viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
                                    </svg>
                                    <span>{{ memberCount }} membre{{ memberCount > 1 ? 's' : '' }}</span>
                                </div>
                                {% if raidCount > 0 %}
                                    <div class="flex items-center gap-1.5 text-xs text-yellow-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-yellow-500" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
                                        </svg>
                                        <span>{{ raidCount }} raid{{ raidCount > 1 ? 's' : '' }}</span>
                                    </div>
                                {% endif %}
                                <div class="ml-auto text-xs text-gray-500">
                                    {{ guild.createdAt|date('d/m/Y') }}
                                </div>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            {% endfor %}
        </div>

        {# Message aucun résultat #}
        <div id="no-results" class="hidden text-center py-16">
            <p class="text-gray-500 text-sm">Aucune guilde ne correspond à votre recherche.</p>
        </div>

    {% endif %}

</div>

<script>
(function () {
    const searchInput  = document.getElementById('guild-search');
    const serverSelect = document.getElementById('guild-server-filter');
    const cards        = document.querySelectorAll('.guild-card');
    const noResults    = document.getElementById('no-results');
    const grid         = document.getElementById('guild-grid');

    function applyFilters() {
        const term   = searchInput.value.toLowerCase().trim();
        const server = serverSelect.value;
        let visible  = 0;
        cards.forEach(card => {
            const show = card.dataset.name.includes(term) && (server === '' || card.dataset.server === server);
            card.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        noResults.classList.toggle('hidden', visible > 0);
        grid.classList.toggle('hidden', visible === 0);
    }

    searchInput.addEventListener('input', applyFilters);
    serverSelect.addEventListener('change', applyFilters);

    if (serverSelect.value) applyFilters();
})();
</script>
{% endblock %}
