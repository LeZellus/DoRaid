{#
  Ligne de participation à un raid (countdown + lien).
  Variables:
    participation — RaidParticipant
    compact       — bool, default false  (mode dashboard : image plus petite, moins de détails)
#}
{% import 'components/_ui.html.twig' as ui %}
{% set raid     = participation.raid %}
{% set accepted = participation.status.value == 'Accepted' %}
{% set compact  = compact ?? false %}
{% set px       = compact ? 'px-5' : 'px-6' %}
{% set imgCls   = compact ? 'w-14 h-14 rounded-xl' : 'w-11 h-11 rounded-xl' %}
{% set imgSize  = compact ? 56 : 44 %}

<li class="{{ compact ? 'px-3 py-1.5' : '' }}">
    {% if compact %}<div class="rounded-xl border border-gray-700/40 bg-gray-800/30 overflow-hidden">{% endif %}

    {# ── Bandeau countdown ── #}
    {% set _closed = raid.status == constant('App\\Entity\\RaidStatus::Closed') %}
    {% if _closed %}
        <div class="flex items-center gap-2 {{ px }} py-1.5 bg-gray-800/50 border-b border-gray-700/40 text-xs font-medium text-gray-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707a1 1 0 00-1.414-1.414L9 10.172 7.707 8.879a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            Raid terminé
        </div>
    {% elseif raid.scheduledAt %}
        {% if raid.scheduledAt > date() %}
            <div class="flex items-center gap-2 {{ px }} py-1.5 bg-yellow-950/50 border-b border-yellow-900/40 text-xs font-medium text-yellow-400"
                 data-countdown="{{ raid.scheduledAt|date('U') }}" data-mode="before">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                </svg>
                <span class="countdown-text">…</span>
            </div>
        {% else %}
            <div class="flex items-center gap-2 {{ px }} py-1.5 bg-green-950/40 border-b border-green-900/30 text-xs font-medium text-green-400"
                 data-countdown="{{ raid.scheduledAt|date('U') }}" data-mode="after"
                 {% if raid.expectedEndTime %}data-end="{{ raid.expectedEndTime|date('U') }}"{% endif %}>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="countdown-text">…</span>
                {% if raid.expectedEndTime %}<span class="ml-auto countdown-end-text text-green-700">…</span>{% endif %}
            </div>
        {% endif %}
    {% endif %}

    {# ── Ligne principale ── #}
    {% set pendingCount = raid.pendingParticipants|length %}
    {% if compact %}
        {# Version dashboard : 2 lignes d'info seulement, pour rester lisible dans une carte étroite #}
        <a href="{{ path('app_raid_show', {id: raid.id}) }}"
           class="flex items-center gap-5 {{ px }} py-5 transition group hover:bg-gray-800/30">

            {% if raid.raidTemplate.imagePath %}
                <img src="{{ asset('uploads/raid-templates/' ~ raid.raidTemplate.imagePath) }}"
                     alt="{{ raid.raidTemplate.name }}"
                     loading="lazy" decoding="async" width="{{ imgSize }}" height="{{ imgSize }}"
                     class="{{ imgCls }} object-cover shrink-0">
            {% else %}
                <span class="{{ imgCls }} bg-emerald-900/40 border border-emerald-800/30 flex items-center justify-center text-2xl shrink-0">⚔</span>
            {% endif %}

            <div class="flex-1 min-w-0">
                <span class="font-semibold text-white text-base truncate group-hover:text-emerald-300 transition block">
                    {{ raid.raidTemplate.name }}
                </span>
                <div class="flex items-center gap-2 text-sm text-gray-500 mt-2 truncate">
                    <img src="{{ asset('classes/' ~ participation.character.gameClass.name|lower ~ '.png') }}"
                         alt="{{ participation.character.gameClass.name }}"
                         loading="lazy" decoding="async" width="18" height="18"
                         class="w-[18px] h-[18px] rounded-full object-contain p-0.5 shrink-0">
                    <span class="text-emerald-300/90 font-medium">{{ participation.character.name }}</span>
                    {% if raid.scheduledAt %}
                        <span class="text-gray-700">·</span>
                        <span class="text-emerald-400">{{ raid.scheduledAt|date('d/m à H:i') }}</span>
                    {% endif %}
                </div>
            </div>

            <div class="flex flex-col items-end gap-2 shrink-0">
                {% if accepted %}
                    {{ ui.badge('Accepté', 'success', 'shrink-0') }}
                {% else %}
                    {{ ui.badge('En attente', 'warning', 'shrink-0') }}
                {% endif %}
                <div class="text-base font-semibold {{ raid.isFull() ? 'text-red-400' : 'text-emerald-400' }}">
                    {{ raid.acceptedParticipants|length }}<span class="text-gray-600 font-normal">/{{ raid.raidTemplate.maxParticipants }}</span>
                </div>
            </div>

        </a>
    {% else %}
        <a href="{{ path('app_raid_show', {id: raid.id}) }}"
           class="flex items-center gap-4 {{ px }} py-4 transition group hover:bg-gray-800/30">

            {% if raid.raidTemplate.imagePath %}
                <img src="{{ asset('uploads/raid-templates/' ~ raid.raidTemplate.imagePath) }}"
                     alt="{{ raid.raidTemplate.name }}"
                     loading="lazy" decoding="async" width="{{ imgSize }}" height="{{ imgSize }}"
                     class="{{ imgCls }} object-cover shrink-0">
            {% else %}
                <span class="{{ imgCls }} bg-emerald-900/40 border border-emerald-800/30 flex items-center justify-center text-xl shrink-0">⚔</span>
            {% endif %}

            <div class="flex-1 min-w-0">

                {# Nom + badges #}
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-semibold text-white group-hover:text-emerald-300 transition truncate">
                        {{ raid.raidTemplate.name }}
                    </span>
                    {% if accepted %}
                        {{ ui.badge('Accepté', 'success', 'shrink-0') }}
                    {% else %}
                        {{ ui.badge('En attente', 'warning', 'shrink-0') }}
                    {% endif %}
                    {% if not raid.public %}
                        <span class="text-xs font-medium bg-gray-800 text-gray-500 border border-gray-700/40 rounded-full px-2 py-0.5 shrink-0">🔒 Privé</span>
                    {% endif %}
                </div>

                {# Guilde · serveur · date · durée #}
                <div class="flex items-center gap-2 text-xs text-gray-500 mt-1 flex-wrap">
                    {% if raid.guild.imagePath %}
                        <img src="{{ asset('uploads/guildes/' ~ raid.guild.slug ~ '/' ~ raid.guild.imagePath) }}"
                             alt="{{ raid.guild.name }}"
                             loading="lazy" decoding="async" width="16" height="16"
                             class="w-4 h-4 rounded object-contain">
                    {% endif %}
                    <span>{{ raid.guild.name }}</span>
                    <span class="text-gray-700">·</span>
                    <span>{{ raid.guild.server.name }}</span>
                    {% if raid.scheduledAt %}
                        <span class="text-gray-700">·</span>
                        <span class="text-gray-400">{{ raid.scheduledAt|date('d/m à H:i') }}</span>
                    {% endif %}
                    {% if raid.raidTemplate.formattedDuration %}
                        <span class="text-gray-700">·</span>
                        <span class="inline-flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                            </svg>
                            {{ raid.raidTemplate.formattedDuration }}
                        </span>
                    {% endif %}
                </div>

                {# Personnage #}
                <div class="flex items-center gap-1.5 text-xs text-emerald-300/80 mt-1">
                    <img src="{{ asset('classes/' ~ participation.character.gameClass.name|lower ~ '.png') }}"
                         alt="{{ participation.character.gameClass.name }}"
                         loading="lazy" decoding="async" width="14" height="14"
                         class="w-3.5 h-3.5 rounded-full object-contain p-0.5 shrink-0">
                    <span class="font-medium">{{ participation.character.name }}</span>
                    <span class="text-gray-600">— {{ participation.character.gameClass.name }}</span>
                </div>

            </div>

            {# Places #}
            <div class="text-right shrink-0">
                <div class="text-sm font-medium {{ raid.isFull() ? 'text-red-400' : 'text-emerald-400' }}">
                    {{ raid.acceptedParticipants|length }}<span class="text-gray-600 font-normal">/{{ raid.raidTemplate.maxParticipants }}</span>
                </div>
                <div class="text-xs text-gray-600 mt-0.5">joueurs</div>
                {% if pendingCount > 0 %}
                    <div class="text-xs text-yellow-500/70 mt-0.5">+{{ pendingCount }} intéressé{{ pendingCount > 1 ? 's' : '' }}</div>
                {% endif %}
            </div>

        </a>
    {% endif %}
    {% if compact %}</div>{% endif %}

</li>
