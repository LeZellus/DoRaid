{#
  UI Macros — import with:
    {% import 'components/_ui.html.twig' as ui %}

  Then use:
    {{ ui.button('Valider') }}
    {{ ui.input('email', 'email', 'email', '', 'vous@exemple.com') }}
    {{ ui.alert('Sauvegardé !', 'success') }}
    etc.
#}

{#
  button_classes(variant, extra_class)
  variant: primary | secondary | danger | ghost | success | warning
  Classes only — reused by button()/link_button() and by the Symfony form theme
  (templates/form/tailwind.html.twig) so both stay in sync with a single source of truth.
#}
{% macro button_classes(variant='primary', extra_class='') %}
    {%- set base = 'inline-flex items-center justify-center gap-2 font-semibold rounded-xl transition cursor-pointer' -%}
    {%- set styles = {
        primary:   'text-emerald-300 hover:text-white bg-emerald-900/45 hover:bg-emerald-700/60 border border-emerald-700/45 hover:border-emerald-500',
        secondary: 'border border-gray-600 hover:border-gray-400 hover:bg-gray-700/55 text-gray-300 hover:text-white',
        danger:    'text-red-400 hover:text-white bg-red-900/55 hover:bg-red-700/65 border border-red-700/45 hover:border-red-500',
        ghost:     'text-gray-400 hover:text-white hover:bg-gray-800',
        success:   'text-green-400 hover:text-green-300 bg-green-950/40 hover:bg-green-950/70 border border-green-800/40',
        warning:   'text-orange-400 hover:text-orange-300 bg-orange-950/40 hover:bg-orange-950/70 border border-orange-800/40',
    } -%}
    {#- Padding par défaut uniquement si extra_class n'en définit pas déjà un -#}
    {%- set sizing = 'py-' in extra_class ? '' : 'py-2.5 px-5 text-sm' -%}
    {{- base }} {{ sizing }} {{ styles[variant]|default(styles.primary) }} {{ extra_class -}}
{% endmacro %}

{#
  button(label, variant, type, extra_class, attrs)
  variant: primary | secondary | danger | ghost
#}
{% macro button(label, variant='primary', type='submit', extra_class='', attrs={}) %}
    <button type="{{ type }}" class="{{ _self.button_classes(variant, extra_class) }}"
        {%- for k, v in attrs %} {{ k }}="{{ v }}"{% endfor %}>
        {{- label -}}
    </button>
{% endmacro %}

{#
  link_button(label, url, variant, extra_class)
  Same appearance as button but rendered as <a>
#}
{% macro link_button(label, url, variant='primary', extra_class='') %}
    <a href="{{ url }}" class="{{ _self.button_classes(variant, extra_class) }}">
        {{- label -}}
    </a>
{% endmacro %}

{#
  input_classes(extra_class) — classes only, reused by input() and the Symfony form theme
#}
{% macro input_classes(extra_class='') %}w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent placeholder-gray-500 {{ extra_class }}{% endmacro %}

{#
  input(id, name, type, value, placeholder, extra_class, attrs)
  type: text | email | password | number | search | url | tel
#}
{% macro input(id, name, type='text', value='', placeholder='', extra_class='', attrs={}) %}
    <input
        type="{{ type }}"
        id="{{ id }}"
        name="{{ name }}"
        {% if value %}value="{{ value }}"{% endif %}
        {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
        class="{{ _self.input_classes(extra_class) }}"
        {%- for k, v in attrs %} {{ k }}="{{ v }}"{% endfor %}>
{% endmacro %}

{#
  label_classes(extra_class) — classes only, reused by label() and the Symfony form theme
#}
{% macro label_classes(extra_class='') %}block text-sm font-medium text-gray-300 mb-1 {{ extra_class }}{% endmacro %}

{#
  label(for_id, text)
#}
{% macro label(for_id, text) %}
    <label for="{{ for_id }}" class="{{ _self.label_classes() }}">
        {{- text -}}
    </label>
{% endmacro %}

{#
  checkbox_classes(extra_class) — classes only, reused by checkbox() and the Symfony form theme
#}
{% macro checkbox_classes(extra_class='') %}w-4 h-4 rounded border-gray-600 bg-gray-700 text-emerald-500 focus:ring-emerald-500 focus:ring-offset-gray-900 {{ extra_class }}{% endmacro %}

{#
  checkbox(id, name, label_text, checked, extra_class)
#}
{% macro checkbox(id, name, label_text, checked=false, extra_class='') %}
    <div class="flex items-center gap-3 {{ extra_class }}">
        <input type="checkbox" id="{{ id }}" name="{{ name }}"
            {% if checked %}checked{% endif %}
            class="{{ _self.checkbox_classes() }}">
        <label for="{{ id }}" class="text-sm text-gray-400">{{ label_text }}</label>
    </div>
{% endmacro %}

{#
  alert(message, type)
  type: success | error | warning | info
#}
{% macro alert(message, type='info') %}
    {% set styles = {
        success: 'bg-green-900/50 text-green-300 border-green-700/50',
        error:   'bg-red-900/55   text-red-400   border-red-700/50',
        warning: 'bg-yellow-900/50 text-yellow-400 border-yellow-700/50',
        info:    'bg-blue-900/50  text-blue-200  border-blue-700/50',
    } %}
    {% set icons = {
        success: '✓',
        error:   '✕',
        warning: '⚠',
        info:    'ℹ',
    } %}
    <div class="flex items-start gap-3 px-4 py-3 rounded-lg border {{ styles[type]|default(styles.info) }}">
        <span class="font-bold shrink-0">{{ icons[type]|default('ℹ') }}</span>
        <span>{{ message }}</span>
    </div>
{% endmacro %}

{#
  badge(text, variant, extra_class)
  variant: default | success | danger | warning | emerald | info | pink
  Style translucide + bordure, cohérent avec les pastilles de statut du site
  (Accepté, En attente, Complet, Ma guilde...).
#}
{% macro badge(text, variant='default', extra_class='') %}
    {% set styles = {
        default: 'bg-gray-700 text-gray-300',
        success: 'bg-emerald-900/50 text-emerald-400 border border-emerald-800/40',
        danger:  'bg-red-900/50 text-red-400 border border-red-800/40',
        warning: 'bg-yellow-900/40 text-yellow-400 border border-yellow-800/40',
        emerald:  'bg-emerald-900/50 text-emerald-300 border border-emerald-700/40',
        info:    'bg-blue-900/50 text-blue-400 border border-blue-800/40',
        pink:    'bg-pink-900/50 text-pink-400 border border-pink-800/40',
    } %}
    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium {{ styles[variant]|default(styles.default) }} {{ extra_class }}">
        {{- text -}}
    </span>
{% endmacro %}

{#
  divider(text)
  Horizontal rule with optional centered text
#}
{% macro divider(text='') %}
    <div class="flex items-center my-6">
        <div class="flex-grow border-t border-gray-700"></div>
        {% if text %}
            <span class="mx-4 text-sm text-gray-500">{{ text }}</span>
            <div class="flex-grow border-t border-gray-700"></div>
        {% endif %}
    </div>
{% endmacro %}

{#
  discord_button(label, url)
#}
{% macro discord_button(label, url) %}
    <a href="{{ url }}"
       class="flex items-center justify-center gap-3 w-full bg-discord hover:bg-discord-dark text-white font-semibold py-3 rounded-xl transition">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 127.14 96.36" fill="currentColor" aria-hidden="true">
            <path d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69Zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.04 12.69-11.43 12.69Z"/>
        </svg>
        {{ label }}
    </a>
{% endmacro %}

{#
  whisper(name)
  Blue pill showing "/w Name" — click copies the text to clipboard for in-game contact
#}
{% macro whisper(name) %}
<button type="button"
        onclick="(function(btn,cmd){navigator.clipboard.writeText(cmd).then(function(){var t=btn.textContent;btn.textContent='Copié !';setTimeout(function(){btn.textContent=t},1500)})})(this,'/w {{ name }}')"
        title="Copier pour contacter en jeu"
        class="font-mono text-xs text-blue-400 hover:text-blue-300 bg-blue-950/30 hover:bg-blue-950/50 border border-blue-800/30 rounded px-1.5 py-0.5 transition select-none cursor-pointer">
    /w {{ name }}
</button>
{% endmacro %}

{#
  card_classes — returns the CSS classes for a card container
  Use directly: <div class="{{ ui.card_classes() }}">...</div>

  card_header_classes — for the header section
  card_body_classes  — for the body section
#}
{% macro card_classes(extra_class='') %}bg-gray-900 border border-gray-800 rounded-2xl {{ extra_class }}{% endmacro %}
{% macro card_header_classes(extra_class='') %}px-6 py-4 border-b border-gray-800 {{ extra_class }}{% endmacro %}
{% macro card_body_classes(extra_class='') %}px-6 py-5 {{ extra_class }}{% endmacro %}
