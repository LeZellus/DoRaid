{#
  menu(p, raid, myOtherRaids, accepted)
  Menu d'actions (⋮) pour une ligne participant/intéressé — visible par le créateur du raid.
  À importer : {% import 'components/_raid_participant_menu.html.twig' as pmenu %}
  Usage      : {{ pmenu.menu(p, raid, myOtherRaids, true) }}  {# true = participant accepté, false = intéressé #}
#}
{% macro menu(p, raid, myOtherRaids, accepted) %}
    <div class="relative shrink-0" data-controller="menu">
        <button type="button" data-action="menu#toggle" title="Actions"
            class="w-8 h-8 rounded-full flex items-center justify-center bg-gray-800 hover:bg-gray-700 border border-gray-700 text-gray-400 hover:text-white transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 3a1.5 1.5 0 110 3 1.5 1.5 0 010-3ZM10 8.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3ZM10 14a1.5 1.5 0 110 3 1.5 1.5 0 010-3Z"/>
            </svg>
        </button>

        <div data-menu-target="panel" class="hidden fixed z-50 w-64 bg-gray-800 border border-gray-700 rounded-xl shadow-2xl overflow-y-auto text-left">
            {% if myOtherRaids is not empty %}
                <form method="post" action="{{ path('app_raid_move', {id: p.id}) }}" class="px-3 py-3 border-b border-gray-700/60">
                    <input type="hidden" name="_token" value="{{ csrf_token('move_' ~ p.id) }}">
                    <label class="block text-[11px] font-medium text-gray-500 uppercase tracking-wide mb-1.5">Déplacer vers</label>
                    <div class="relative" data-controller="select">
                        <select name="target_raid_id" class="hidden">
                            {% for r in myOtherRaids %}
                                <option value="{{ r.id }}">{{ r.raidTemplate.name }} ({{ r.creator.name }}){{ r.scheduledAt ? ' · ' ~ r.scheduledAt|date('d/m') : '' }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <button type="submit"
                        class="mt-2 w-full text-xs font-semibold text-sky-400 hover:text-sky-300 bg-sky-600/15 hover:bg-sky-600/25 border border-sky-600/30 rounded-lg py-1.5 transition">
                        Déplacer
                    </button>
                </form>
            {% endif %}

            {% if accepted %}
                <form method="post" action="{{ path('app_raid_transfer_creator', {id: p.id}) }}"
                      onsubmit="return confirm('Nommer {{ p.character.name }} créateur du raid ? Il gérera les candidatures à votre place.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('transfer_creator_' ~ p.id) }}">
                    <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2.5 text-sm text-violet-400 hover:bg-violet-600/10 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L10 18.354l-4.123 2.555c-.997.608-2.232-.289-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.748-2.305l5.404-.433L10.788 3.21z"/>
                        </svg>
                        Nommer créateur
                    </button>
                </form>
                <form method="post" action="{{ path('app_raid_unaccept', {id: p.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('unaccept_' ~ p.id) }}">
                    <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2.5 text-sm text-yellow-400 hover:bg-yellow-600/10 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M9.793 2.232a.75.75 0 01-.025 1.06L4.622 8.25h13.575a.75.75 0 010 1.5H4.622l5.146 4.958a.75.75 0 11-1.04 1.082l-6.5-6.25a.75.75 0 010-1.082l6.5-6.25a.75.75 0 011.065.025z" clip-rule="evenodd"/>
                        </svg>
                        Remettre en attente
                    </button>
                </form>
                <form method="post" action="{{ path('app_raid_kick', {id: p.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('kick_' ~ p.id) }}">
                    <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2.5 text-sm text-red-400 hover:bg-red-600/10 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                        </svg>
                        Retirer
                    </button>
                </form>
            {% else %}
                <form method="post" action="{{ path('app_raid_accept', {id: p.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('accept_' ~ p.id) }}">
                    <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2.5 text-sm text-emerald-400 hover:bg-emerald-600/10 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        Accepter
                    </button>
                </form>
                <form method="post" action="{{ path('app_raid_kick', {id: p.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('kick_' ~ p.id) }}">
                    <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2.5 text-sm text-red-400 hover:bg-red-600/10 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                        </svg>
                        Refuser
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
{% endmacro %}
