{#
  Paramètres :
    membership      GuildMembership
    characterName   string
    canManageNotes  bool  — peut ajouter une note et supprimer les siennes
    canDeleteAny    bool  — peut supprimer n'importe quelle note (meneur)
#}
{% macro dialog(membership, characterName, canManageNotes, canDeleteAny) %}
  {% set noteCount = membership.notes|length %}
  <div data-controller="modal" class="relative shrink-0">

    {# ── Bouton icône ── #}
    <button type="button"
            data-action="modal#open"
            title="Notes sur {{ characterName }}"
            class="flex items-center gap-1 px-1.5 h-7 rounded-lg transition hover:bg-gray-700/40 shrink-0 {{ noteCount > 0 ? 'text-emerald-400' : 'text-gray-600 hover:text-gray-400' }}">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
        <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/>
      </svg>
      <span class="text-xs font-medium tabular-nums">{{ noteCount }}</span>
    </button>

    {# ── Dialog ── #}
    <dialog data-modal-target="dialog"
            data-action="click->modal#clickBackdrop"
            class="member-notes-dialog bg-gray-900 border border-gray-700/50 rounded-2xl shadow-2xl p-0 text-white w-full max-w-md fixed top-1/2 left-1/2">

      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-800">
        <h3 class="font-semibold text-white text-sm">Notes — {{ characterName }}</h3>
        <button type="button" data-action="modal#close"
                class="text-gray-500 hover:text-gray-300 transition text-xl leading-none cursor-pointer">✕</button>
      </div>

      <div class="px-5 py-4 space-y-4 max-h-80 overflow-y-auto">
        {% if membership.notes is empty %}
          <p class="text-xs text-gray-600 italic text-center py-4">Aucune note pour l'instant.</p>
        {% else %}
          {% for note in membership.notes %}
            <div class="flex items-start gap-3 text-xs">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 mb-1">
                  <span class="font-semibold text-gray-300">{{ note.author.username }}</span>
                  <span class="text-gray-700">·</span>
                  <span class="text-gray-600">{{ note.createdAt|date('d/m/Y') }}</span>
                </div>
                <p class="text-gray-400 leading-relaxed">{{ note.content }}</p>
              </div>
              {% if app.user and (note.isWrittenBy(app.user) or canDeleteAny) %}
                <form method="post" action="{{ path('app_guild_member_note_delete', {id: note.id}) }}"
                      onsubmit="return confirm('Supprimer cette note ?')">
                  <input type="hidden" name="_token" value="{{ csrf_token('member_note_delete_' ~ note.id) }}">
                  <button type="submit"
                          class="text-gray-700 hover:text-red-400 transition mt-0.5 shrink-0 cursor-pointer"
                          title="Supprimer">✕</button>
                </form>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </div>

      {% if canManageNotes %}
        <div class="px-5 py-4 border-t border-gray-800">
          <form method="post" action="{{ path('app_guild_member_note_add', {id: membership.id}) }}"
                class="flex gap-2 items-start">
            <input type="hidden" name="_token" value="{{ csrf_token('member_note_add_' ~ membership.id) }}">
            <textarea name="content" rows="2"
                      placeholder="Ajouter une note…"
                      class="flex-1 text-xs bg-gray-800/60 border border-gray-700/50 rounded-lg px-3 py-1.5 text-gray-300 placeholder-gray-600 resize-none focus:outline-none focus:border-emerald-500/60"></textarea>
            <button type="submit"
                    class="text-xs text-emerald-400 hover:text-emerald-300 transition shrink-0 py-1.5 px-2 font-medium">
              Ajouter
            </button>
          </form>
        </div>
      {% endif %}

    </dialog>
  </div>
{% endmacro %}
