{#
  card(group, index, isCreator, raidOpen)
  Carte d'un groupe de raid — affichage + actions créateur (renommer/supprimer/retirer un membre).
  À importer : {% import 'components/_raid_groups.html.twig' as groups %}
  Usage      : {{ groups.card(group, loop.index, isCreator, raidOpen) }}
#}
{% macro card(group, index, isCreator, raidOpen) %}
    {% set editable = isCreator and raidOpen %}
    {% set memberCount = group.participants|length %}
    {% set full = memberCount >= constant('App\\Entity\\RaidGroup::MAX_MEMBERS') %}
    <div class="bg-gray-800/40 border border-gray-700 rounded-xl p-4">
        <div class="flex items-center justify-between mb-3 gap-2">
            <div class="flex items-center gap-2 min-w-0">
                <span class="font-semibold text-white text-sm truncate">{{ group.label ?: 'Groupe ' ~ index }}</span>
                <span class="text-[11px] font-medium shrink-0 px-1.5 py-0.5 rounded-full {{ full ? 'bg-red-900/40 text-red-400' : 'bg-gray-700/60 text-gray-400' }}">
                    {{ memberCount }}/{{ constant('App\\Entity\\RaidGroup::MAX_MEMBERS') }}
                </span>
            </div>
            {% if editable %}
                <div class="relative shrink-0" data-controller="menu">
                    <button type="button" data-action="menu#toggle" title="Actions"
                        class="w-6 h-6 rounded-full flex items-center justify-center bg-gray-800 hover:bg-gray-700 border border-gray-700 text-gray-400 hover:text-white transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M10 3a1.5 1.5 0 110 3 1.5 1.5 0 010-3ZM10 8.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3ZM10 14a1.5 1.5 0 110 3 1.5 1.5 0 010-3Z"/>
                        </svg>
                    </button>
                    <div data-menu-target="panel" class="hidden fixed z-50 w-60 bg-gray-800 border border-gray-700 rounded-xl shadow-2xl overflow-hidden text-left">
                        <form method="post" action="{{ path('app_raid_group_rename', {id: group.id}) }}" class="px-3 py-3 border-b border-gray-700/60 flex gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('rename_group_' ~ group.id) }}">
                            <input type="text" name="label" value="{{ group.label }}" placeholder="Groupe {{ index }}" maxlength="50"
                                class="flex-1 min-w-0 bg-gray-900 border border-gray-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <button type="submit" class="shrink-0 text-xs font-semibold text-emerald-400 hover:text-emerald-300 px-2">OK</button>
                        </form>
                        <form method="post" action="{{ path('app_raid_group_delete', {id: group.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_group_' ~ group.id) }}">
                            <button type="submit"
                                onclick="return confirm('Supprimer ce groupe ? Ses membres repasseront en non assignés.')"
                                class="w-full flex items-center gap-2.5 px-3 py-2.5 text-sm text-red-400 hover:bg-red-600/10 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd"/>
                                </svg>
                                Supprimer le groupe
                            </button>
                        </form>
                    </div>
                </div>
            {% endif %}
        </div>
        <ul class="space-y-1.5">
            {% for p in group.participants %}
                <li class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2 min-w-0">
                        <img src="{{ asset('classes/' ~ p.character.gameClass.name|lower ~ '.png') }}"
                             alt="{{ p.character.gameClass.name }}"
                             class="w-5 h-5 rounded-full object-cover shrink-0">
                        <span class="text-sm text-gray-200 truncate">{{ p.character.name }}</span>
                    </div>
                    {% if editable %}
                        <form method="post" action="{{ path('app_raid_participant_assign', {id: p.id}) }}" class="shrink-0">
                            <input type="hidden" name="_token" value="{{ csrf_token('assign_' ~ p.id) }}">
                            <input type="hidden" name="group_id" value="">
                            <button type="submit" title="Retirer du groupe"
                                class="w-5 h-5 rounded-full flex items-center justify-center text-gray-500 hover:text-red-400 hover:bg-red-500/10 transition leading-none">×</button>
                        </form>
                    {% endif %}
                </li>
            {% else %}
                <li class="text-sm text-gray-600 italic py-0.5">Vide</li>
            {% endfor %}
        </ul>
    </div>
{% endmacro %}
