{#
  Modal de feedback global — inclus dans base.html.twig.
  Déclenché par : document.getElementById('feedback-dialog').showModal()
#}
{% if app.user %}
<dialog id="feedback-dialog"
        class="member-notes-dialog bg-gray-900 border border-gray-700/50 rounded-2xl shadow-2xl p-0 text-white w-full max-w-lg fixed top-1/2 left-1/2"
        onclick="if(event.target===this)this.close()">

    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-800">
        <h3 class="font-semibold text-white text-sm">Signaler / Suggérer</h3>
        <button type="button" onclick="this.closest('dialog').close()"
                class="text-gray-500 hover:text-gray-300 transition text-xl leading-none cursor-pointer">✕</button>
    </div>

    <form method="post" action="{{ path('app_feedback_new') }}" class="px-5 py-5 space-y-4"
          id="feedback-form">
        <input type="hidden" name="_token" value="{{ csrf_token('feedback_new') }}">
        <input type="hidden" name="page" id="feedback-page">
        <input type="hidden" name="type" id="feedback-type-value">

        {# Type #}
        <div class="flex gap-3">
            <button type="button" class="feedback-type-btn" data-type="bug"
                    onclick="feedbackSelectType('bug')">
                <span>🐛</span> Bug
            </button>
            <button type="button" class="feedback-type-btn" data-type="suggestion"
                    onclick="feedbackSelectType('suggestion')">
                <span>💡</span> Suggestion
            </button>
        </div>
        <p id="feedback-type-error" class="hidden text-xs text-red-400">Sélectionne un type.</p>

        {# Titre #}
        <div>
            <label for="feedback-title" class="block text-xs font-medium text-gray-400 mb-1.5">
                Titre <span class="text-red-500">*</span>
            </label>
            <input id="feedback-title" type="text" name="title" required maxlength="200"
                   placeholder="Résumé en quelques mots…"
                   class="feedback-input">
        </div>

        {# Description #}
        <div>
            <label for="feedback-desc" class="block text-xs font-medium text-gray-400 mb-1.5">
                Description <span class="text-gray-600">(optionnel)</span>
            </label>
            <textarea id="feedback-desc" name="description" rows="4" maxlength="2000"
                      placeholder="Décris le problème ou la suggestion en détail…"
                      class="feedback-input resize-none"></textarea>
        </div>

        <div class="flex items-center justify-between pt-1">
            <p class="text-xs text-gray-600">
                Page : <span id="feedback-page-display" class="text-gray-500"></span>
            </p>
            <button type="submit" id="feedback-submit"
                    class="bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium px-5 py-2.5 rounded-xl transition cursor-pointer">
                Envoyer
            </button>
        </div>
    </form>
</dialog>

<script>
function feedbackSelectType(type) {
    document.querySelectorAll('.feedback-type-btn').forEach(function(btn) {
        delete btn.dataset.selected;
    });
    var btn = document.querySelector('.feedback-type-btn[data-type="' + type + '"]');
    if (btn) btn.dataset.selected = type;
    document.getElementById('feedback-type-value').value = type;
    document.getElementById('feedback-type-error').classList.add('hidden');
}

(function() {
    var dialog = document.getElementById('feedback-dialog');
    var form   = document.getElementById('feedback-form');

    if (dialog) {
        dialog.addEventListener('toggle', function() {
            if (this.open) {
                var url = window.location.pathname;
                var inp = document.getElementById('feedback-page');
                var lbl = document.getElementById('feedback-page-display');
                if (inp) inp.value = url;
                if (lbl) lbl.textContent = url;
            }
        });
    }

    if (form) {
        form.addEventListener('submit', function(e) {
            var typeVal = document.getElementById('feedback-type-value').value;
            if (!typeVal) {
                e.preventDefault();
                document.getElementById('feedback-type-error').classList.remove('hidden');
                return;
            }
            dialog.close();
        });
    }
})();
</script>
{% endif %}
