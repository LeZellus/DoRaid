{% use 'form_div_layout.html.twig' %}

{# ── Inputs (text, email, password, number, url, tel, search, date…) ── #}
{% block form_widget_simple %}
    {% import 'components/_ui.html.twig' as ui %}
    {% set attr = attr|merge({class: ui.input_classes() ~ (attr.class is defined ? ' ' ~ attr.class : '')}) %}
    {{ parent() }}
{% endblock %}

{# ── Textarea ── #}
{% block textarea_widget %}
    {% import 'components/_ui.html.twig' as ui %}
    {% set attr = attr|merge({class: ui.input_classes('resize-y') ~ (attr.class is defined ? ' ' ~ attr.class : '')}) %}
    {{ parent() }}
{% endblock %}

{# ── Select (le controller Stimulus `select` gère le rendu custom) ── #}
{% block choice_widget_collapsed %}
    {% set attr = attr|merge({class: 'hidden'}) %}
    <div class="relative" data-controller="select">
        {{- parent() -}}
    </div>
{% endblock %}

{# ── Checkbox ── #}
{% block checkbox_widget %}
    {% import 'components/_ui.html.twig' as ui %}
    {% set attr = attr|merge({class: ui.checkbox_classes() ~ (attr.class is defined ? ' ' ~ attr.class : '')}) %}
    {{ parent() }}
{% endblock %}

{# ── Radio ── #}
{% block radio_widget %}
    {% set attr = attr|merge({class: 'w-4 h-4 border-gray-600 bg-gray-700 text-emerald-500 focus:ring-emerald-500 focus:ring-offset-gray-900' ~ (attr.class is defined ? ' ' ~ attr.class : '')}) %}
    {{ parent() }}
{% endblock %}

{# ── Submit button ── #}
{% block submit_widget %}
    {% import 'components/_ui.html.twig' as ui %}
    {% set attr = attr|merge({class: ui.button_classes('primary', 'w-full py-3 cursor-pointer') ~ (attr.class is defined ? ' ' ~ attr.class : '')}) %}
    {{ parent() }}
{% endblock %}

{# ── Label ── #}
{% block form_label %}
    {% import 'components/_ui.html.twig' as ui %}
    {% if label is not same as(false) %}
        {% set label_attr = label_attr|merge({class: ui.label_classes() ~ (label_attr.class is defined ? ' ' ~ label_attr.class : '')}) %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{# ── Help text ── #}
{% block form_help %}
    {% if help is not empty %}
        <p class="text-xs text-gray-500 mt-1">{{ help }}</p>
    {% endif %}
{% endblock %}

{# ── Errors ── #}
{% block form_errors %}
    {% if errors|length > 0 %}
        {% for error in errors %}
            <p class="text-red-400 text-xs mt-1">{{ error.message }}</p>
        {% endfor %}
    {% endif %}
{% endblock %}

{# ── Row (label + widget + errors) ── #}
{% block form_row %}
    {% if compound is defined and compound %}
        {# Fieldset-like rows (e.g. RepeatedType) — no outer label #}
        <div>
            {{- form_errors(form) -}}
            {{- form_widget(form) -}}
        </div>
    {% else %}
        <div>
            {{- form_label(form) -}}
            {{- form_widget(form) -}}
            {{- form_help(form) -}}
            {{- form_errors(form) -}}
        </div>
    {% endif %}
{% endblock %}

{# ── Checkbox row (label inline, beside the box) ── #}
{% block checkbox_row %}
    <div class="flex items-start gap-3">
        {{- form_widget(form) -}}
        <div>
            {{- form_label(form, null, {label_attr: {class: 'text-sm text-gray-400 cursor-pointer'}}) -}}
            {{- form_errors(form) -}}
        </div>
    </div>
{% endblock %}
