{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}{{ raid.raidTemplate.name }} – DoRaid{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-6 py-10">

    <a href="{{ path('app_guild_show', {slug: raid.guild.slug}) }}"
       class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-300 transition mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        {{ raid.guild.name }}
    </a>

    {# ── Hero ── #}
    <div class="rounded-2xl border border-indigo-900/30 bg-gradient-to-br from-indigo-950/60 via-gray-900 to-gray-950 overflow-hidden mb-8">

        {# Bande supérieure : statut + serveur + actions créateur #}
        <div class="flex items-center justify-between gap-4 px-8 py-3 border-b border-indigo-900/20 bg-indigo-950/20">
            <div class="flex items-center gap-3">
                {% if raid.status == constant('App\\Entity\\RaidStatus::Open') %}
                    {{ ui.badge(raid.status.label(), 'success') }}
                {% else %}
                    {{ ui.badge(raid.status.label(), 'default') }}
                {% endif %}
                {{ ui.badge(raid.public ? '🌐 Public' : '🔒 Privé', raid.public ? 'default' : 'default') }}
                <span class="text-xs text-gray-500 font-medium">{{ raid.guild.server.name }}</span>
                <span class="text-gray-700">·</span>
                <span class="text-xs text-gray-500">{{ raid.guild.name }}</span>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" id="share-btn"
                        class="inline-flex items-center justify-center gap-2 font-semibold rounded-xl transition bg-blue-600 hover:bg-blue-500 text-white py-1 px-3 text-xs">
                    <span id="share-label">Partager le raid</span>
                </button>
                {% if isCreator %}
                    {{ ui.link_button('✏ Modifier', path('app_raid_edit', {id: raid.id}), 'secondary', 'py-1 px-3 text-xs') }}
                    {% if raid.status == constant('App\\Entity\\RaidStatus::Open') %}
                        <form method="post" action="{{ path('app_raid_close', {id: raid.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('close_raid_' ~ raid.id) }}">
                            {{ ui.button('Terminer', 'secondary', 'submit', 'py-1 px-3 text-xs') }}
                        </form>
                    {% endif %}
                    <form method="post" action="{{ path('app_raid_delete', {id: raid.id}) }}"
                          onsubmit="return confirm('Supprimer ce raid définitivement ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_raid_' ~ raid.id) }}">
                        {{ ui.button('Supprimer', 'danger', 'submit', 'py-1 px-3 text-xs') }}
                    </form>
                {% endif %}
            </div>
        </div>

        {# Corps : titre + méta + compteurs #}
        <div class="flex flex-col sm:flex-row sm:items-center gap-6 px-8 py-6">

            {# Image du template #}
            {% if raid.raidTemplate.imagePath %}
                <img src="{{ asset('uploads/raid-templates/' ~ raid.raidTemplate.imagePath) }}"
                     alt="{{ raid.raidTemplate.name }}"
                     class="w-20 h-20 rounded-2xl object-cover border border-indigo-800/40 shrink-0">
            {% else %}
                <div class="w-20 h-20 rounded-2xl bg-indigo-900/40 border border-indigo-800/30 flex items-center justify-center text-4xl shrink-0">⚔</div>
            {% endif %}

            {# Infos principales #}
            <div class="flex-1 min-w-0">
                <h1 class="text-3xl font-bold text-white tracking-tight">{{ raid.raidTemplate.name }}</h1>

                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-3 text-sm text-gray-400">
                    <span>
                        Créé par <span class="text-gray-200 font-medium">{{ raid.creator.name }}</span>
                    </span>
                    <span class="text-gray-700">·</span>
                    <span>Créé le <span class="text-gray-300">{{ raid.createdAt|date('d/m/Y') }}</span></span>
                    {% if raid.scheduledAt %}
                        <span class="text-gray-700">·</span>
                        <span class="text-indigo-300 font-medium">Prévu le {{ raid.scheduledAt|date('d/m/Y à H:i') }}</span>
                    {% endif %}
                    {% if raid.raidTemplate.formattedDuration %}
                        <span class="text-gray-700">·</span>
                        <span class="inline-flex items-center gap-1 text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-500" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                            </svg>
                            Durée : {{ raid.raidTemplate.formattedDuration }}
                        </span>
                    {% endif %}
                    {% if raid.expectedEndTime %}
                        <span class="text-gray-700">·</span>
                        <span class="inline-flex items-center gap-1 {{ raid.expectedEndTime < date() ? 'text-red-400' : 'text-emerald-400' }}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            Fin {{ raid.expectedEndTime < date() ? 'à' : 'prévue à' }} {{ raid.expectedEndTime|date('H:i') }}
                        </span>
                    {% endif %}
                </div>

                {% if raid.description %}
                    <p class="text-gray-400 text-sm mt-3 leading-relaxed border-t border-gray-800/60 pt-3">{{ raid.description }}</p>
                {% endif %}
            </div>

            {# Compteurs #}
            <div class="flex items-center gap-4 shrink-0">
                <div class="text-center bg-gray-800/40 rounded-xl px-5 py-3 border border-gray-700/30">
                    <div class="text-2xl font-bold {{ raid.isFull() ? 'text-red-400' : 'text-white' }}">
                        {{ raid.acceptedParticipants|length }}<span class="text-base font-normal text-gray-600">/{{ raid.raidTemplate.maxParticipants }}</span>
                    </div>
                    <div class="text-xs text-gray-500 mt-0.5">participants</div>
                </div>
                {% if raid.pendingParticipants|length > 0 %}
                    <div class="text-center bg-yellow-900/20 rounded-xl px-5 py-3 border border-yellow-800/30">
                        <div class="text-2xl font-bold text-yellow-400">{{ raid.pendingParticipants|length }}</div>
                        <div class="text-xs text-yellow-600 mt-0.5">intéressés</div>
                    </div>
                {% endif %}
            </div>

        </div>
    </div>

    {# ── Énigmes (pleine largeur) ── #}
    {% if raid.enigmes is not empty %}
        <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden mb-6">
            <div class="px-6 py-4 border-b border-gray-800 flex items-center justify-between">
                <h2 class="font-semibold text-white">Énigmes</h2>
            </div>
            <ul class="divide-y divide-gray-800/60">
                {% for enigme in raid.enigmes %}
                    <li>
                        <a href="{{ path('app_enigme_show', {id: enigme.id}) }}"
                           class="flex items-center justify-between px-6 py-4 hover:bg-gray-800/40 transition group">
                            <div class="flex items-center gap-3">
                                <span class="w-7 h-7 rounded-full bg-gray-800 border border-gray-700 flex items-center justify-center text-xs font-bold text-gray-400 shrink-0 group-hover:border-indigo-600/50 transition">
                                    {{ enigme.orderNumber }}
                                </span>
                                <span class="font-medium text-white text-sm">{{ enigme.title }}</span>
                            </div>
                            <div class="flex items-center gap-3">
                                {% if enigme.resolved %}
                                    <span class="text-xs font-medium bg-green-900/50 text-green-400 border border-green-800/50 rounded-full px-2.5 py-0.5">Résolue</span>
                                {% endif %}
                                {% if enigme.images|length > 0 %}
                                    <span class="text-xs text-gray-500">{{ enigme.images|length }} image{{ enigme.images|length > 1 ? 's' : '' }}</span>
                                {% endif %}
                                {% if enigme.comments|length > 0 %}
                                    <span class="text-xs text-gray-500">{{ enigme.comments|length }} commentaire{{ enigme.comments|length > 1 ? 's' : '' }}</span>
                                {% endif %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-600 group-hover:text-gray-400 transition" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {# ── Grid : contenu principal (50%) + sidebar commentaires (50%) ── #}
    <div class="grid gap-6 lg:grid-cols-2 items-start">

        {# ── Colonne gauche ── #}
        <div class="space-y-6">

            {# ── Participants confirmés ── #}
            <div class="{{ ui.card_classes('overflow-hidden') }}">
                <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                    <h2 class="font-semibold text-white">Participants</h2>
                    <span class="text-xs text-gray-500">
                        {{ raid.acceptedParticipants|length }} / {{ raid.raidTemplate.maxParticipants }}
                        {% if raid.isFull() %}<span class="text-red-400 ml-1">· Complet</span>{% endif %}
                    </span>
                </div>

                {% if raid.acceptedParticipants is empty %}
                    <div class="{{ ui.card_body_classes('py-10 text-center') }}">
                        <p class="text-gray-500 text-sm">Aucun participant confirmé pour l'instant.</p>
                    </div>
                {% else %}
                    <ul class="divide-y divide-gray-800/60" style="max-height:16rem;overflow-y:auto">
                        {% for p in raid.acceptedParticipants %}
                            {% set isGuildMember = p.character.membership is not null
                                and p.character.membership.guild.id == raid.guild.id
                                and p.character.membership.status != constant('App\\Entity\\MemberStatus::Pending') %}
                            <li class="flex items-center gap-5 px-6 py-5 hover:bg-gray-800/30 transition">
                                <img src="{{ asset('classes/' ~ p.character.gameClass.name|lower ~ '.png') }}"
                                     alt="{{ p.character.gameClass.name }}"
                                     class="w-11 h-11 rounded-full object-cover shrink-0">
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="font-semibold text-white text-sm truncate">{{ p.character.name }}</span>
                                        {% if p.character === raid.creator %}<span title="Créateur" class="text-sm leading-none">⭐</span>{% endif %}
                                        {% if isGuildMember %}{{ ui.badge('Guilde', 'indigo') }}{% else %}{{ ui.badge('Externe', 'warning') }}{% endif %}
                                        {% if app.user and p.character.user.id == app.user.id %}<span class="text-xs text-indigo-400 font-medium">vous</span>{% endif %}
                                    </div>
                                    <div class="mt-2 space-y-2 text-xs text-gray-500">
                                        <div class="flex items-center gap-3">
                                            <span>{{ p.character.user.username }}</span>
                                            {% if not (app.user and p.character.user.id == app.user.id) %}
                                                {{ ui.whisper(p.character.name) }}
                                            {% endif %}
                                        </div>
                                        {% if p.character.level or p.character.optimizationLevel %}
                                            <div class="flex items-center gap-3">
                                                {% if p.character.level %}<span class="text-gray-400">Niv. {{ p.character.level }}</span>{% endif %}
                                                {% if p.character.optimizationLevel %}{{ ui.badge('Opti ' ~ p.character.optimizationLevel.label(), p.character.optimizationLevel.color()) }}{% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                                {% if isCreator and p.character !== raid.creator %}
                                    <form method="post" action="{{ path('app_raid_kick', {id: p.id}) }}" class="shrink-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('kick_' ~ p.id) }}">
                                        <button type="submit" title="Retirer"
                                            class="w-8 h-8 rounded-full flex items-center justify-center bg-red-600/15 hover:bg-red-600/35 border border-red-600/30 text-red-400 hover:text-red-300 transition">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                            </svg>
                                        </button>
                                    </form>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="border-t border-gray-800/60 px-6 py-3">
                        <a href="{{ path('app_raid_participants', {id: raid.id}) }}"
                           class="text-xs text-gray-500 hover:text-indigo-400 transition">
                            Voir tous les participants →
                        </a>
                    </div>
                {% endif %}
            </div>

            {# ── Intéressés + Candidater ── #}
            <div class="{{ ui.card_classes('overflow-hidden') }}">
                <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                    <h2 class="font-semibold text-white">Intéressés</h2>
                    {% if raid.pendingParticipants|length > 0 %}
                        <span class="text-xs text-yellow-400">{{ raid.pendingParticipants|length }} en attente</span>
                    {% endif %}
                </div>

                {% if raid.pendingParticipants is empty %}
                    <div class="{{ ui.card_body_classes('py-10 text-center') }}">
                        <p class="text-gray-500 text-sm">Personne n'a encore candidaté.</p>
                    </div>
                {% else %}
                    <ul class="divide-y divide-gray-800/60" style="max-height:16rem;overflow-y:auto">
                        {% for p in raid.pendingParticipants %}
                            {% set isGuildMember = p.character.membership is not null
                                and p.character.membership.guild.id == raid.guild.id
                                and p.character.membership.status != constant('App\\Entity\\MemberStatus::Pending') %}
                            <li class="flex items-center gap-5 px-6 py-5 hover:bg-gray-800/20 transition">
                                <img src="{{ asset('classes/' ~ p.character.gameClass.name|lower ~ '.png') }}"
                                     alt="{{ p.character.gameClass.name }}"
                                     class="w-11 h-11 rounded-full object-cover shrink-0">
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="font-semibold text-white text-sm truncate">{{ p.character.name }}</span>
                                        {% if isGuildMember %}{{ ui.badge('Guilde', 'indigo') }}{% else %}{{ ui.badge('Externe', 'warning') }}{% endif %}
                                    </div>
                                    <div class="mt-2 space-y-2 text-xs text-gray-500">
                                        <div class="flex items-center gap-3">
                                            <span>{{ p.character.user.username }}</span>
                                            {{ ui.whisper(p.character.name) }}
                                        </div>
                                        {% if p.character.level or p.character.optimizationLevel %}
                                            <div class="flex items-center gap-3">
                                                {% if p.character.level %}<span class="text-gray-400">Niv. {{ p.character.level }}</span>{% endif %}
                                                {% if p.character.optimizationLevel %}{{ ui.badge('Opti ' ~ p.character.optimizationLevel.label(), p.character.optimizationLevel.color()) }}{% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                                {% if isCreator %}
                                    <div class="flex items-center gap-2 shrink-0">
                                        <form method="post" action="{{ path('app_raid_accept', {id: p.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('accept_' ~ p.id) }}">
                                            <button type="submit" title="Accepter"
                                                class="w-8 h-8 rounded-full flex items-center justify-center bg-indigo-600/15 hover:bg-indigo-600/35 border border-indigo-600/30 text-indigo-400 hover:text-indigo-300 transition">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                                </svg>
                                            </button>
                                        </form>
                                        <form method="post" action="{{ path('app_raid_kick', {id: p.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('kick_' ~ p.id) }}">
                                            <button type="submit" title="Refuser"
                                                class="w-8 h-8 rounded-full flex items-center justify-center bg-red-600/15 hover:bg-red-600/35 border border-red-600/30 text-red-400 hover:text-red-300 transition">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="border-t border-gray-800/60 px-6 py-3">
                        <a href="{{ path('app_raid_participants', {id: raid.id}) }}"
                           class="text-xs text-gray-500 hover:text-indigo-400 transition">
                            Voir tous les intéressés →
                        </a>
                    </div>
                {% endif %}

                {% if raid.status == constant('App\\Entity\\RaidStatus::Open') %}
                    {% if not app.user %}
                        <div class="border-t border-gray-800/60 px-6 py-3">
                            {{ ui.link_button('Se connecter pour candidater', path('app_login'), 'primary') }}
                        </div>
                    {% elseif eligible is not empty %}
                        <div class="border-t border-gray-800/60 px-6 py-3">
                            <form method="post" action="{{ path('app_raid_apply', {id: raid.id}) }}" class="flex items-center gap-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('apply_raid_' ~ raid.id) }}">
                                <select name="character_id"
                                    class="flex-1 min-w-0 bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
                                    {% for c in eligible %}
                                        {% set isMember = c.membership is not null and c.membership.guild.id == raid.guild.id and c.membership.status != constant('App\\Entity\\MemberStatus::Pending') %}
                                        {% set levelInfo = c.level ? ' · Niv. ' ~ c.level : '' %}
                                        {% set optiInfo  = c.optimizationLevel ? ' · Opti ' ~ c.optimizationLevel.label() : '' %}
                                        <option value="{{ c.id }}">{{ c.name }} — {{ c.gameClass.name }}{{ levelInfo }}{{ optiInfo }}{{ isMember ? ' [Guilde]' : ' [Externe]' }}</option>
                                    {% endfor %}
                                </select>
                                {{ ui.button('Candidater', 'primary', 'submit', 'py-2 px-4 text-sm shrink-0') }}
                            </form>
                        </div>
                    {% endif %}
                {% endif %}
            </div>

        </div>{# /col-gauche #}

        {# ── Sidebar commentaires (sticky) ── #}
        <div class="sticky top-6" id="commentaires">
            {% set totalComments = 0 %}
            {% for c in rootComments %}{% set totalComments = totalComments + 1 + c.children|length %}{% endfor %}

            <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden flex flex-col" style="max-height: calc(100vh - 5rem)">

                <div class="px-5 py-4 border-b border-gray-800 shrink-0 flex items-center justify-between">
                    <h2 class="font-semibold text-white text-sm">Commentaires</h2>
                    {% if totalComments > 0 %}<span class="text-xs text-gray-500">{{ totalComments }}</span>{% endif %}
                </div>

                <div class="flex-1 min-h-0 overflow-y-auto">
                    {% if rootComments is empty %}
                        <p class="p-5 text-center text-xs text-gray-600">Aucun commentaire pour l'instant.</p>
                    {% else %}
                        <ul class="divide-y divide-gray-800/60">
                            {% for comment in rootComments %}
                                {# li est lui-même un flex pour que la ligne du thread s'étire sur toute la hauteur #}
                                <li class="px-4 py-3 flex gap-2.5">

                                    {# Colonne gauche : avatar + ligne verticale de thread #}
                                    <div class="flex flex-col items-center shrink-0">
                                        <div class="w-7 h-7 rounded-full bg-indigo-900/60 border border-indigo-700/40 flex items-center justify-center text-xs font-bold text-indigo-300 uppercase select-none shrink-0">
                                            {{ comment.author.username|slice(0,1) }}
                                        </div>
                                        {% if comment.children|length > 0 %}
                                            <div class="w-px flex-1 bg-gray-700/50 mt-1.5 mb-1 rounded-full"></div>
                                        {% endif %}
                                    </div>

                                    {# Colonne droite : contenu du commentaire + réponses #}
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-1.5 mb-1 flex-wrap">
                                            <span class="text-xs font-semibold text-white">{{ comment.author.username }}</span>
                                            <span class="text-xs text-gray-600">{{ comment.createdAt|date('d/m H:i') }}</span>
                                            {% if app.user and (comment.author.id == app.user.id or isCreator) %}
                                                <form method="post" action="{{ path('app_raid_comment_delete', {id: comment.id}) }}" class="ml-auto">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                                                    <button type="submit" title="Supprimer" class="text-gray-600 hover:text-red-400 transition">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                        <p class="text-xs text-gray-300 leading-relaxed whitespace-pre-line break-words">{{ comment.content }}</p>
                                        {% if app.user %}
                                            <button type="button"
                                                onclick="var f=document.getElementById('rf-{{ comment.id }}');f.classList.toggle('hidden');f.querySelector('textarea').focus();"
                                                class="mt-1.5 text-xs text-gray-600 hover:text-indigo-400 transition">Répondre</button>
                                            <div id="rf-{{ comment.id }}" class="hidden mt-2">
                                                <form method="post" action="{{ path('app_raid_comment_reply', {id: comment.id}) }}" class="space-y-1.5">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('reply_' ~ comment.id) }}">
                                                    <textarea name="content" rows="2" placeholder="@{{ comment.author.username }} "
                                                        class="w-full bg-gray-800 border border-gray-700 text-white text-xs rounded-lg px-2.5 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none placeholder-gray-600"></textarea>
                                                    <div class="flex items-center gap-2">
                                                        <button type="submit" class="text-xs bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg px-3 py-1.5 transition">Envoyer</button>
                                                        <button type="button" onclick="document.getElementById('rf-{{ comment.id }}').classList.add('hidden')"
                                                            class="text-xs text-gray-500 hover:text-gray-300 transition">Annuler</button>
                                                    </div>
                                                </form>
                                            </div>
                                        {% endif %}

                                        {# Réponses — dans la même colonne, sous le commentaire #}
                                        {% if comment.children|length > 0 %}
                                            <div class="mt-3 space-y-3">
                                                {% for reply in comment.children %}
                                                    <div class="flex gap-2">
                                                        <div class="w-6 h-6 rounded-full bg-indigo-900/40 border border-indigo-700/30 flex items-center justify-center text-xs font-bold text-indigo-300/80 shrink-0 uppercase select-none">
                                                            {{ reply.author.username|slice(0,1) }}
                                                        </div>
                                                        <div class="flex-1 min-w-0">
                                                            <div class="flex items-center gap-1.5 mb-0.5 flex-wrap">
                                                                <span class="text-xs font-semibold text-gray-200">{{ reply.author.username }}</span>
                                                                <span class="text-xs text-gray-600">{{ reply.createdAt|date('d/m H:i') }}</span>
                                                                {% if app.user and (reply.author.id == app.user.id or isCreator) %}
                                                                    <form method="post" action="{{ path('app_raid_comment_delete', {id: reply.id}) }}" class="ml-auto">
                                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ reply.id) }}">
                                                                        <button type="submit" title="Supprimer" class="text-gray-600 hover:text-red-400 transition">
                                                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                                                                        </button>
                                                                    </form>
                                                                {% endif %}
                                                            </div>
                                                            <p class="text-xs text-gray-400 leading-relaxed whitespace-pre-line break-words">{{ reply.content }}</p>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>

                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>

                <div class="shrink-0 p-4 border-t border-gray-800">
                    {% if app.user %}
                        <form method="post" action="{{ path('app_raid_comment_new', {id: raid.id}) }}" class="space-y-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('comment_' ~ raid.id) }}">
                            <textarea name="content" rows="3" placeholder="Partagez une info, discutez des horaires…"
                                class="w-full bg-gray-800 border border-gray-700 text-white text-xs rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none placeholder-gray-600"></textarea>
                            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg py-2 transition">
                                Commenter
                            </button>
                        </form>
                    {% else %}
                        <a href="{{ path('app_login') }}"
                           class="block w-full text-center text-sm text-gray-500 hover:text-indigo-400 transition py-2 border border-gray-800 rounded-lg">
                            Se connecter pour commenter
                        </a>
                    {% endif %}
                </div>

            </div>
        </div>{# /sidebar #}

    </div>{# /grid #}

</div>

<script>
document.getElementById('share-btn').addEventListener('click', async function () {
    const url   = window.location.href;
    const label = document.getElementById('share-label');

    try {
        await navigator.clipboard.writeText(url);
        label.textContent = 'Lien copié !';
        setTimeout(() => label.textContent = 'Partager le raid', 2000);
    } catch {
        prompt('Copie ce lien :', url);
    }
});
</script>
{% endblock %}
