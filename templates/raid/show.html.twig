{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}{{ raid.raidTemplate.name }} – DoRaid{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-6 py-10">

    <a href="{{ path('app_guild_show', {id: raid.guild.id}) }}"
       class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-300 transition mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        {{ raid.guild.name }}
    </a>

    {# ── Hero ── #}
    <div class="rounded-2xl bg-gradient-to-br from-indigo-950/70 via-gray-900 to-gray-950 border border-indigo-900/30 px-8 py-7 mb-8">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6">
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-2">
                    {% if raid.status == constant('App\\Entity\\RaidStatus::Open') %}
                        {{ ui.badge(raid.status.label(), 'success') }}
                    {% else %}
                        {{ ui.badge(raid.status.label(), 'default') }}
                    {% endif %}
                    <span class="text-xs text-gray-500">{{ raid.guild.server.name }}</span>
                </div>
                <h1 class="text-3xl font-bold text-white tracking-tight">{{ raid.raidTemplate.name }}</h1>
                <p class="text-gray-400 text-sm mt-1">
                    {{ raid.raidTemplate.minParticipants }} – {{ raid.raidTemplate.maxParticipants }} joueurs
                    <span class="text-gray-700 mx-2">·</span>
                    Créé par <span class="text-gray-200 font-medium">{{ raid.creator.name }}</span>
                    <span class="text-gray-700 mx-2">·</span>
                    {{ raid.createdAt|date('d/m/Y') }}
                </p>
                {% if raid.scheduledAt %}
                    <p class="text-indigo-300 text-sm mt-1">
                        📅 {{ raid.scheduledAt|date('d/m/Y à H:i') }}
                    </p>
                {% endif %}
                {% if raid.description %}
                    <p class="text-gray-300 text-sm mt-3 leading-relaxed">{{ raid.description }}</p>
                {% endif %}
            </div>

            <div class="flex gap-6 shrink-0">
                <div class="text-center">
                    <div class="text-3xl font-bold {{ raid.isFull() ? 'text-red-400' : 'text-white' }}">
                        {{ raid.acceptedParticipants|length }}
                    </div>
                    <div class="text-xs text-gray-500 uppercase tracking-wider mt-0.5">
                        / {{ raid.raidTemplate.maxParticipants }}
                    </div>
                    <div class="text-xs text-gray-600 mt-0.5">
                        min {{ raid.raidTemplate.minParticipants }}
                    </div>
                </div>
                {% if raid.pendingParticipants|length > 0 %}
                    <div class="text-center">
                        <div class="text-3xl font-bold text-yellow-400">
                            {{ raid.pendingParticipants|length }}
                        </div>
                        <div class="text-xs text-gray-500 uppercase tracking-wider mt-0.5">intéressés</div>
                    </div>
                {% endif %}
            </div>
        </div>

        {% if isCreator %}
            <div class="flex items-center gap-3 mt-6 pt-5 border-t border-indigo-900/30">
                {% if raid.status == constant('App\\Entity\\RaidStatus::Open') %}
                    <form method="post" action="{{ path('app_raid_close', {id: raid.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('close_raid_' ~ raid.id) }}">
                        {{ ui.button('Marquer comme terminé', 'secondary', 'submit', 'py-1.5 px-3 text-xs') }}
                    </form>
                {% endif %}
                <form method="post" action="{{ path('app_raid_delete', {id: raid.id}) }}"
                      onsubmit="return confirm('Supprimer ce raid définitivement ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_raid_' ~ raid.id) }}">
                    {{ ui.button('Supprimer', 'danger', 'submit', 'py-1.5 px-3 text-xs') }}
                </form>
            </div>
        {% endif %}
    </div>

    {# ── Grille principale ── #}
    <div class="grid gap-6 lg:grid-cols-5">

        {# ── Participants confirmés ── #}
        <div class="lg:col-span-3 {{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                <h2 class="font-semibold text-white">Participants</h2>
                <span class="text-xs text-gray-500">
                    {{ raid.acceptedParticipants|length }} / {{ raid.raidTemplate.maxParticipants }}
                    {% if raid.isFull() %}<span class="text-red-400 ml-1">· Complet</span>{% endif %}
                </span>
            </div>

            {% if raid.acceptedParticipants is empty %}
                <div class="{{ ui.card_body_classes('py-10 text-center') }}">
                    <p class="text-gray-500 text-sm">Aucun participant confirmé pour l'instant.</p>
                </div>
            {% else %}
                <ul class="divide-y divide-gray-800/60">
                    {% for p in raid.acceptedParticipants %}
                        <li class="flex items-center gap-4 px-6 py-3.5 hover:bg-gray-800/30 transition">
                            <div class="w-9 h-9 rounded-full bg-gray-800 border border-gray-700 flex items-center justify-center text-sm font-bold text-gray-300 shrink-0">
                                {{ p.character.name|slice(0,1)|upper }}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-white truncate">{{ p.character.name }}</span>
                                    {% if p.character === raid.creator %}
                                        <span title="Créateur" class="text-base leading-none">⭐</span>
                                    {% endif %}
                                </div>
                                <div class="flex items-center gap-1.5 text-xs text-gray-400 mt-0.5 flex-wrap">
                                    <span>{{ p.character.gameClass.name }}</span>
                                    {% if p.character.user.id == app.user.id %}
                                        <span class="text-indigo-400 font-medium">· vous</span>
                                    {% else %}
                                        <span class="text-gray-600">· {{ p.character.user.username }}</span>
                                        {{ ui.whisper(p.character.name) }}
                                    {% endif %}
                                </div>
                            </div>
                            {% if isCreator and p.character !== raid.creator %}
                                <form method="post" action="{{ path('app_raid_kick', {id: p.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('kick_' ~ p.id) }}">
                                    {{ ui.button('Retirer', 'danger', 'submit', 'py-1.5 px-3 text-xs') }}
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            {# ── Candidatures en attente (créateur seulement) ── #}
            {% if isCreator and raid.pendingParticipants is not empty %}
                <div class="border-t border-gray-800/60">
                    <div class="px-6 py-3 bg-yellow-900/10">
                        <h3 class="text-sm font-semibold text-yellow-400">
                            Candidatures en attente ({{ raid.pendingParticipants|length }})
                        </h3>
                    </div>
                    <ul class="divide-y divide-gray-800/60">
                        {% for p in raid.pendingParticipants %}
                            <li class="flex items-center gap-4 px-6 py-3.5 hover:bg-gray-800/20 transition">
                                <div class="w-9 h-9 rounded-full bg-yellow-900/30 border border-yellow-800/40 flex items-center justify-center text-sm font-bold text-yellow-300 shrink-0">
                                    {{ p.character.name|slice(0,1)|upper }}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-medium text-white truncate">{{ p.character.name }}</div>
                                    <div class="text-xs text-gray-400 mt-0.5">
                                        {{ p.character.gameClass.name }}
                                        <span class="text-gray-600">· {{ p.character.user.username }}</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <form method="post" action="{{ path('app_raid_accept', {id: p.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('accept_' ~ p.id) }}">
                                        {{ ui.button('Accepter', 'primary', 'submit', 'py-1.5 px-3 text-xs') }}
                                    </form>
                                    <form method="post" action="{{ path('app_raid_kick', {id: p.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('kick_' ~ p.id) }}">
                                        {{ ui.button('Refuser', 'danger', 'submit', 'py-1.5 px-3 text-xs') }}
                                    </form>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>

        {# ── Je suis intéressé ── #}
        <div class="lg:col-span-2 {{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes() }}">
                <h2 class="font-semibold text-white">Participer</h2>
            </div>
            <div class="{{ ui.card_body_classes() }}">
                {% if raid.status != constant('App\\Entity\\RaidStatus::Open') %}
                    <p class="text-sm text-gray-500">Ce raid est terminé.</p>
                {% elseif participantCharacter is not null %}
                    <div class="flex items-center gap-2 text-sm text-green-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        <span>Vous participez avec <strong class="text-white">{{ participantCharacter.name }}</strong>.</span>
                    </div>
                {% elseif pendingApplication is not null %}
                    <div class="flex items-center gap-2 text-sm text-yellow-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                        </svg>
                        <span>Candidature de <strong class="text-white">{{ pendingApplication.character.name }}</strong> en attente d'approbation.</span>
                    </div>
                {% elseif eligible is empty %}
                    <p class="text-sm text-gray-500 leading-relaxed">
                        Aucun personnage disponible.<br>
                        Vous n'êtes peut-être pas membre confirmé de cette guilde.
                    </p>
                {% else %}
                    <form method="post" action="{{ path('app_raid_apply', {id: raid.id}) }}" class="space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('apply_raid_' ~ raid.id) }}">
                        <div>
                            {{ ui.label('character_id', 'Personnage') }}
                            <select id="character_id" name="character_id"
                                class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                                {% for c in eligible %}
                                    <option value="{{ c.id }}">{{ c.name }} — {{ c.gameClass.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <p class="text-xs text-gray-500 leading-relaxed">
                            Votre candidature sera soumise au créateur du raid pour validation.
                        </p>
                        {{ ui.button('Je suis intéressé', 'primary', 'submit') }}
                    </form>
                {% endif %}
            </div>
        </div>

    </div>

    {# ── Énigmes ── #}
    {% if participantCharacter is not null %}
        <div class="mt-8">
            <div class="flex items-center mb-4">
                <h2 class="text-lg font-semibold text-white">Énigmes</h2>
            </div>

            {% if raid.enigmes is empty %}
                <div class="bg-gray-900 border border-gray-800 rounded-2xl px-6 py-10 text-center">
                    <p class="text-gray-500 text-sm">Aucune énigme configurée pour ce type de raid.</p>
                </div>
            {% else %}
                <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
                    <ul class="divide-y divide-gray-800/60">
                        {% for enigme in raid.enigmes %}
                            <li>
                                <a href="{{ path('app_enigme_show', {id: enigme.id}) }}"
                                   class="flex items-center justify-between px-6 py-4 hover:bg-gray-800/40 transition group">
                                    <div class="flex items-center gap-3">
                                        <span class="w-7 h-7 rounded-full bg-gray-800 border border-gray-700 flex items-center justify-center
                                                     text-xs font-bold text-gray-400 shrink-0 group-hover:border-indigo-600/50 transition">
                                            {{ enigme.orderNumber }}
                                        </span>
                                        <span class="font-medium text-white text-sm">{{ enigme.title }}</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        {% if enigme.resolved %}
                                            <span class="text-xs font-medium bg-green-900/50 text-green-400 border border-green-800/50 rounded-full px-2.5 py-0.5">
                                                Résolue
                                            </span>
                                        {% endif %}
                                        {% if enigme.images|length > 0 %}
                                            <span class="text-xs text-gray-500">
                                                {{ enigme.images|length }} image{{ enigme.images|length > 1 ? 's' : '' }}
                                            </span>
                                        {% endif %}
                                        {% if enigme.comments|length > 0 %}
                                            <span class="text-xs text-gray-500">
                                                {{ enigme.comments|length }} commentaire{{ enigme.comments|length > 1 ? 's' : '' }}
                                            </span>
                                        {% endif %}
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-600 group-hover:text-gray-400 transition" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                    </div>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    {% endif %}

</div>
{% endblock %}
