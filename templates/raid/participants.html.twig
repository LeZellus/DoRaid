{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Participants – {{ raid.raidTemplate.name }} – Zeminal{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-6 py-10">

    {# ── Breadcrumb ── #}
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a href="{{ path('app_guild_show', {slug: raid.guild.slug}) }}" class="hover:text-gray-300 transition">{{ raid.guild.name }}</a>
        <span class="text-gray-700">/</span>
        <a href="{{ path('app_raid_show', {id: raid.id}) }}" class="hover:text-gray-300 transition">{{ raid.raidTemplate.name }}</a>
        <span class="text-gray-700">/</span>
        <span class="text-gray-300">Participants</span>
    </nav>

    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-white">Participants – {{ raid.raidTemplate.name }}</h1>
        <span class="text-sm text-gray-500">
            {{ raid.acceptedParticipants|length }} / {{ raid.raidTemplate.maxParticipants }}
            {% if raid.isFull() %}<span class="text-red-400 ml-1">· Complet</span>{% endif %}
            {% if raid.pendingParticipants|length > 0 %}
                · <span class="text-yellow-400">{{ raid.pendingParticipants|length }} en attente</span>
            {% endif %}
        </span>
    </div>

    {# ── Participants confirmés ── #}
    <div class="{{ ui.card_classes('overflow-hidden mb-6') }}">
        <div class="{{ ui.card_header_classes() }}">
            <h2 class="font-semibold text-white">Participants confirmés</h2>
        </div>

        {% if raid.acceptedParticipants is empty %}
            <div class="{{ ui.card_body_classes('py-10 text-center') }}">
                <p class="text-gray-500 text-sm">Aucun participant confirmé pour l'instant.</p>
            </div>
        {% else %}
            <ul class="divide-y divide-gray-800/60">
                {% for p in raid.acceptedParticipants %}

                    <li class="flex items-center gap-5 px-6 py-5 hover:bg-gray-800/30 transition">
                        <img src="{{ asset('classes/' ~ p.character.gameClass.name|lower ~ '.png') }}"
                             alt="{{ p.character.gameClass.name }}"
                             class="w-11 h-11 rounded-full object-cover shrink-0">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="font-semibold text-white text-sm truncate">{{ p.character.name }}</span>
                                {% if p.character === raid.creator %}<span title="Créateur" class="text-sm leading-none">⭐</span>{% endif %}
                                {% if p.guildMember %}{{ ui.badge('Guilde', 'indigo') }}{% else %}{{ ui.badge('Externe', 'warning') }}{% endif %}
                                {% if app.user and p.character.user.id == app.user.id %}<span class="text-xs text-indigo-400 font-medium">vous</span>{% endif %}
                            </div>
                            <div class="mt-2 space-y-2 text-xs text-gray-500">
                                <div class="flex items-center gap-3">
                                    <span>{{ p.character.user.username }}</span>
                                    {% if not (app.user and p.character.user.id == app.user.id) %}
                                        {{ ui.whisper(p.character.name) }}
                                    {% endif %}
                                </div>
                                {% if p.character.level or p.character.optimizationLevel %}
                                    <div class="flex items-center gap-3">
                                        {% if p.character.level %}<span class="text-gray-400">Niv. {{ p.character.level }}</span>{% endif %}
                                        {% if p.character.optimizationLevel %}{{ ui.badge('Opti ' ~ p.character.optimizationLevel.label(), p.character.optimizationLevel.color()) }}{% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        {% if isCreator and p.character !== raid.creator %}
                            <div class="flex items-center gap-2 shrink-0">
                                {% if myOtherRaids is not empty %}
                                    <form method="post" action="{{ path('app_raid_move', {id: p.id}) }}" class="flex items-center gap-1">
                                        <input type="hidden" name="_token" value="{{ csrf_token('move_' ~ p.id) }}">
                                        <select name="target_raid_id" class="bg-gray-800 border border-gray-700 text-gray-300 text-xs rounded px-1.5 py-1.5 max-w-[6.5rem] focus:outline-none focus:ring-1 focus:ring-sky-500">
                                            {% for r in myOtherRaids %}
                                                <option value="{{ r.id }}">{{ r.raidTemplate.name }} ({{ r.creator.name }}){{ r.scheduledAt ? ' · ' ~ r.scheduledAt|date('d/m') : '' }}</option>
                                            {% endfor %}
                                        </select>
                                        <button type="submit" title="Déplacer vers un autre raid"
                                            class="w-8 h-8 rounded-full flex items-center justify-center bg-sky-600/15 hover:bg-sky-600/35 border border-sky-600/30 text-sky-400 hover:text-sky-300 transition shrink-0">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.939 5.7a.75.75 0 111.122-.998l4.25 4.75a.75.75 0 010 .997l-4.25 4.75a.75.75 0 11-1.122-.998l3.45-3.55H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                                            </svg>
                                        </button>
                                    </form>
                                {% endif %}
                                <form method="post" action="{{ path('app_raid_transfer_creator', {id: p.id}) }}"
                                      onsubmit="return confirm('Nommer {{ p.character.name }} créateur du raid ? Il gérera les candidatures à votre place.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('transfer_creator_' ~ p.id) }}">
                                    <button type="submit" title="Nommer créateur du raid"
                                        class="w-8 h-8 rounded-full flex items-center justify-center bg-violet-600/15 hover:bg-violet-600/35 border border-violet-600/30 text-violet-400 hover:text-violet-300 transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L10 18.354l-4.123 2.555c-.997.608-2.232-.289-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.748-2.305l5.404-.433L10.788 3.21z"/>
                                        </svg>
                                    </button>
                                </form>
                                <form method="post" action="{{ path('app_raid_unaccept', {id: p.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('unaccept_' ~ p.id) }}">
                                    <button type="submit" title="Remettre sur la liste des intéressés"
                                        class="w-8 h-8 rounded-full flex items-center justify-center bg-yellow-600/15 hover:bg-yellow-600/35 border border-yellow-600/30 text-yellow-400 hover:text-yellow-300 transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M9.793 2.232a.75.75 0 01-.025 1.06L4.622 8.25h13.575a.75.75 0 010 1.5H4.622l5.146 4.958a.75.75 0 11-1.04 1.082l-6.5-6.25a.75.75 0 010-1.082l6.5-6.25a.75.75 0 011.065.025z" clip-rule="evenodd"/>
                                        </svg>
                                    </button>
                                </form>
                                <form method="post" action="{{ path('app_raid_kick', {id: p.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('kick_' ~ p.id) }}">
                                    <button type="submit" title="Retirer"
                                        class="w-8 h-8 rounded-full flex items-center justify-center bg-red-600/15 hover:bg-red-600/35 border border-red-600/30 text-red-400 hover:text-red-300 transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    {# ── Intéressés (créateur uniquement ou si candidatures en attente) ── #}
    {% if raid.pendingParticipants|length > 0 %}
        <div class="{{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes('flex items-center gap-3') }}">
                <h2 class="font-semibold text-white">Intéressés</h2>
                {{ ui.badge(raid.pendingParticipants|length ~ ' en attente', 'warning') }}
            </div>
            <ul class="divide-y divide-gray-800/60">
                {% for p in raid.pendingParticipants %}

                    <li class="flex items-center gap-5 px-6 py-5 hover:bg-gray-800/20 transition">
                        <img src="{{ asset('classes/' ~ p.character.gameClass.name|lower ~ '.png') }}"
                             alt="{{ p.character.gameClass.name }}"
                             class="w-11 h-11 rounded-full object-cover shrink-0">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="font-semibold text-white text-sm truncate">{{ p.character.name }}</span>
                                {% if p.guildMember %}{{ ui.badge('Guilde', 'indigo') }}{% else %}{{ ui.badge('Externe', 'warning') }}{% endif %}
                            </div>
                            <div class="mt-2 space-y-2 text-xs text-gray-500">
                                <div class="flex items-center gap-3">
                                    <span>{{ p.character.user.username }}</span>
                                    {{ ui.whisper(p.character.name) }}
                                </div>
                                {% if p.character.level or p.character.optimizationLevel %}
                                    <div class="flex items-center gap-3">
                                        {% if p.character.level %}<span class="text-gray-400">Niv. {{ p.character.level }}</span>{% endif %}
                                        {% if p.character.optimizationLevel %}{{ ui.badge('Opti ' ~ p.character.optimizationLevel.label(), p.character.optimizationLevel.color()) }}{% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        {% if isCreator %}
                            <div class="flex items-center gap-2 shrink-0">
                                {% if myOtherRaids is not empty %}
                                    <form method="post" action="{{ path('app_raid_move', {id: p.id}) }}" class="flex items-center gap-1">
                                        <input type="hidden" name="_token" value="{{ csrf_token('move_' ~ p.id) }}">
                                        <select name="target_raid_id" class="bg-gray-800 border border-gray-700 text-gray-300 text-xs rounded px-1.5 py-1.5 max-w-[6.5rem] focus:outline-none focus:ring-1 focus:ring-sky-500">
                                            {% for r in myOtherRaids %}
                                                <option value="{{ r.id }}">{{ r.raidTemplate.name }} ({{ r.creator.name }}){{ r.scheduledAt ? ' · ' ~ r.scheduledAt|date('d/m') : '' }}</option>
                                            {% endfor %}
                                        </select>
                                        <button type="submit" title="Déplacer vers un autre raid"
                                            class="w-8 h-8 rounded-full flex items-center justify-center bg-sky-600/15 hover:bg-sky-600/35 border border-sky-600/30 text-sky-400 hover:text-sky-300 transition shrink-0">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.939 5.7a.75.75 0 111.122-.998l4.25 4.75a.75.75 0 010 .997l-4.25 4.75a.75.75 0 11-1.122-.998l3.45-3.55H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                                            </svg>
                                        </button>
                                    </form>
                                {% endif %}
                                <form method="post" action="{{ path('app_raid_accept', {id: p.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('accept_' ~ p.id) }}">
                                    <button type="submit" title="Accepter"
                                        class="w-8 h-8 rounded-full flex items-center justify-center bg-indigo-600/15 hover:bg-indigo-600/35 border border-indigo-600/30 text-indigo-400 hover:text-indigo-300 transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                    </button>
                                </form>
                                <form method="post" action="{{ path('app_raid_kick', {id: p.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('kick_' ~ p.id) }}">
                                    <button type="submit" title="Refuser"
                                        class="w-8 h-8 rounded-full flex items-center justify-center bg-red-600/15 hover:bg-red-600/35 border border-red-600/30 text-red-400 hover:text-red-300 transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

</div>
{% endblock %}
