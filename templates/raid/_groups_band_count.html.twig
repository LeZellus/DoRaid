{# Compteur + barre de progression affichés dans le bandeau "Groupes", en dehors de la popup — rafraîchi via Turbo Stream à chaque action. #}
<div id="raid-groups-band-count">
    <p class="text-xs text-gray-400 mt-0.5">
        {% if raid.groups is empty %}Aucun groupe formé pour l'instant{% else %}{{ raid.groups|length }} groupe{{ raid.groups|length > 1 ? 's' : '' }} formé{{ raid.groups|length > 1 ? 's' : '' }}{% endif %}
    </p>

    {% set total = raid.acceptedParticipants|length %}
    {% set assignedCount = 0 %}
    {% for group in raid.groups %}
        {% set assignedCount = assignedCount + group.participants|length %}
    {% endfor %}

    {% if total > 0 %}
        <div class="flex items-center gap-2 mt-2 max-w-xs">
            <div class="h-1.5 flex-1 rounded-full bg-gray-800 overflow-hidden">
                <div class="h-full bg-blue-500 rounded-full transition-all" style="width: {{ (assignedCount / total * 100)|round }}%"></div>
            </div>
            <span class="text-[11px] text-gray-500 tabular-nums shrink-0">{{ assignedCount }}/{{ total }}</span>
        </div>
    {% endif %}
</div>
