{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Créer un raid – {{ guild.name }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-6 py-10">

    <a href="{{ path('app_guild_show', {slug: guild.slug}) }}"
       class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-300 transition mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        {{ guild.name }}
    </a>

    <h1 class="text-2xl font-bold text-white mb-2">Créer un raid</h1>
    <p class="text-gray-500 text-sm mb-8">Guilde <span class="text-gray-300">{{ guild.name }}</span> · {{ guild.server.name }}</p>

    {{ form_start(form) }}
    <input type="hidden" name="raid_template_id" id="raid_template_id"
           value="{{ app.request.request.get('raid_template_id') }}">

    {# ── Étape 1 : choisir le type de raid ── #}
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-widest mb-4">1. Choisir le raid</p>
    <div class="grid grid-cols-2 gap-3 mb-8">
        {% for template in templates %}
            <button type="button"
                    data-id="{{ template.id }}"
                    onclick="selectTemplate(this)"
                    class="template-card flex flex-col items-center gap-2 px-5 py-6 rounded-2xl border-2 border-gray-700 bg-gray-900 hover:border-indigo-500 hover:bg-indigo-950/20 transition text-center cursor-pointer">
                <span class="text-2xl">⚔</span>
                <span class="font-semibold text-white text-lg">{{ template.name }}</span>
                <span class="text-xs text-gray-400">{{ template.minParticipants }} – {{ template.maxParticipants }} joueurs</span>
            </button>
        {% endfor %}
    </div>

    {# ── Étape 2 : détails + confirmation ── #}
    <div id="form-details" class="{{ not form.vars.valid ? '' : 'hidden' }} space-y-6">

        {{ ui.divider('Détails du raid') }}

        {# Personnage créateur #}
        <div>
            {{ ui.label('character_id', 'Votre personnage') }}
            <select name="character_id" id="character_id"
                    class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                {% for character in characters %}
                    <option value="{{ character.id }}">{{ character.name }} — {{ character.gameClass.name }}</option>
                {% endfor %}
            </select>
        </div>

        {{ form_row(form.description) }}
        {{ form_row(form.scheduledAt) }}

        <div class="flex justify-end pt-2">
            {{ ui.button('Créer le raid', 'primary') }}
        </div>

    </div>

    {{ form_end(form) }}

</div>

<script>
function selectTemplate(el) {
    document.querySelectorAll('.template-card').forEach(function(c) {
        c.classList.remove('border-indigo-500', 'bg-indigo-950/20', 'ring-2', 'ring-indigo-500/30');
    });
    el.classList.add('border-indigo-500', 'bg-indigo-950/20', 'ring-2', 'ring-indigo-500/30');
    document.getElementById('raid_template_id').value = el.dataset.id;
    document.getElementById('form-details').classList.remove('hidden');
    document.getElementById('form-details').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

(function () {
    var selectedId = document.getElementById('raid_template_id').value;
    if (selectedId) {
        var card = document.querySelector('.template-card[data-id="' + selectedId + '"]');
        if (card) {
            card.classList.add('border-indigo-500', 'bg-indigo-950/20', 'ring-2', 'ring-indigo-500/30');
        }
    }
})();
</script>
{% endblock %}
