{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Créer un raid – {{ guild.name }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-6 py-10">

    <a href="{{ path('app_guild_show', {slug: guild.slug}) }}"
       class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-300 transition mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        {{ guild.name }}
    </a>

    <h1 class="text-2xl font-bold text-white mb-2">Créer un raid</h1>
    <p class="text-gray-500 text-sm mb-8">Guilde <span class="text-gray-300">{{ guild.name }}</span> · {{ guild.server.name }}</p>

    {{ form_start(form) }}
    <input type="hidden" name="raid_template_id" id="raid_template_id"
           value="{{ app.request.request.get('raid_template_id') }}">

    {# ── Étape 1 : choisir le type de raid ── #}
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-widest mb-4">1. Choisir le raid</p>
    <div class="grid grid-cols-2 gap-3 mb-8">
        {% for template in templates %}
            <button type="button"
                    data-id="{{ template.id }}"
                    onclick="selectTemplate(this)"
                    class="template-card flex flex-col items-center gap-2 px-5 py-6 rounded-2xl border-2 border-gray-700 bg-gray-900 hover:border-emerald-500 hover:bg-emerald-950/20 transition text-center cursor-pointer">
                {% if template.imagePath %}
                    <img src="{{ asset('uploads/raid-templates/' ~ template.imagePath) }}"
                         alt="{{ template.name }}"
                         class="w-16 h-16 rounded-xl object-cover">
                {% else %}
                    <span class="text-2xl">⚔</span>
                {% endif %}
                <span class="font-semibold text-white text-lg">{{ template.name }}</span>
                <span class="text-xs text-gray-400">{{ template.minParticipants }} – {{ template.maxParticipants }} joueurs</span>
            </button>
        {% endfor %}
    </div>

    {# ── Étape 2 : détails + confirmation ── #}
    <div id="form-details" class="{{ not form.vars.valid ? '' : 'hidden' }} space-y-6">

        {{ ui.divider('Détails du raid') }}

        {# Personnage créateur #}
        <div>
            {{ ui.label('character_id', 'Votre personnage') }}
            <div class="relative" data-controller="select">
                <select name="character_id" id="character_id" class="hidden">
                    {% for character in characters %}
                        <option value="{{ character.id }}">{{ character.name }} — {{ character.gameClass.name }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        {{ form_row(form.description) }}

        {# ── Visibilité ── #}
        <div class="flex items-center justify-between bg-gray-800/40 border border-gray-700/50 rounded-xl px-4 py-3">
            <div>
                <p class="text-sm font-medium text-white">Raid public</p>
                <p class="text-xs text-gray-500 mt-0.5">Visible par tous les membres du site</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
                {{ form_widget(form.isPublic, {attr: {class: 'sr-only peer', id: 'raid_isPublic'}}) }}
                <div class="w-11 h-6 bg-gray-700 rounded-full peer peer-checked:bg-emerald-600
                            after:content-[''] after:absolute after:top-[2px] after:left-[2px]
                            after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all
                            peer-checked:after:translate-x-5"></div>
            </label>
        </div>

        <div>
            {{ form_label(form.scheduledAt, null, {
                label_attr: { class: 'block text-sm font-medium text-gray-300 mb-2' }
            }) }}
            {{ form_widget(form.scheduledAt, {
                attr: {
                    class: 'w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent cursor-pointer',
                    style: 'color-scheme: dark',
                    id: 'scheduledAt'
                }
            }) }}
            {{ form_errors(form.scheduledAt) }}
        </div>

        <div class="flex justify-end pt-2">
            {{ ui.button('Créer le raid', 'primary') }}
        </div>

    </div>

    {{ form_end(form) }}

</div>

<script>
function selectTemplate(el) {
    document.querySelectorAll('.template-card').forEach(function(c) {
        c.classList.remove('border-emerald-500', 'bg-emerald-950/20', 'ring-2', 'ring-emerald-500/30');
    });
    el.classList.add('border-emerald-500', 'bg-emerald-950/20', 'ring-2', 'ring-emerald-500/30');
    document.getElementById('raid_template_id').value = el.dataset.id;
    document.getElementById('form-details').classList.remove('hidden');
    document.getElementById('form-details').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

(function () {
    var selectedId = document.getElementById('raid_template_id').value;
    if (selectedId) {
        var card = document.querySelector('.template-card[data-id="' + selectedId + '"]');
        if (card) {
            card.classList.add('border-emerald-500', 'bg-emerald-950/20', 'ring-2', 'ring-emerald-500/30');
        }
    }

    var dateInput = document.getElementById('scheduledAt');
    if (dateInput) {
        dateInput.addEventListener('click', function () {
            try { this.showPicker(); } catch (e) {}
        });
    }
})();
</script>
{% endblock %}
