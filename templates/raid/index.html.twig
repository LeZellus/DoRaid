{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Raids Dofus publics – Tous serveurs – Zeminal{% endblock %}
{% block meta_description %}Tous les raids Dofus publics, ouverts sur tous les serveurs. Rejoignez un groupe ou publiez votre propre raid pour recruter des joueurs.{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-6 py-12" data-controller="reveal countdown">

    <div class="flex items-center justify-between mb-3" data-reveal>
        <h1 class="text-3xl font-bold text-white">Raids Dofus</h1>
    </div>
    <p class="text-gray-500 text-sm mb-8 max-w-2xl" data-reveal data-reveal-delay="1">Retrouvez tous les raids publics ouverts sur Zeminal, tous serveurs Dofus confondus. Filtrez par serveur ou par type pour trouver un groupe qui correspond à votre personnage.</p>

    {# ── Filtres ── #}
    {% set anyFilter = currentServer or filterNotFull or filterSoon or filterType %}
    <form method="get" action="{{ path('app_raid_index') }}" id="raid-filters"
          class="bg-gray-900/60 border border-gray-800/50 rounded-2xl p-5 mb-8" data-reveal data-reveal-delay="2">

        {# Ligne serveur #}
        <div class="flex items-center gap-3 flex-wrap">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider w-16 shrink-0">Serveur</span>
            <div class="flex items-center gap-2 flex-wrap">
                <label class="cursor-pointer px-3 py-1 rounded-lg text-sm font-medium transition
                               {{ not currentServer ? 'bg-indigo-600 text-white' : 'text-gray-400 hover:text-gray-200 hover:bg-gray-800/60' }}">
                    <input type="radio" name="server" value="" class="sr-only" {{ not currentServer ? 'checked' : '' }}>
                    Tous
                </label>
                {% for server in servers %}
                    <label class="cursor-pointer px-3 py-1 rounded-lg text-sm font-medium transition
                                   {{ currentServer == server.name ? 'bg-indigo-600 text-white' : 'text-gray-400 hover:text-gray-200 hover:bg-gray-800/60' }}">
                        <input type="radio" name="server" value="{{ server.name }}" class="sr-only" {{ currentServer == server.name ? 'checked' : '' }}>
                        {{ server.name }}
                    </label>
                {% endfor %}
            </div>
        </div>

        {# Ligne type de raid #}
        {% if raidTypes is not empty %}
            <div class="border-t border-gray-800/60 my-3"></div>
            <div class="flex items-center gap-3 flex-wrap">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider w-16 shrink-0">Type</span>
                <div class="flex items-center gap-2 flex-wrap">
                    <label class="cursor-pointer px-3 py-1 rounded-lg text-sm font-medium transition
                                   {{ not filterType ? 'bg-indigo-600 text-white' : 'text-gray-400 hover:text-gray-200 hover:bg-gray-800/60' }}">
                        <input type="radio" name="type" value="" class="sr-only" {{ not filterType ? 'checked' : '' }}>
                        Tous
                    </label>
                    {% for type in raidTypes %}
                        <label class="cursor-pointer px-3 py-1 rounded-lg text-sm font-medium transition
                                       {{ filterType == type ? 'bg-indigo-600 text-white' : 'text-gray-400 hover:text-gray-200 hover:bg-gray-800/60' }}">
                            <input type="radio" name="type" value="{{ type }}" class="sr-only" {{ filterType == type ? 'checked' : '' }}>
                            {{ type }}
                        </label>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <div class="border-t border-gray-800/60 my-3"></div>

        {# Ligne filtres #}
        <div class="flex items-center gap-3 flex-wrap">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider w-16 shrink-0">Filtres</span>
            <div class="flex items-center gap-2 flex-wrap">

                {# Places disponibles #}
                <label class="cursor-pointer inline-flex items-center gap-2 px-3 py-1 rounded-lg text-sm font-medium transition border
                               {{ filterNotFull
                                  ? 'bg-emerald-950/60 border-emerald-800/60 text-emerald-300'
                                  : 'border-gray-700/60 text-gray-400 hover:text-gray-200 hover:border-gray-600 hover:bg-gray-800/40' }}">
                    <input type="checkbox" name="not_full" value="1" class="sr-only" {{ filterNotFull ? 'checked' : '' }}>
                    <span class="w-3.5 h-3.5 rounded-full border shrink-0
                                 {{ filterNotFull ? 'bg-emerald-400 border-emerald-400' : 'border-gray-600' }}"></span>
                    Places disponibles
                </label>

                {# Bientôt #}
                <label class="cursor-pointer inline-flex items-center gap-2 px-3 py-1 rounded-lg text-sm font-medium transition border
                               {{ filterSoon
                                  ? 'bg-yellow-950/50 border-yellow-800/60 text-yellow-300'
                                  : 'border-gray-700/60 text-gray-400 hover:text-gray-200 hover:border-gray-600 hover:bg-gray-800/40' }}">
                    <input type="checkbox" name="soon" value="1" class="sr-only" {{ filterSoon ? 'checked' : '' }}>
                    <span class="w-3.5 h-3.5 rounded-full border shrink-0
                                 {{ filterSoon ? 'bg-yellow-400 border-yellow-400' : 'border-gray-600' }}"></span>
                    Commence bientôt
                    <span class="text-xs opacity-50">48h</span>
                </label>

            </div>

            {% if anyFilter %}
                <a href="{{ path('app_raid_index') }}"
                   class="ml-auto text-xs text-gray-600 hover:text-gray-400 transition underline underline-offset-2">
                    Réinitialiser
                </a>
            {% endif %}
        </div>

    </form>

    {# ── Mes raids en cours ── #}
    {% if myParticipations is not empty %}
        <div class="{{ ui.card_classes('overflow-hidden mb-8') }}" data-reveal>
            <div class="{{ ui.card_header_classes('flex items-center justify-between bg-emerald-950/30') }}">
                <h2 class="font-semibold text-emerald-400 flex items-center gap-2">👤 Mes raids en cours</h2>
                <span class="text-xs text-gray-500">{{ myParticipations|length }} raid{{ myParticipations|length > 1 ? 's' : '' }}</span>
            </div>
            <ul class="divide-y divide-gray-800/60">
                {% for participation in myParticipations %}
                    {% include 'components/_raid_participation_row.html.twig' with {participation: participation} only %}
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if upcomingRaids is empty and startedRaids is empty and ongoingRaids is empty %}
        <div class="{{ ui.card_classes('p-12 text-center') }}">
            <p class="text-gray-400 text-lg">Aucun raid disponible{% if currentServer %} sur {{ currentServer }}{% endif %}.</p>
        </div>
    {% else %}

        {# ── Macro ligne raid ── #}
        {# mode: 'before' = À venir, 'after' = Commencés, null = En cours #}
        {% macro raid_row(raid, userGuildIds, mode) %}
            {% import 'components/_ui.html.twig' as ui %}
            {% set isMyGuild = raid.guild.id in userGuildIds %}
            {% set isFull    = raid.isFull() %}
            {% set hasDate   = raid.scheduledAt is not null %}
            {% set isFuture  = hasDate and raid.scheduledAt > date() %}

            <li>
                {# ── Bandeau countdown ── #}
                {% if mode == 'before' and isFuture %}
                    <div class="flex items-center gap-2 px-6 py-1.5 bg-yellow-950/50 border-b border-yellow-900/40 text-xs font-medium text-yellow-400"
                         data-countdown="{{ raid.scheduledAt|date('U') }}"
                         data-mode="before">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                        </svg>
                        <span class="countdown-text">…</span>
                    </div>
                {% endif %}
                {% set _closed = raid.status == constant('App\\Entity\\RaidStatus::Closed') %}
                {% if _closed %}
                    <div class="flex items-center gap-2 px-6 py-1.5 bg-gray-800/50 border-b border-gray-700/40 text-xs font-medium text-gray-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707a1 1 0 00-1.414-1.414L9 10.172 7.707 8.879a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        Raid terminé
                    </div>
                {% elseif mode == 'after' and hasDate and not isFuture %}
                    <div class="flex items-center gap-2 px-6 py-1.5 bg-green-950/40 border-b border-green-900/30 text-xs font-medium text-green-400"
                         data-countdown="{{ raid.scheduledAt|date('U') }}"
                         data-mode="after"
                         {% if raid.expectedEndTime %}data-end="{{ raid.expectedEndTime|date('U') }}"{% endif %}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        <span class="countdown-text">…</span>
                        {% if raid.expectedEndTime %}
                            <span class="ml-auto countdown-end-text text-green-700">…</span>
                        {% endif %}
                    </div>
                {% endif %}

                {# ── Ligne principale ── #}
                <a href="{{ path('app_raid_show', {id: raid.id}) }}"
                   class="flex items-center gap-4 px-6 py-4 transition group hover:bg-gray-800/30
                          {{ isFull ? 'opacity-60' : '' }}">

                    {% if raid.raidTemplate.imagePath %}
                        <img src="{{ asset('uploads/raid-templates/' ~ raid.raidTemplate.imagePath) }}"
                             alt="{{ raid.raidTemplate.name }}"
                             class="w-11 h-11 rounded-xl object-cover shrink-0">
                    {% else %}
                        <span class="w-11 h-11 rounded-xl bg-indigo-900/40 border border-indigo-800/30 flex items-center justify-center text-xl shrink-0">⚔</span>
                    {% endif %}

                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-semibold text-white group-hover:text-indigo-300 transition truncate">
                                {{ raid.raidTemplate.name }}
                            </span>
                            {% if isFull %}
                                <span class="text-xs font-medium bg-red-900/50 text-red-400 border border-red-800/40 rounded-full px-2 py-0.5 shrink-0">Complet</span>
                            {% endif %}
                            {% if isMyGuild %}
                                <span class="text-xs font-medium bg-indigo-900/50 text-indigo-300 border border-indigo-700/40 rounded-full px-2 py-0.5 shrink-0">Ma guilde</span>
                            {% endif %}
                            {% if not raid.public %}
                                <span class="text-xs font-medium bg-gray-800 text-gray-500 border border-gray-700/40 rounded-full px-2 py-0.5 shrink-0">🔒 Privé</span>
                            {% endif %}
                        </div>
                        <div class="flex items-center gap-2 text-xs text-gray-500 mt-0.5 flex-wrap">
                            {% if raid.guild.imagePath %}
                                <img src="{{ asset('uploads/guildes/' ~ raid.guild.slug ~ '/' ~ raid.guild.imagePath) }}"
                                     alt="{{ raid.guild.name }}"
                                     class="w-4 h-4 rounded object-contain">
                            {% endif %}
                            <span>{{ raid.guild.name }}</span>
                            <span class="text-gray-700">·</span>
                            <span>{{ raid.guild.server.name }}</span>
                            {% if hasDate %}
                                <span class="text-gray-700">·</span>
                                <span class="text-gray-400">{{ raid.scheduledAt|date('d/m à H:i') }}</span>
                            {% endif %}
                            {% if raid.raidTemplate.formattedDuration %}
                                <span class="text-gray-700">·</span>
                                <span class="inline-flex items-center gap-1 text-gray-500">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                                    </svg>
                                    {{ raid.raidTemplate.formattedDuration }}
                                </span>
                            {% endif %}
                            <span class="text-gray-700">·</span>
                            <span>par {{ raid.creator.name }}</span>
                        </div>
                    </div>

                    <div class="text-right shrink-0">
                        <div class="text-sm font-medium {{ isFull ? 'text-red-400' : 'text-indigo-400' }}">
                            {{ raid.acceptedParticipants|length }}<span class="text-gray-600 font-normal">/{{ raid.raidTemplate.maxParticipants }}</span>
                        </div>
                        <div class="text-xs text-gray-600 mt-0.5">joueurs</div>
                        <div class="text-xs text-yellow-500/70 mt-0.5">+{{ raid.pendingParticipants|length }} intéressé{{ raid.pendingParticipants|length > 1 ? 's' : '' }}</div>
                    </div>

                </a>
            </li>
        {% endmacro %}

        {# ── À venir ── #}
        {% if upcomingRaids is not empty %}
            <div class="{{ ui.card_classes('overflow-hidden mb-6') }}" data-reveal>
                <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                    <h2 class="font-semibold text-white flex items-center gap-2">🌐 Raids de la communauté</h2>
                    <span class="text-xs text-gray-500">{{ upcomingRaids|length }} raid{{ upcomingRaids|length > 1 ? 's' : '' }}</span>
                </div>
                <ul class="divide-y divide-gray-800/60">
                    {% for raid in upcomingRaids %}
                        {{ _self.raid_row(raid, userGuildIds, 'before') }}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {# ── Commencés ── #}
        {% if startedRaids is not empty %}
            <div class="{{ ui.card_classes('overflow-hidden mb-6') }}" data-reveal>
                <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                    <h2 class="font-semibold text-green-400 flex items-center gap-2">⚔ Commencés</h2>
                    <span class="text-xs text-gray-500">{{ startedRaids|length }} raid{{ startedRaids|length > 1 ? 's' : '' }}</span>
                </div>
                <ul class="divide-y divide-gray-800/60">
                    {% for raid in startedRaids %}
                        {{ _self.raid_row(raid, userGuildIds, 'after') }}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {# ── En cours (sans date) ── #}
        {% if ongoingRaids is not empty %}
            <div class="{{ ui.card_classes('overflow-hidden') }}" data-reveal>
                <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                    <h2 class="font-semibold text-indigo-400 flex items-center gap-2">En cours</h2>
                    <span class="text-xs text-gray-500">{{ ongoingRaids|length }} raid{{ ongoingRaids|length > 1 ? 's' : '' }}</span>
                </div>
                <ul class="divide-y divide-gray-800/60">
                    {% for raid in ongoingRaids %}
                        {{ _self.raid_row(raid, userGuildIds, null) }}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

    {% endif %}
</div>

<script>
(function () {
    // ── Filtres auto-submit ──
    var form = document.getElementById('raid-filters');
    if (form) {
        form.querySelectorAll('input').forEach(function (input) {
            input.addEventListener('change', function () {
                // Soumet en nettoyant les paramètres vides (server="")
                var data     = new FormData(form);
                var url      = new URL(window.location.pathname, window.location.origin);
                data.forEach(function (value, key) {
                    if (value !== '') url.searchParams.set(key, value);
                });
                window.location.href = url.toString();
            });
        });
    }

    // Countdown géré par le controller Stimulus 'countdown'
})();
</script>
{% endblock %}
