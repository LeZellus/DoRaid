{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Raids – DoRaid{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-6 py-12">

    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-bold text-white">Raids</h1>
    </div>

    {# ── Filtre par serveur ── #}
    <div class="flex items-center gap-2 flex-wrap mb-8">
        <a href="{{ path('app_raid_index') }}"
           class="px-4 py-1.5 rounded-full text-sm font-medium transition border
                  {{ not currentServer ? 'bg-indigo-600 border-indigo-500 text-white' : 'border-gray-700 text-gray-400 hover:text-white hover:border-gray-500' }}">
            Tous
        </a>
        {% for server in servers %}
            <a href="{{ path('app_raid_index', {server: server.name}) }}"
               class="px-4 py-1.5 rounded-full text-sm font-medium transition border
                      {{ currentServer == server.name ? 'bg-indigo-600 border-indigo-500 text-white' : 'border-gray-700 text-gray-400 hover:text-white hover:border-gray-500' }}">
                {{ server.name }}
            </a>
        {% endfor %}
    </div>

    {% if upcomingRaids is empty and startedRaids is empty and ongoingRaids is empty %}
        <div class="{{ ui.card_classes('p-12 text-center') }}">
            <p class="text-gray-400 text-lg">Aucun raid disponible{% if currentServer %} sur {{ currentServer }}{% endif %}.</p>
        </div>
    {% else %}

        {# ── Macro ligne raid ── #}
        {# mode: 'before' = À venir, 'after' = Commencés, null = En cours #}
        {% macro raid_row(raid, userGuildIds, mode) %}
            {% import 'components/_ui.html.twig' as ui %}
            {% set isMyGuild = raid.guild.id in userGuildIds %}
            {% set isFull    = raid.isFull() %}
            {% set hasDate   = raid.scheduledAt is not null %}
            {% set isFuture  = hasDate and raid.scheduledAt > date() %}

            <li>
                {# ── Bandeau countdown ── #}
                {% if mode == 'before' and isFuture %}
                    <div class="flex items-center gap-2 px-6 py-1.5 bg-yellow-950/50 border-b border-yellow-900/40 text-xs font-medium text-yellow-400"
                         data-countdown="{{ raid.scheduledAt|date('U') }}"
                         data-mode="before">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                        </svg>
                        <span class="countdown-text">…</span>
                    </div>
                {% endif %}
                {% if mode == 'after' and hasDate and not isFuture %}
                    <div class="flex items-center gap-2 px-6 py-1.5 bg-green-950/40 border-b border-green-900/30 text-xs font-medium text-green-400"
                         data-countdown="{{ raid.scheduledAt|date('U') }}"
                         data-mode="after">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        <span class="countdown-text">…</span>
                    </div>
                {% endif %}

                {# ── Ligne principale ── #}
                <a href="{{ path('app_raid_show', {id: raid.id}) }}"
                   class="flex items-center gap-4 px-6 py-4 transition group hover:bg-gray-800/30
                          {{ isFull ? 'opacity-60' : '' }}">

                    {% if raid.raidTemplate.imagePath %}
                        <img src="{{ asset('uploads/raid-templates/' ~ raid.raidTemplate.imagePath) }}"
                             alt="{{ raid.raidTemplate.name }}"
                             class="w-11 h-11 rounded-xl object-cover shrink-0">
                    {% else %}
                        <span class="w-11 h-11 rounded-xl bg-indigo-900/40 border border-indigo-800/30 flex items-center justify-center text-xl shrink-0">⚔</span>
                    {% endif %}

                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-semibold text-white group-hover:text-indigo-300 transition truncate">
                                {{ raid.raidTemplate.name }}
                            </span>
                            {% if isFull %}
                                <span class="text-xs font-medium bg-red-900/50 text-red-400 border border-red-800/40 rounded-full px-2 py-0.5 shrink-0">Complet</span>
                            {% endif %}
                            {% if isMyGuild %}
                                <span class="text-xs font-medium bg-indigo-900/50 text-indigo-300 border border-indigo-700/40 rounded-full px-2 py-0.5 shrink-0">Ma guilde</span>
                            {% endif %}
                            {% if not raid.public %}
                                <span class="text-xs font-medium bg-gray-800 text-gray-500 border border-gray-700/40 rounded-full px-2 py-0.5 shrink-0">🔒 Privé</span>
                            {% endif %}
                        </div>
                        <div class="flex items-center gap-2 text-xs text-gray-500 mt-0.5 flex-wrap">
                            {% if raid.guild.imagePath %}
                                <img src="{{ asset('uploads/guildes/' ~ raid.guild.slug ~ '/' ~ raid.guild.imagePath) }}"
                                     alt="{{ raid.guild.name }}"
                                     class="w-4 h-4 rounded object-cover">
                            {% endif %}
                            <span>{{ raid.guild.name }}</span>
                            <span class="text-gray-700">·</span>
                            <span>{{ raid.guild.server.name }}</span>
                            {% if hasDate %}
                                <span class="text-gray-700">·</span>
                                <span class="text-gray-400">{{ raid.scheduledAt|date('d/m à H:i') }}</span>
                            {% endif %}
                            <span class="text-gray-700">·</span>
                            <span>par {{ raid.creator.name }}</span>
                        </div>
                    </div>

                    <div class="text-right shrink-0">
                        <div class="text-sm font-medium {{ isFull ? 'text-red-400' : 'text-indigo-400' }}">
                            {{ raid.acceptedParticipants|length }}<span class="text-gray-600 font-normal">/{{ raid.raidTemplate.maxParticipants }}</span>
                        </div>
                        <div class="text-xs text-gray-600 mt-0.5">joueurs</div>
                    </div>

                </a>
            </li>
        {% endmacro %}

        {# ── À venir ── #}
        {% if upcomingRaids is not empty %}
            <div class="{{ ui.card_classes('overflow-hidden mb-6') }}">
                <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                    <h2 class="font-semibold text-white flex items-center gap-2">🕐 À venir</h2>
                    <span class="text-xs text-gray-500">{{ upcomingRaids|length }} raid{{ upcomingRaids|length > 1 ? 's' : '' }}</span>
                </div>
                <ul class="divide-y divide-gray-800/60">
                    {% for raid in upcomingRaids %}
                        {{ _self.raid_row(raid, userGuildIds, 'before') }}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {# ── Commencés ── #}
        {% if startedRaids is not empty %}
            <div class="{{ ui.card_classes('overflow-hidden mb-6') }}">
                <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                    <h2 class="font-semibold text-green-400 flex items-center gap-2">⚔ Commencés</h2>
                    <span class="text-xs text-gray-500">{{ startedRaids|length }} raid{{ startedRaids|length > 1 ? 's' : '' }}</span>
                </div>
                <ul class="divide-y divide-gray-800/60">
                    {% for raid in startedRaids %}
                        {{ _self.raid_row(raid, userGuildIds, 'after') }}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {# ── En cours (sans date) ── #}
        {% if ongoingRaids is not empty %}
            <div class="{{ ui.card_classes('overflow-hidden') }}">
                <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                    <h2 class="font-semibold text-indigo-400 flex items-center gap-2">En cours</h2>
                    <span class="text-xs text-gray-500">{{ ongoingRaids|length }} raid{{ ongoingRaids|length > 1 ? 's' : '' }}</span>
                </div>
                <ul class="divide-y divide-gray-800/60">
                    {% for raid in ongoingRaids %}
                        {{ _self.raid_row(raid, userGuildIds, null) }}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

    {% endif %}
</div>

<script>
(function () {
    function pad(n) { return String(n).padStart(2, '0'); }

    function formatBefore(sec) {
        if (sec <= 0) return 'Le raid vient de commencer !';
        var d = Math.floor(sec / 86400);
        var h = Math.floor((sec % 86400) / 3600);
        var m = Math.floor((sec % 3600) / 60);
        var s = sec % 60;
        var parts = [];
        if (d > 0) parts.push(d + ' jour' + (d > 1 ? 's' : ''));
        if (h > 0) parts.push(h + 'h');
        parts.push(pad(m) + 'min');
        parts.push(pad(s) + 's');
        return 'Le raid commence dans ' + parts.join(' ');
    }

    function formatAfter(elapsed) {
        var h = Math.floor(elapsed / 3600);
        var m = Math.floor((elapsed % 3600) / 60);
        if (h > 0 && m > 0) return 'Le raid a commencé il y a ' + h + 'h ' + m + 'min';
        if (h > 0)           return 'Le raid a commencé il y a ' + h + ' heure' + (h > 1 ? 's' : '');
        if (m > 0)           return 'Le raid a commencé il y a ' + m + ' minute' + (m > 1 ? 's' : '');
        return 'Le raid vient de commencer';
    }

    function tick() {
        var now = Math.floor(Date.now() / 1000);
        document.querySelectorAll('[data-countdown]').forEach(function (el) {
            var target  = parseInt(el.dataset.countdown, 10);
            var mode    = el.dataset.mode;
            var diff    = target - now;
            var textEl  = el.querySelector('.countdown-text');
            if (!textEl) return;
            if (mode === 'before') {
                textEl.textContent = formatBefore(diff);
            } else if (mode === 'after') {
                textEl.textContent = formatAfter(-diff);
            }
        });
    }

    tick();
    setInterval(tick, 1000);
})();
</script>
{% endblock %}
