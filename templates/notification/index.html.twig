{% extends 'base.html.twig' %}

{% block title %}Notifications – Zeminal{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-6 py-10">

    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-white">Notifications</h1>
        {% if notifications is not empty or page > 1 %}
            <form method="post" action="{{ path('app_notifications_clear') }}"
                  onsubmit="return confirm('Supprimer toutes les notifications ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('clear_notifications') }}">
                <button type="submit" class="text-xs text-gray-500 hover:text-red-400 transition">Tout supprimer</button>
            </form>
        {% endif %}
    </div>

    {% if page == 1 and notifications is empty %}
        <div class="text-center py-16 text-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 opacity-40" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-2.83-2h5.66A3 3 0 0110 18z"/>
            </svg>
            <p class="text-sm">Aucune notification pour le moment</p>
        </div>
    {% else %}

        <div class="overflow-y-auto pr-1" style="max-height: calc(100vh - 11rem)">

            {% if page == 1 %}

                <div class="space-y-2">
                    {% for n in notifications %}
                        {% include 'notification/_card.html.twig' %}
                    {% endfor %}
                </div>

                {% if hasMore %}
                    <turbo-frame id="load-more-{{ nextPage }}" class="block">
                        <div class="py-4 text-center border-t border-gray-800/60 mt-2">
                            <a href="{{ path('app_notifications', {page: nextPage}) }}"
                               class="text-sm text-gray-500 hover:text-emerald-400 transition">Charger plus</a>
                        </div>
                    </turbo-frame>
                {% endif %}

            {% else %}

                {# Contenu injecté par Turbo dans le frame load-more-{{ page }} #}
                <turbo-frame id="load-more-{{ page }}" class="block">
                    <div class="space-y-2 mt-2">
                        {% for n in notifications %}
                            {% include 'notification/_card.html.twig' %}
                        {% endfor %}
                    </div>

                    {% if hasMore %}
                        <turbo-frame id="load-more-{{ nextPage }}" class="block">
                            <div class="py-4 text-center border-t border-gray-800/60 mt-2">
                                <a href="{{ path('app_notifications', {page: nextPage}) }}"
                                   class="text-sm text-gray-500 hover:text-emerald-400 transition">Charger plus</a>
                            </div>
                        </turbo-frame>
                    {% endif %}
                </turbo-frame>

            {% endif %}

        </div>

    {% endif %}

</div>
{% endblock %}
