{% import 'components/_ui.html.twig' as ui %}

{% if n.type == 'participation_pending' %}
    {% set icon = '⚔' %}
    {% set iconCls = 'bg-yellow-950/60 border-yellow-700/50 text-yellow-400' %}
    {% set accentCls = 'border-l-yellow-500' %}
{% elseif n.type in ['participation_accepted', 'membership_approved'] %}
    {% set icon = '✓' %}
    {% set iconCls = 'bg-emerald-950/60 border-emerald-700/50 text-emerald-400' %}
    {% set accentCls = 'border-l-emerald-500' %}
{% elseif n.type in ['participation_kicked', 'membership_rejected'] %}
    {% set icon = '✕' %}
    {% set iconCls = 'bg-red-950/60 border-red-700/50 text-red-400' %}
    {% set accentCls = 'border-l-red-500' %}
{% elseif n.type == 'membership_pending' %}
    {% set icon = '🛡' %}
    {% set iconCls = 'bg-yellow-950/60 border-yellow-700/50 text-yellow-400' %}
    {% set accentCls = 'border-l-yellow-500' %}
{% elseif n.type == 'guildatons_reminder' %}
    {% set icon = '💰' %}
    {% set iconCls = 'bg-amber-950/60 border-amber-700/50 text-amber-400' %}
    {% set accentCls = 'border-l-amber-500' %}
{% else %}
    {% set icon = '🔔' %}
    {% set iconCls = 'bg-emerald-950/60 border-emerald-700/50 text-emerald-400' %}
    {% set accentCls = 'border-l-emerald-500' %}
{% endif %}

{% if not n.isRead() %}
    <div class="flex items-start gap-4 bg-gray-800/80 border border-gray-700/60 border-l-4 {{ accentCls }} rounded-xl px-5 py-4 group/card">
        <span class="w-10 h-10 rounded-lg border {{ iconCls }} flex items-center justify-center font-bold text-base shrink-0">{{ icon }}</span>
        {% if n.link %}
            <a href="{{ n.link }}" class="flex-1 min-w-0 group/link">
                <div class="font-semibold text-white text-sm group-hover/link:text-emerald-300 transition">{{ n.title }}</div>
                <div class="text-xs text-gray-300 mt-0.5">{{ n.message }}</div>
                <div class="text-xs text-gray-500 mt-1">{{ n.createdAt|date('d/m/Y à H:i') }}</div>
            </a>
            <span class="text-gray-500 group-hover/link:text-emerald-400 transition shrink-0 text-sm self-center mr-2">→</span>
        {% else %}
            <div class="flex-1 min-w-0">
                <div class="font-semibold text-white text-sm">{{ n.title }}</div>
                <div class="text-xs text-gray-300 mt-0.5">{{ n.message }}</div>
                <div class="text-xs text-gray-500 mt-1">{{ n.createdAt|date('d/m/Y à H:i') }}</div>
            </div>
        {% endif %}
        <form method="post" action="{{ path('app_notification_delete', {id: n.id}) }}" class="shrink-0 self-center">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_notif_' ~ n.id) }}">
            <button type="submit" title="Supprimer" class="opacity-0 group-hover/card:opacity-100 transition text-gray-600 hover:text-red-400 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
            </button>
        </form>
    </div>
{% else %}
    <div class="flex items-start gap-4 bg-gray-900/40 border border-gray-800/40 rounded-xl px-5 py-4 group/card opacity-50 hover:opacity-100 transition-opacity duration-200">
        <span class="w-9 h-9 rounded-lg border {{ iconCls }} flex items-center justify-center font-bold shrink-0">{{ icon }}</span>
        {% if n.link %}
            <a href="{{ n.link }}" class="flex-1 min-w-0 group/link">
                <div class="font-medium text-gray-300 text-sm group-hover/link:text-emerald-300 transition">{{ n.title }}</div>
                <div class="text-xs text-gray-500 mt-0.5">{{ n.message }}</div>
                <div class="text-xs text-gray-600 mt-1">{{ n.createdAt|date('d/m/Y à H:i') }}</div>
            </a>
            <span class="text-gray-700 group-hover/link:text-emerald-400 transition shrink-0 text-sm self-center mr-2">→</span>
        {% else %}
            <div class="flex-1 min-w-0">
                <div class="font-medium text-gray-300 text-sm">{{ n.title }}</div>
                <div class="text-xs text-gray-500 mt-0.5">{{ n.message }}</div>
                <div class="text-xs text-gray-600 mt-1">{{ n.createdAt|date('d/m/Y à H:i') }}</div>
            </div>
        {% endif %}
        <form method="post" action="{{ path('app_notification_delete', {id: n.id}) }}" class="shrink-0 self-center">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_notif_' ~ n.id) }}">
            <button type="submit" title="Supprimer" class="opacity-0 group-hover/card:opacity-100 transition text-gray-600 hover:text-red-400 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
            </button>
        </form>
    </div>
{% endif %}
