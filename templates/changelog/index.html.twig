{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Mises à jour – Zeminal{% endblock %}
{% block meta_description %}Historique des nouveautés, améliorations et corrections de Zeminal, l'outil de gestion de raids pour guildes Dofus.{% endblock %}
{% block og_image %}{{ canonical_url }}{{ asset('og/changelog.png') }}{{ og_image_version('og/changelog.png') }}{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-6 py-12">

    <div class="mb-10">
        <h1 class="text-3xl font-bold text-white mb-2">Mises à jour</h1>
        <p class="text-gray-500 text-sm">Historique des nouveautés, améliorations et corrections de Zeminal.</p>
    </div>

    <div class="relative">

        {# Ligne verticale de la timeline #}
        <div class="absolute left-[7px] top-2 bottom-2 w-px bg-gray-800" aria-hidden="true"></div>

        <div class="space-y-10">
            {% for entry in entries %}
                <div class="relative pl-8">

                    {# Pastille timeline #}
                    <div class="absolute left-0 top-1.5 w-3.5 h-3.5 rounded-full border-2 flex-shrink-0
                                {{ entry.latest
                                    ? 'bg-emerald-500 border-emerald-400 ring-4 ring-emerald-500/20'
                                    : 'bg-gray-800 border-gray-600' }}">
                    </div>

                    {# Carte #}
                    <div class="{{ ui.card_classes('overflow-hidden') }} {{ entry.latest ? 'border-emerald-800/40' : '' }}">

                        {# Header #}
                        <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                            <div class="flex items-center gap-3">
                                <span class="font-bold text-white text-base">v{{ entry.version }}</span>
                                {% if entry.latest %}
                                    <span class="text-xs font-semibold bg-emerald-600/20 text-emerald-300 border border-emerald-700/40 rounded-full px-2.5 py-0.5">
                                        Dernière version
                                    </span>
                                {% endif %}
                            </div>
                            <span class="text-xs text-gray-500">{{ entry.date }}</span>
                        </div>

                        {# Changements #}
                        <ul class="{{ ui.card_body_classes('space-y-2') }}">
                            {% for change in entry.changes %}
                                <li class="grid items-baseline gap-3 text-sm" style="grid-template-columns: 7.5rem 1fr">

                                    {% if change.type == 'new' %}
                                        <span class="inline-flex justify-center text-[10px] font-bold uppercase tracking-wider bg-emerald-900/40 text-emerald-400 border border-emerald-800/40 rounded px-1.5 py-0.5 leading-none w-full">
                                            Nouveau
                                        </span>
                                    {% elseif change.type == 'fix' %}
                                        <span class="inline-flex justify-center text-[10px] font-bold uppercase tracking-wider bg-red-900/30 text-red-400 border border-red-800/40 rounded px-1.5 py-0.5 leading-none w-full">
                                            Correction
                                        </span>
                                    {% else %}
                                        <span class="inline-flex justify-center text-[10px] font-bold uppercase tracking-wider bg-emerald-900/30 text-emerald-400 border border-emerald-800/40 rounded px-1.5 py-0.5 leading-none w-full">
                                            Amélioration
                                        </span>
                                    {% endif %}

                                    <span class="text-gray-300 leading-snug">{{ change.text }}</span>
                                </li>
                            {% endfor %}
                        </ul>

                    </div>
                </div>
            {% endfor %}
        </div>

    </div>

    {# CTA feedback #}
    {% if app.user %}
        <div class="mt-12 text-center">
            <p class="text-sm text-gray-500 mb-3">Une idée ou un bug à signaler ?</p>
            <button type="button" onclick="document.getElementById('feedback-dialog').showModal()"
                    class="inline-flex items-center gap-2 text-sm font-medium text-emerald-400 hover:text-emerald-300 border border-emerald-800/50 hover:border-emerald-700/60 bg-emerald-950/30 hover:bg-emerald-950/50 rounded-xl px-4 py-2.5 transition cursor-pointer">
                🐛 Signaler / Suggérer
            </button>
        </div>
    {% endif %}

</div>
{% endblock %}
