{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Taux de drop — {{ mob.name }}{% endblock %}

{% block main %}

{% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
{% endfor %}

<p class="text-muted">
    Probabilité de drop (en %) de chaque gemme pour <strong>{{ mob.name }}</strong>
    ({{ mob.raidTemplate.name }}). Espérance de points actuelle : <strong>{{ mob.expectedPoints|number_format(2) }}</strong>.
</p>

<form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('mob_drop_rates_' ~ mob.id) }}">

    <div class="row g-3 mt-1">
        {% for gem in gems %}
            <div class="col-md-3 col-sm-4 col-6">
                <label class="form-label" for="gem_{{ gem.id }}">{{ gem.name }} <span class="text-muted">({{ gem.value }} pts)</span></label>
                <div class="input-group">
                    <input type="number" step="0.001" min="0" max="100" class="form-control"
                           id="gem_{{ gem.id }}" name="gem_{{ gem.id }}"
                           value="{{ ((probabilityByGemId[gem.id] ?? 0) * 100)|round(3) }}">
                    <span class="input-group-text">%</span>
                </div>
            </div>
        {% endfor %}
    </div>

    <button type="submit" class="btn btn-primary mt-4">Enregistrer</button>
    <a href="{{ ea_url().setController('App\\Controller\\Admin\\MobCrudController').setAction('index') }}" class="btn btn-link mt-4">Retour aux mobs</a>
</form>

{% endblock %}
