{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Mobs — {{ composition }}{% endblock %}

{% block main %}

{% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
{% endfor %}

<p class="text-muted">
    Quantité de chaque mob dans <strong>{{ composition }}</strong> ({{ composition.salle.raidTemplate.name }}).
    Laisser à 0 pour retirer un mob de la composition. Score espéré actuel : <strong>{{ composition.expectedScore|number_format(2) }}</strong> pts/joueur.
</p>

<form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('composition_mobs_' ~ composition.id) }}">

    <div class="row g-3 mt-1">
        {% for mob in mobs %}
            <div class="col-md-3 col-sm-4 col-6">
                <label class="form-label" for="mob_{{ mob.id }}">{{ mob.name }} <span class="text-muted">({{ mob.expectedPoints|number_format(2) }} pts)</span></label>
                <input type="number" step="1" min="0" class="form-control"
                       id="mob_{{ mob.id }}" name="mob_{{ mob.id }}"
                       value="{{ quantityByMobId[mob.id] ?? 0 }}">
            </div>
        {% endfor %}
    </div>

    <button type="submit" class="btn btn-primary mt-4">Enregistrer</button>
    <a href="{{ ea_url().setController('App\\Controller\\Admin\\SalleCompositionCrudController').setAction('index') }}" class="btn btn-link mt-4">Retour aux compositions</a>
</form>

{% endblock %}
