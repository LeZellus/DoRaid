{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Modifier {{ character.name }} – Zeminal{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-6 py-10">

    <a href="{{ path('app_character_index') }}"
       class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-300 transition mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        Mes personnages
    </a>

    {# ── Hero ── #}
    <div class="rounded-2xl bg-gradient-to-br from-emerald-950/60 via-gray-900 to-gray-950 border border-emerald-900/30 px-8 py-6 mb-8">
        <div class="flex items-center gap-5">
            <img src="{{ asset('classes/' ~ character.gameClass.name|lower ~ '.png') }}"
                 alt="{{ character.gameClass.name }}"
                 class="w-16 h-16 rounded-2xl object-cover border border-emerald-800/30 shrink-0">
            <div>
                <p class="text-xs font-semibold text-emerald-400 uppercase tracking-widest mb-1">Modifier le personnage</p>
                <h1 class="text-2xl font-bold text-white leading-tight">{{ character.name }}</h1>
                <p class="text-sm text-gray-500 mt-1">{{ character.gameClass.name }} · {{ character.server.name }}</p>
            </div>
        </div>
    </div>

    {{ form_start(form, {attr: {class: 'space-y-4'}}) }}

        {# ── Identité ── #}
        <div class="{{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes() }}">
                <h2 class="text-sm font-semibold text-white">Identité</h2>
                <p class="text-xs text-gray-500 mt-0.5">Nom et niveau de votre personnage en jeu</p>
            </div>
            <div class="{{ ui.card_body_classes('space-y-4') }}">
                {{ form_row(form.name) }}
                {{ form_row(form.gameClass) }}
                {{ form_row(form.server) }}
                {{ form_row(form.level) }}
            </div>
        </div>

        {# ── Optimisation ── #}
        <div class="{{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes() }}">
                <h2 class="text-sm font-semibold text-white">Niveau d'optimisation</h2>
                <p class="text-xs text-gray-500 mt-0.5">Reflète votre équipement et préparation au contenu haut niveau</p>
            </div>
            <div class="{{ ui.card_body_classes() }}">
                {{ form_row(form.optimizationLevel) }}
            </div>
        </div>

        {# ── Guildatons ── #}
        <div class="{{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes('flex items-center gap-3') }}">
                <img src="{{ asset('uploads/divers/guildatons.png') }}" alt="Guildatons" class="w-5 h-5 object-contain shrink-0">
                <div>
                    <h2 class="text-sm font-semibold text-white">Guildatons</h2>
                    <p class="text-xs text-gray-500 mt-0.5">Indiquez votre nombre de guildatons actuels</p>
                </div>
            </div>
            <div class="{{ ui.card_body_classes() }}">
                {{ form_row(form.guildatons) }}
            </div>
        </div>

        {# ── Initiative ── #}
        <div class="{{ ui.card_classes('overflow-hidden') }}">
            <div class="{{ ui.card_header_classes('flex items-center gap-3') }}">
                <img src="{{ asset('uploads/divers/initiative.png') }}" alt="Initiative" class="w-5 h-5 object-contain shrink-0">
                <div>
                    <h2 class="text-sm font-semibold text-white">Initiative</h2>
                    <p class="text-xs text-gray-500 mt-0.5">Il s'agit de l'initiative de votre stuff, utilisée pour le Gigalodon</p>
                </div>
            </div>
            <div class="{{ ui.card_body_classes() }}">
                {{ form_row(form.initiative) }}
            </div>
        </div>

        {# ── Actions ── #}
        <div class="flex items-center gap-3 pt-2">
            {{ ui.button('Enregistrer', 'primary', 'submit', 'flex-1') }}
            {{ ui.link_button('Annuler', path('app_character_index'), 'secondary', 'flex-1') }}
        </div>

    {{ form_end(form) }}

</div>
{% endblock %}
