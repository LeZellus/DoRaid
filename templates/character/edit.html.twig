{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Modifier {{ character.name }} – DoRaid{% endblock %}

{% block body %}
<div class="flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">

        <div class="flex items-center gap-4 mb-8">
            <a href="{{ path('app_character_index') }}" class="text-gray-500 hover:text-white transition">← Retour</a>
            <h1 class="text-3xl font-bold text-white">Modifier {{ character.name }}</h1>
        </div>

        <div class="mb-6 bg-gray-900 border border-gray-800 rounded-xl px-5 py-4 flex items-center gap-3">
            <img src="{{ asset('classes/' ~ character.gameClass.name|lower ~ '.png') }}"
                 alt="{{ character.gameClass.name }}"
                 class="w-10 h-10 rounded-full object-cover shrink-0">
            <div>
                <p class="text-white font-semibold">{{ character.name }}</p>
                <p class="text-xs text-gray-500">{{ character.gameClass.name }} · {{ character.server.name }}</p>
            </div>
        </div>

        {{ form_start(form, {attr: {class: 'space-y-5'}}) }}
            {{ form_row(form.name) }}
            {{ form_row(form.level) }}
            {{ form_row(form.optimizationLevel) }}
            {{ ui.button('Enregistrer', 'primary', 'submit', 'w-full mt-2') }}
        {{ form_end(form) }}

    </div>
</div>
{% endblock %}
