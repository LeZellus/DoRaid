{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Nouveau personnage – Zeminal{% endblock %}

{% block body %}
<div class="flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">

        {% for message in app.flashes('onboarding') %}
        <div class="mb-6 rounded-xl border border-emerald-500/30 bg-emerald-900/20 px-5 py-4 text-emerald-200 text-sm">
            <p class="font-semibold text-emerald-100 mb-1">Bienvenue sur Zeminal !</p>
            <p>{{ message }}</p>
        </div>
        {% endfor %}

        <div class="flex items-center gap-4 mb-8">
            <a href="{{ path('app_character_index') }}" class="text-gray-500 hover:text-white transition">← Retour</a>
            <h1 class="text-3xl font-bold text-white">Nouveau personnage</h1>
        </div>

        {{ form_start(form, {attr: {class: 'space-y-5'}}) }}
            {{ form_row(form.name) }}
            {{ form_row(form.gameClass) }}
            {{ form_row(form.server) }}
            {{ form_row(form.level) }}
            {{ form_row(form.optimizationLevel) }}
            {{ ui.button('Créer le personnage', 'primary', 'submit', 'w-full mt-2') }}
        {{ form_end(form) }}

    </div>
</div>
{% endblock %}
