{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Zeminal – Organisez vos raids Dofus en guilde{% endblock %}
{% block meta_description %}Zeminal est la plateforme de gestion de raids pour les guildes Dofus. Planifiez vos donjons et raids, gérez vos personnages et trouvez des groupes sur tous les serveurs.{% endblock %}

{% block javascripts %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "Comment organiser un raid sur Dofus avec Zeminal ?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Créez un compte, ajoutez votre personnage Dofus, puis rejoignez ou créez une guilde. Depuis la page de votre guilde, vous pouvez créer un raid en choisissant un template de donjon, une date et une composition. Vos membres reçoivent une notification et peuvent candidater directement."
            }
        },
        {
            "@type": "Question",
            "name": "Comment trouver un raid Dofus sur Zeminal ?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Rendez-vous sur la page Raids — tous les raids publics y sont listés, tous serveurs Dofus confondus. Vous pouvez filtrer par serveur ou par type de donjon pour trouver un groupe qui correspond à votre personnage."
            }
        },
        {
            "@type": "Question",
            "name": "Zeminal fonctionne-t-il sur tous les serveurs Dofus ?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Oui. Zeminal supporte tous les serveurs Dofus. Les raids publics sont visibles par tous les joueurs, quel que soit leur serveur. Idéal pour recruter des joueurs extérieurs à votre guilde."
            }
        },
        {
            "@type": "Question",
            "name": "Zeminal est-il gratuit ?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Oui, Zeminal est entièrement gratuit. Inscription, création de guilde, planification de raids — tout est accessible sans abonnement ni carte bancaire."
            }
        }
    ]
}
</script>
{% endblock %}

{% block body %}

