{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}DoRaid – Organisez vos raids en guilde{% endblock %}
{% block meta_description %}DoRaid est l'outil de gestion de raids pour guildes de MMO. Planifiez vos raids, gérez vos personnages et coordonnez votre guilde efficacement.{% endblock %}

{% block body %}

{# ── Page non connectée ── #}
{% if not app.user %}

{# Hero #}
<section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-950 via-gray-950 to-gray-950 pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(99,102,241,0.15)_0%,transparent_60%)] pointer-events-none"></div>
    <div class="relative max-w-5xl mx-auto px-6 py-24 lg:py-32 text-center">
        <div class="inline-flex items-center gap-2 bg-indigo-950/60 border border-indigo-800/40 rounded-full px-4 py-1.5 text-sm text-indigo-300 mb-8">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
            Gestion de raids pour guildes de MMO
        </div>
        <h1 class="text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight tracking-tight">
            Organisez vos raids.<br>
            <span class="text-indigo-400">Gérez votre guilde.</span>
        </h1>
        <p class="text-lg lg:text-xl text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed">
            DoRaid centralise la planification de vos raids, la gestion des candidatures et la coordination de vos membres en un seul endroit.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="{{ path('app_register') }}"
               class="w-full sm:w-auto bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-8 py-3.5 rounded-xl transition text-base shadow-lg shadow-indigo-900/40">
                Créer un compte gratuitement
            </a>
            <a href="{{ path('app_login') }}"
               class="w-full sm:w-auto border border-gray-700 hover:border-gray-500 text-gray-300 hover:text-white font-semibold px-8 py-3.5 rounded-xl transition text-base">
                Se connecter
            </a>
        </div>
    </div>
</section>

{# Features #}
<section class="max-w-5xl mx-auto px-6 py-16 lg:py-24">
    <div class="text-center mb-12">
        <h2 class="text-2xl lg:text-3xl font-bold text-white mb-3">Tout ce dont votre guilde a besoin</h2>
        <p class="text-gray-500 max-w-xl mx-auto">Une plateforme pensée pour les officiers et les membres, simple à prendre en main.</p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
        <div class="bg-gray-900/50 border border-gray-800/60 rounded-2xl p-6 hover:border-indigo-800/40 transition group">
            <div class="w-11 h-11 rounded-xl bg-indigo-950/80 border border-indigo-800/40 flex items-center justify-center text-xl mb-5 group-hover:bg-indigo-900/50 transition">
                ⚔
            </div>
            <h3 class="font-semibold text-white mb-2">Planification des raids</h3>
            <p class="text-sm text-gray-500 leading-relaxed">
                Créez des raids, définissez une date, une composition et gérez les candidatures de vos membres directement depuis l'interface.
            </p>
        </div>
        <div class="bg-gray-900/50 border border-gray-800/60 rounded-2xl p-6 hover:border-indigo-800/40 transition group">
            <div class="w-11 h-11 rounded-xl bg-indigo-950/80 border border-indigo-800/40 flex items-center justify-center text-xl mb-5 group-hover:bg-indigo-900/50 transition">
                🛡
            </div>
            <h3 class="font-semibold text-white mb-2">Gestion des guildes</h3>
            <p class="text-sm text-gray-500 leading-relaxed">
                Administrez votre guilde, approuvez les demandes de membres et suivez la composition de votre roster en temps réel.
            </p>
        </div>
        <div class="bg-gray-900/50 border border-gray-800/60 rounded-2xl p-6 hover:border-indigo-800/40 transition group">
            <div class="w-11 h-11 rounded-xl bg-indigo-950/80 border border-indigo-800/40 flex items-center justify-center text-xl mb-5 group-hover:bg-indigo-900/50 transition">
                🧙
            </div>
            <h3 class="font-semibold text-white mb-2">Profils de personnages</h3>
            <p class="text-sm text-gray-500 leading-relaxed">
                Enregistrez vos personnages avec leur classe et leur niveau. Candidatez aux raids avec le personnage de votre choix.
            </p>
        </div>
    </div>
</section>

{# How it works #}
<section class="border-t border-gray-800/60 bg-gray-900/20">
    <div class="max-w-5xl mx-auto px-6 py-16 lg:py-24">
        <div class="text-center mb-12">
            <h2 class="text-2xl lg:text-3xl font-bold text-white mb-3">Prêt en quelques minutes</h2>
            <p class="text-gray-500 max-w-xl mx-auto">Pas de configuration complexe — créez un compte et commencez à organiser.</p>
        </div>
        <div class="grid gap-8 md:grid-cols-3 relative">
            <div class="hidden md:block absolute top-5 left-1/3 right-1/3 h-px bg-gradient-to-r from-transparent via-indigo-800/30 to-transparent"></div>
            <div class="flex flex-col items-center text-center gap-3">
                <div class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center shrink-0 shadow-lg shadow-indigo-900/50">1</div>
                <h3 class="font-semibold text-white">Créez votre compte</h3>
                <p class="text-sm text-gray-500">Inscription rapide, sans carte bancaire. Connexion Discord disponible.</p>
            </div>
            <div class="flex flex-col items-center text-center gap-3">
                <div class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center shrink-0 shadow-lg shadow-indigo-900/50">2</div>
                <h3 class="font-semibold text-white">Rejoignez ou créez une guilde</h3>
                <p class="text-sm text-gray-500">Ajoutez vos personnages et intégrez la guilde de votre choix sur votre serveur.</p>
            </div>
            <div class="flex flex-col items-center text-center gap-3">
                <div class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center shrink-0 shadow-lg shadow-indigo-900/50">3</div>
                <h3 class="font-semibold text-white">Organisez vos raids</h3>
                <p class="text-sm text-gray-500">Planifiez, gérez les candidatures et partez à l'aventure avec votre guilde.</p>
            </div>
        </div>
    </div>
</section>

{# CTA final #}
<section class="max-w-5xl mx-auto px-6 py-16 lg:py-24 text-center">
    <div class="bg-gradient-to-br from-indigo-950/60 to-gray-900/60 border border-indigo-800/30 rounded-2xl p-10 lg:p-14">
        <h2 class="text-2xl lg:text-3xl font-bold text-white mb-3">Rejoignez DoRaid dès aujourd'hui</h2>
        <p class="text-gray-400 mb-8 max-w-md mx-auto">Gratuit, sans engagement. Votre guilde vous attend.</p>
        <a href="{{ path('app_register') }}"
           class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-10 py-3.5 rounded-xl transition text-base shadow-lg shadow-indigo-900/40">
            Créer un compte gratuitement
        </a>
        <div class="mt-6 text-sm text-gray-600">
            Déjà inscrit ?
            <a href="{{ path('app_login') }}" class="text-indigo-400 hover:text-indigo-300 transition">Se connecter</a>
        </div>
    </div>
</section>

{% else %}

{# ── Dashboard ── #}
<div class="max-w-6xl mx-auto px-6 py-10">

    {# ── Header ── #}
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-white">
                Bonjour, <span class="text-indigo-400">{{ app.user.username }}</span> 👋
            </h1>
            <p class="text-sm text-gray-500 mt-0.5">{{ "now"|date_fr }}</p>
        </div>
        {{ ui.link_button('Voir les guildes', path('app_guild_index'), 'secondary') }}
    </div>

    {# ── Notifications en attente ── #}
    {% if pendingByGuild is not empty or pendingByRaid is not empty %}
    <div class="mb-8 space-y-3">

        {% for item in pendingByGuild %}
        <a href="{{ path('app_guild_members', {slug: item.guild.slug}) }}"
           class="flex items-center gap-3 bg-yellow-900/10 border border-yellow-800/30 rounded-xl px-5 py-3.5 hover:bg-yellow-900/20 transition">
            <span class="text-yellow-400 text-lg shrink-0">👥</span>
            <p class="text-sm text-yellow-200 flex-1">
                <span class="font-semibold">{{ item.count }} demande{{ item.count > 1 ? 's' : '' }}</span>
                en attente dans la guilde <span class="font-semibold">{{ item.guild.name }}</span>
            </p>
            <span class="text-xs text-yellow-500 shrink-0">Voir →</span>
        </a>
        {% endfor %}

        {% for item in pendingByRaid %}
        <a href="{{ path('app_raid_show', {id: item.raid.id}) }}"
           class="flex items-center gap-3 bg-indigo-900/10 border border-indigo-800/30 rounded-xl px-5 py-3.5 hover:bg-indigo-900/20 transition">
            <span class="text-indigo-400 text-lg shrink-0">⚔</span>
            <p class="text-sm text-indigo-200 flex-1">
                <span class="font-semibold">{{ item.count }} candidature{{ item.count > 1 ? 's' : '' }}</span>
                en attente sur le raid <span class="font-semibold">{{ item.raid.raidTemplate.name }}</span>
                <span class="text-indigo-400/60">· {{ item.raid.guild.name }}</span>
            </p>
            <span class="text-xs text-indigo-500 shrink-0">Voir →</span>
        </a>
        {% endfor %}

    </div>
    {% endif %}

    {# ── Stats ── #}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="{{ ui.card_classes('p-5 text-center') }}">
            <div class="text-3xl font-bold text-indigo-400">{{ activeRaids|length }}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wider mt-1">Raid{{ activeRaids|length > 1 ? 's' : '' }} actif{{ activeRaids|length > 1 ? 's' : '' }}</div>
        </div>
        <div class="{{ ui.card_classes('p-5 text-center') }}">
            <div class="text-3xl font-bold text-green-400">{{ completedRaids|length }}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wider mt-1">Raid{{ completedRaids|length > 1 ? 's' : '' }} terminé{{ completedRaids|length > 1 ? 's' : '' }}</div>
        </div>
        <div class="{{ ui.card_classes('p-5 text-center') }}">
            <div class="text-3xl font-bold text-yellow-400">{{ pendingRaids|length }}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wider mt-1">Candidature{{ pendingRaids|length > 1 ? 's' : '' }} raid</div>
        </div>
        <div class="{{ ui.card_classes('p-5 text-center') }}">
            <div class="text-3xl font-bold text-white">{{ guildMap|length }}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wider mt-1">Guilde{{ guildMap|length > 1 ? 's' : '' }}</div>
        </div>
    </div>

    {# ── Grille principale ── #}
    <div class="grid gap-6 lg:grid-cols-2">

        {# ── Mes guildes ── #}
        <div class="space-y-4">
            <div class="{{ ui.card_classes('overflow-hidden') }}">
                <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                    <h2 class="font-semibold text-white">Mes guildes</h2>
                    {{ ui.link_button('+ Créer', path('app_guild_new'), 'secondary') }}
                </div>

                {% if guildMap is empty and pendingMemberships is empty %}
                    <div class="{{ ui.card_body_classes('py-8 text-center') }}">
                        <p class="text-gray-500 text-sm mb-4">Vous n'êtes encore dans aucune guilde.</p>
                        {{ ui.link_button('Rejoindre une guilde', path('app_guild_index'), 'primary') }}
                    </div>
                {% else %}
                    {% if guildMap is not empty %}
                        <ul class="divide-y divide-gray-800/60">
                            {% for item in guildMap %}
                                <li>
                                    <a href="{{ path('app_guild_show', {slug: item.guild.slug}) }}"
                                       class="flex items-center gap-4 px-5 py-3.5 hover:bg-gray-800/30 transition group {% if item.isLeader %}border-l-2 border-yellow-500/60{% endif %}">
                                        {% if item.guild.imagePath %}
                                            <img src="{{ asset('uploads/guildes/' ~ item.guild.slug ~ '/' ~ item.guild.imagePath) }}"
                                                 alt="{{ item.guild.name }}"
                                                 class="w-9 h-9 rounded-lg object-cover shrink-0">
                                        {% else %}
                                            <div class="w-9 h-9 rounded-lg bg-indigo-900/40 flex items-center justify-center text-sm font-bold text-indigo-300 shrink-0">
                                                {{ item.guild.name|slice(0,1)|upper }}
                                            </div>
                                        {% endif %}
                                        <div class="flex-1 min-w-0">
                                            <div class="font-medium text-sm truncate group-hover:text-indigo-300 transition {% if item.isLeader %}text-yellow-300{% else %}text-white{% endif %}">
                                                {{ item.guild.name }}
                                            </div>
                                            <div class="text-xs text-gray-500 mt-0.5">
                                                {{ item.guild.server.name }}
                                                {% if item.count > 1 %}
                                                    <span class="mx-0.5 text-gray-700">·</span>
                                                    {{ item.count }} personnages
                                                {% endif %}
                                            </div>
                                        </div>
                                        {% if item.isLeader %}
                                            <span class="text-xs font-medium bg-yellow-900/40 text-yellow-400 border border-yellow-800/40 rounded-full px-2 py-0.5 shrink-0">
                                                ⭐ Meneur
                                            </span>
                                        {% endif %}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if pendingMemberships is not empty %}
                        <div class="border-t border-gray-800/60 bg-yellow-900/5">
                            <div class="px-5 py-2.5">
                                <p class="text-xs font-semibold text-yellow-500 uppercase tracking-wider">
                                    En attente d'approbation ({{ pendingMemberships|length }})
                                </p>
                            </div>
                            <ul class="divide-y divide-gray-800/40">
                                {% for m in pendingMemberships %}
                                    <li class="flex items-center gap-4 px-5 py-3 opacity-70">
                                        {% if m.guild.imagePath %}
                                            <img src="{{ asset('uploads/guildes/' ~ m.guild.slug ~ '/' ~ m.guild.imagePath) }}"
                                                 alt="{{ m.guild.name }}"
                                                 class="w-9 h-9 rounded-lg object-cover shrink-0">
                                        {% else %}
                                            <div class="w-9 h-9 rounded-lg bg-gray-800 flex items-center justify-center text-sm font-bold text-gray-400 shrink-0">
                                                {{ m.guild.name|slice(0,1)|upper }}
                                            </div>
                                        {% endif %}
                                        <div class="flex-1 min-w-0">
                                            <div class="font-medium text-white text-sm truncate">{{ m.guild.name }}</div>
                                            <div class="flex items-center gap-1.5 text-xs text-gray-500 mt-0.5">
                                                <img src="{{ asset('classes/' ~ m.character.gameClass.name|lower ~ '.png') }}"
                                                     alt="{{ m.character.gameClass.name }}"
                                                     class="w-4 h-4 rounded-full object-cover shrink-0">
                                                {{ m.character.name }}
                                                <span class="mx-0.5 text-gray-700">·</span>
                                                {{ m.guild.server.name }}
                                            </div>
                                        </div>
                                        <span class="text-xs font-medium bg-yellow-900/40 text-yellow-500 border border-yellow-800/40 rounded-full px-2 py-0.5 shrink-0">
                                            En attente
                                        </span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        {# ── Mes raids ── #}
        <div class="space-y-4">

            {# Raids actifs #}
            <div class="{{ ui.card_classes('overflow-hidden') }}">
                <div class="{{ ui.card_header_classes() }}">
                    <h2 class="font-semibold text-white">Raids en cours</h2>
                </div>

                {% if activeRaids is empty %}
                    <div class="{{ ui.card_body_classes('py-8 text-center') }}">
                        <p class="text-gray-500 text-sm">Vous ne participez à aucun raid actif.</p>
                    </div>
                {% else %}
                    <ul class="divide-y divide-gray-800/60 overflow-y-auto" style="max-height: 20rem">
                        {% for p in activeRaids %}
                            <li>
                                <a href="{{ path('app_raid_show', {id: p.raid.id}) }}"
                                   class="flex items-center gap-4 px-5 py-3.5 hover:bg-gray-800/30 transition group">
                                    {% if p.raid.raidTemplate.imagePath %}
                                        <img src="{{ asset('uploads/raid-templates/' ~ p.raid.raidTemplate.imagePath) }}"
                                             alt="{{ p.raid.raidTemplate.name }}"
                                             class="w-9 h-9 rounded-lg object-cover shrink-0">
                                    {% else %}
                                        <span class="w-9 h-9 rounded-lg bg-indigo-900/40 flex items-center justify-center text-lg shrink-0">⚔</span>
                                    {% endif %}
                                    <div class="flex-1 min-w-0">
                                        <div class="font-medium text-white text-sm truncate group-hover:text-indigo-300 transition">
                                            {{ p.raid.raidTemplate.name }}
                                        </div>
                                        <div class="flex items-center gap-1.5 text-xs text-gray-500 mt-0.5">
                                            <img src="{{ asset('classes/' ~ p.character.gameClass.name|lower ~ '.png') }}"
                                                 alt="{{ p.character.gameClass.name }}"
                                                 class="w-4 h-4 rounded-full object-cover shrink-0">
                                            {{ p.character.name }}
                                            <span class="mx-0.5 text-gray-700">·</span>
                                            {{ p.raid.guild.name }}
                                            {% if p.raid.scheduledAt %}
                                                <span class="mx-0.5 text-gray-700">·</span>
                                                <span class="text-indigo-400">{{ p.raid.scheduledAt|date('d/m à H:i') }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="text-right shrink-0">
                                        <div class="text-xs text-gray-500">
                                            {{ p.raid.acceptedParticipants|length }}/{{ p.raid.raidTemplate.maxParticipants }}
                                        </div>
                                    </div>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            {# Candidatures raid en attente #}
            {% if pendingRaids is not empty %}
                <div class="{{ ui.card_classes('overflow-hidden') }}">
                    <div class="{{ ui.card_header_classes() }}">
                        <h2 class="font-semibold text-yellow-400">Candidatures en attente</h2>
                    </div>
                    <ul class="divide-y divide-gray-800/60 overflow-y-auto" style="max-height: 16rem">
                        {% for p in pendingRaids %}
                            <li>
                                <a href="{{ path('app_raid_show', {id: p.raid.id}) }}"
                                   class="flex items-center gap-4 px-5 py-3.5 hover:bg-gray-800/30 transition group opacity-80">
                                    {% if p.raid.raidTemplate.imagePath %}
                                        <img src="{{ asset('uploads/raid-templates/' ~ p.raid.raidTemplate.imagePath) }}"
                                             alt="{{ p.raid.raidTemplate.name }}"
                                             class="w-9 h-9 rounded-lg object-cover shrink-0">
                                    {% else %}
                                        <span class="w-9 h-9 rounded-lg bg-indigo-900/40 flex items-center justify-center text-lg shrink-0">⚔</span>
                                    {% endif %}
                                    <div class="flex-1 min-w-0">
                                        <div class="font-medium text-white text-sm truncate group-hover:text-yellow-300 transition">
                                            {{ p.raid.raidTemplate.name }}
                                        </div>
                                        <div class="flex items-center gap-1.5 text-xs text-gray-500 mt-0.5">
                                            <img src="{{ asset('classes/' ~ p.character.gameClass.name|lower ~ '.png') }}"
                                                 alt="{{ p.character.gameClass.name }}"
                                                 class="w-4 h-4 rounded-full object-cover shrink-0">
                                            {{ p.character.name }}
                                            <span class="mx-0.5 text-gray-700">·</span>
                                            {{ p.raid.guild.name }}
                                        </div>
                                    </div>
                                    <span class="text-xs font-medium bg-yellow-900/40 text-yellow-400 border border-yellow-800/40 rounded-full px-2 py-0.5 shrink-0">
                                        En attente
                                    </span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {# Raids terminés (5 derniers) #}
            {% if completedRaids is not empty %}
                <div class="{{ ui.card_classes('overflow-hidden') }}">
                    <div class="{{ ui.card_header_classes('flex items-center justify-between') }}">
                        <h2 class="font-semibold text-gray-400">Raids terminés</h2>
                        <span class="text-xs text-gray-600">{{ completedRaids|length }} au total</span>
                    </div>
                    <ul class="divide-y divide-gray-800/40 overflow-y-auto" style="max-height: 14rem">
                        {% for p in completedRaids|slice(0, 5) %}
                            <li class="flex items-center gap-4 px-5 py-3 opacity-60">
                                {% if p.raid.raidTemplate.imagePath %}
                                    <img src="{{ asset('uploads/raid-templates/' ~ p.raid.raidTemplate.imagePath) }}"
                                         alt="{{ p.raid.raidTemplate.name }}"
                                         class="w-9 h-9 rounded-lg object-cover shrink-0">
                                {% else %}
                                    <span class="w-9 h-9 rounded-lg bg-indigo-900/40 flex items-center justify-center text-lg shrink-0">⚔</span>
                                {% endif %}
                                <div class="flex-1 min-w-0">
                                    <div class="font-medium text-white text-sm truncate">
                                        {{ p.raid.raidTemplate.name }}
                                    </div>
                                    <div class="flex items-center gap-1.5 text-xs text-gray-600 mt-0.5">
                                        <img src="{{ asset('classes/' ~ p.character.gameClass.name|lower ~ '.png') }}"
                                             alt="{{ p.character.gameClass.name }}"
                                             class="w-4 h-4 rounded-full object-cover shrink-0">
                                        {{ p.character.name }}
                                        <span class="mx-0.5 text-gray-700">·</span>
                                        {{ p.raid.guild.name }}
                                        <span class="mx-0.5 text-gray-700">·</span>
                                        {{ p.raid.createdAt|date('d/m/Y') }}
                                    </div>
                                </div>
                                <span class="text-xs text-gray-600 shrink-0">Terminé</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

        </div>
    </div>

    {# ── Raids publics ── #}
    {% if publicRaids is defined and publicRaids is not empty %}
    <div class="mt-6 {{ ui.card_classes('overflow-hidden') }}">
        <div class="{{ ui.card_header_classes() }}">
            <h2 class="font-semibold text-white">🌐 Raids publics</h2>
        </div>
        <ul class="divide-y divide-gray-800/60 overflow-y-auto" style="max-height: 18rem">
            {% for raid in publicRaids %}
                <li>
                    <a href="{{ path('app_raid_show', {id: raid.id}) }}"
                       class="flex items-center gap-4 px-5 py-3.5 hover:bg-gray-800/30 transition group">
                        {% if raid.raidTemplate.imagePath %}
                            <img src="{{ asset('uploads/raid-templates/' ~ raid.raidTemplate.imagePath) }}"
                                 alt="{{ raid.raidTemplate.name }}"
                                 class="w-9 h-9 rounded-lg object-cover shrink-0">
                        {% else %}
                            <span class="w-9 h-9 rounded-lg bg-indigo-900/40 flex items-center justify-center text-lg shrink-0">⚔</span>
                        {% endif %}
                        <div class="flex-1 min-w-0">
                            <div class="font-medium text-white text-sm truncate group-hover:text-indigo-300 transition">
                                {{ raid.raidTemplate.name }}
                            </div>
                            <div class="text-xs text-gray-500 mt-0.5">
                                {{ raid.guild.name }}
                                <span class="mx-0.5 text-gray-700">·</span>
                                {{ raid.guild.server.name }}
                                {% if raid.scheduledAt %}
                                    <span class="mx-0.5 text-gray-700">·</span>
                                    <span class="text-indigo-400">{{ raid.scheduledAt|date('d/m à H:i') }}</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="text-xs text-gray-500 shrink-0">
                            {{ raid.acceptedParticipants|length }}/{{ raid.raidTemplate.maxParticipants }}
                        </div>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

</div>
{% endif %}

{% endblock %}
