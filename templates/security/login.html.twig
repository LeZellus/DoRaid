{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Connexion – Zeminal{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block body %}
<div class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 py-12">

    {# Gradient background #}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(99,102,241,0.12)_0%,transparent_60%)] pointer-events-none"></div>

    <div class="relative w-full max-w-md">

        {# Logo #}
        <div class="text-center mb-8">
            <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 group">
                <span class="text-indigo-400 text-2xl group-hover:text-indigo-300 transition">⚔</span>
                <span class="text-2xl font-bold text-white tracking-tight">Zeminal</span>
            </a>
            <p class="text-gray-500 text-sm mt-2">Bon retour parmi nous !</p>
        </div>

        {# Card #}
        <div class="bg-gray-900/80 border border-gray-800/60 rounded-2xl p-8 shadow-2xl backdrop-blur-sm">

            {% if error %}
                <div class="mb-6">
                    {{ ui.alert(error.messageKey|trans(error.messageData, 'security'), 'error') }}
                </div>
            {% endif %}

            {# Discord en premier #}
            {{ ui.discord_button('Continuer avec Discord', path('app_discord_connect')) }}

            {{ ui.divider('ou avec votre email') }}

            <form method="post" action="{{ path('app_login') }}" class="space-y-5">
                <div>
                    {{ ui.label('email', 'Email') }}
                    {{ ui.input('email', 'email', 'email', last_username, 'vous@exemple.com', '', {required: 'required', autofocus: 'autofocus'}) }}
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        {{ ui.label('password', 'Mot de passe') }}
                    </div>
                    {{ ui.input('password', 'password', 'password', '', '••••••••', '', {required: 'required', autocomplete: 'current-password'}) }}
                </div>

                {{ ui.checkbox('remember_me', '_remember_me', 'Se souvenir de moi') }}

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {{ ui.button('Se connecter', 'primary', 'submit', 'w-full py-3') }}
            </form>
        </div>

        <p class="text-center text-sm text-gray-500 mt-6">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="text-indigo-400 hover:text-indigo-300 font-medium transition">Créer un compte</a>
        </p>
    </div>
</div>
{% endblock %}
