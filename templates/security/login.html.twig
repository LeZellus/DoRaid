{% extends 'base.html.twig' %}

{% block title %}Connexion – DoRaid{% endblock %}

{% block body %}
<div class="flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
        <h1 class="text-3xl font-bold text-white text-center mb-8">Connexion</h1>

        {% if error %}
            <div class="bg-red-900 text-red-200 px-4 py-3 rounded-lg mb-6">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}" class="space-y-5">
            <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-1">Email</label>
                <input type="email" id="email" name="email" value="{{ last_username }}" required autofocus
                    class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder-gray-500"
                    placeholder="vous@exemple.com">
            </div>
            <div>
                <label for="password" class="block text-sm font-medium text-gray-300 mb-1">Mot de passe</label>
                <input type="password" id="password" name="password" required autocomplete="current-password"
                    class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder-gray-500"
                    placeholder="••••••••">
            </div>
            <div class="flex items-center">
                <input type="checkbox" id="remember_me" name="_remember_me" class="w-4 h-4 rounded border-gray-600 bg-gray-700 text-indigo-500">
                <label for="remember_me" class="ml-2 text-sm text-gray-400">Se souvenir de moi</label>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 rounded-xl transition">
                Se connecter
            </button>
        </form>

        <p class="text-center text-sm text-gray-500 mt-6">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="text-indigo-400 hover:text-indigo-300">Créer un compte</a>
        </p>
    </div>
</div>
{% endblock %}
