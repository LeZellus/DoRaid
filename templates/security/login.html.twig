{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Connexion – DoRaid{% endblock %}

{% block body %}
<div class="flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
        <h1 class="text-3xl font-bold text-white text-center mb-8">Connexion</h1>

        {% if error %}
            {{ ui.alert(error.messageKey|trans(error.messageData, 'security'), 'error') }}
            <div class="mb-6"></div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}" class="space-y-5">
            <div>
                {{ ui.label('email', 'Email') }}
                {{ ui.input('email', 'email', 'email', last_username, 'vous@exemple.com', '', {required: 'required', autofocus: 'autofocus'}) }}
            </div>
            <div>
                {{ ui.label('password', 'Mot de passe') }}
                {{ ui.input('password', 'password', 'password', '', '••••••••', '', {required: 'required', autocomplete: 'current-password'}) }}
            </div>

            {{ ui.checkbox('remember_me', '_remember_me', 'Se souvenir de moi') }}

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            {{ ui.button('Se connecter', 'primary', 'submit', 'w-full') }}
        </form>

        {{ ui.divider('ou') }}

        {{ ui.discord_button('Se connecter avec Discord', path('app_discord_connect')) }}

        <p class="text-center text-sm text-gray-500 mt-6">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="text-indigo-400 hover:text-indigo-300">Créer un compte</a>
        </p>
    </div>
</div>
{% endblock %}
