<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Zeminal – Organisez vos raids Dofus en guilde{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Zeminal est l'outil de gestion de raids pour guildes Dofus. Planifiez vos raids, gérez vos personnages et coordonnez votre guilde efficacement.{% endblock %}">
        <meta name="robots" content="{% block meta_robots %}index, follow{% endblock %}">
        <link rel="canonical" href="{{ canonical_url }}{{ app.request.pathInfo }}">

        {# Open Graph #}
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Zeminal">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
        <meta property="og:url" content="{{ canonical_url }}{{ app.request.pathInfo }}">
        <meta property="og:image" content="{% block og_image %}{{ canonical_url }}{{ asset('og/default.png') }}{% endblock %}">

        {# Twitter Card #}
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{% block twitter_title %}{{ block('title') }}{% endblock %}">
        <meta name="twitter:description" content="{% block twitter_description %}{{ block('meta_description') }}{% endblock %}">
        <meta name="twitter:image" content="{% block twitter_image %}{{ block('og_image') }}{% endblock %}">

        <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
        <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">

        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebApplication",
            "name": "Zeminal",
            "url": "https://zeminal.tech",
            "description": "Plateforme gratuite de gestion de raids pour les guildes Dofus. Planifiez vos raids, gérez les candidatures et recrutez sur tous les serveurs.",
            "applicationCategory": "GameApplication",
            "operatingSystem": "Web",
            "inLanguage": "fr",
            "offers": {
                "@type": "Offer",
                "price": "0",
                "priceCurrency": "EUR"
            },
            "publisher": {
                "@type": "Organization",
                "name": "Zeminal",
                "url": "https://zeminal.tech"
            }
        }
        </script>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-gray-950 text-gray-100 flex flex-col">

        {% import 'components/_ui.html.twig' as ui %}
        {% set route = app.request.attributes.get('_route', '') %}

        {# ── Navbar ── #}
        {% set _unread = app.user ? notification_unread_count() : 0 %}
        <nav class="sticky top-0 z-40 bg-gray-900/90 backdrop-blur-md border-b border-white/5" data-controller="navbar">
            <div class="max-w-6xl mx-auto px-6 h-16 flex items-center gap-6">

                {# Logo #}
                <a href="{{ path('app_home') }}" class="flex items-center gap-2 shrink-0 group">
                    <span class="text-indigo-400 text-xl group-hover:text-indigo-300 transition">⚔</span>
                    <span class="font-bold text-white text-lg tracking-tight">Zeminal</span>
                </a>

                {# Liens de navigation — desktop #}
                <div class="hidden lg:flex items-center gap-1">
                    {% if app.user %}
                        <a href="{{ path('app_home') }}" class="px-3 py-2 rounded-lg text-sm font-medium transition {{ route == 'app_home' ? 'text-white bg-gray-800' : 'text-gray-400 hover:text-white hover:bg-gray-800/60' }}">Dashboard</a>
                    {% endif %}
                    <a href="{{ path('app_guild_index') }}" class="px-3 py-2 rounded-lg text-sm font-medium transition {{ route starts with 'app_guild' ? 'text-white bg-gray-800' : 'text-gray-400 hover:text-white hover:bg-gray-800/60' }}">Les guildes</a>
                    <a href="{{ path('app_raid_guide_index') }}" class="px-3 py-2 rounded-lg text-sm font-medium transition {{ route starts with 'app_raid_template_guide' or route == 'app_raid_guide_index' ? 'text-white bg-gray-800' : 'text-gray-400 hover:text-white hover:bg-gray-800/60' }}">Encyclopédie</a>
                    <span class="relative inline-flex shrink-0">
                        {% if route starts with 'app_raid' and route != 'app_raid_template_guide' and route != 'app_raid_guide_index' %}
                            <a href="{{ path('app_raid_index') }}" class="inline-flex items-center h-9 px-3 rounded-xl text-sm font-semibold transition border border-yellow-400 text-yellow-300">Trouver un raid</a>
                        {% else %}
                            <a href="{{ path('app_raid_index') }}" class="inline-flex items-center h-9 px-3 rounded-xl text-sm font-semibold transition border border-yellow-500/80 text-yellow-400 hover:border-yellow-400 hover:text-yellow-300 hover:bg-yellow-400/10 nav-cta-pulse">Trouver un raid</a>
                        {% endif %}
                        <span class="absolute -top-2 -right-2 bg-gray-900 px-0.5 rounded-full text-yellow-400 text-xs leading-none select-none pointer-events-none nav-cta-star">✦</span>
                    </span>
                </div>

                {# Ko-fi — desktop #}
                <a href="https://ko-fi.com/zeminal" target="_blank" rel="noopener"
                   class="hidden lg:inline-flex items-center gap-1.5 text-xs font-medium text-amber-400 hover:text-amber-300 border border-amber-500/30 hover:border-amber-400/60 bg-amber-500/5 hover:bg-amber-500/10 rounded-xl h-9 px-3 transition ml-auto shrink-0">
                    ☕ Faire un don
                </a>

                {# Zone compte — desktop #}
                <div class="hidden lg:flex items-center gap-2">
                    {% if app.user %}
                        {# ── Cloche notifications ── #}
                        <a href="{{ path('app_notifications') }}"
                           data-controller="notification-poll"
                           data-notification-poll-url-value="{{ path('api_notifications_unread') }}"
                           class="relative flex items-center justify-center w-9 h-9 rounded-xl border border-gray-700/50 hover:border-gray-600 transition {{ _unread > 0 ? 'text-indigo-300 bg-indigo-900/20 bell-active' : 'text-gray-400 bg-gray-800/60 hover:text-white' }}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-2.83-2h5.66A3 3 0 0110 18z"/>
                            </svg>
                            <span data-notification-poll-target="badge"
                                  class="absolute -top-1.5 -right-1.5 min-w-[1.1rem] h-[1.1rem] bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center px-0.5 leading-none {{ _unread == 0 ? 'hidden' : '' }}">
                                {{ _unread > 9 ? '9+' : _unread }}
                            </span>
                        </a>

                        {# ── Avatar + dropdown ── #}
                        <div class="relative">
                            <button type="button" data-navbar-target="accountButton" data-action="click->navbar#toggleAccount"
                                    aria-haspopup="true" aria-expanded="false"
                                    class="w-9 h-9 rounded-xl bg-indigo-600 hover:bg-indigo-500 flex items-center justify-center text-sm font-bold text-white transition cursor-pointer">
                                {{ app.user.username|slice(0,1)|upper|default('?') }}
                            </button>

                            <div data-navbar-target="accountPanel"
                                 class="hidden absolute right-0 mt-2 w-56 bg-gray-800 border border-gray-700 rounded-xl shadow-2xl overflow-hidden z-50">
                                <div class="px-4 py-2.5 border-b border-gray-700">
                                    <p class="text-sm font-medium text-white">{{ app.user.username }}</p>
                                </div>
                                <a href="{{ path('app_character_index') }}"
                                   class="block px-4 py-2.5 text-sm text-gray-300 hover:bg-gray-700/60 hover:text-white transition">
                                    Personnages
                                </a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('admin_dashboard') }}"
                                       class="block px-4 py-2.5 text-sm text-yellow-400 hover:bg-yellow-900/20 transition">
                                        ⚙ Administration
                                    </a>
                                {% endif %}
                                <a href="{{ path('app_logout') }}"
                                   class="block px-4 py-2.5 text-sm text-red-400 hover:bg-red-900/20 hover:text-red-300 transition">
                                    Déconnexion
                                </a>
                            </div>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-sm text-gray-400 hover:text-white transition px-3 py-2 rounded-lg hover:bg-gray-800/60">Connexion</a>
                        <a href="{{ path('app_register') }}" class="text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg transition">Inscription</a>
                    {% endif %}
                </div>

                {# Bouton menu — mobile #}
                <button type="button" data-navbar-target="button" data-action="click->navbar#toggle"
                        aria-label="Ouvrir le menu" aria-expanded="false"
                        class="lg:hidden ml-auto relative flex items-center justify-center w-9 h-9 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800/60 transition">
                    {% if _unread > 0 %}
                        <span class="absolute top-1 right-1 w-2 h-2 rounded-full bg-indigo-500 ring-2 ring-gray-900"></span>
                    {% endif %}
                    <svg data-navbar-target="openIcon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
                    </svg>
                    <svg data-navbar-target="closeIcon" xmlns="http://www.w3.org/2000/svg" class="hidden w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.293 5.293a1 1 0 011.414 0L10 8.586l3.293-3.293a1 1 0 111.414 1.414L11.414 10l3.293 3.293a1 1 0 01-1.414 1.414L10 11.414l-3.293 3.293a1 1 0 01-1.414-1.414L8.586 10 5.293 6.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                </button>
            </div>

            {# Menu déroulant — mobile #}
            <div data-navbar-target="panel" class="hidden lg:hidden border-t border-white/5 bg-gray-900/95">
                <div class="max-w-6xl mx-auto px-6 py-3 flex flex-col gap-1">
                    {% if app.user %}
                        <a href="{{ path('app_home') }}" data-action="click->navbar#close" class="px-3 py-2.5 rounded-lg text-sm font-medium transition {{ route == 'app_home' ? 'text-white bg-gray-800' : 'text-gray-300 hover:text-white hover:bg-gray-800/60' }}">Dashboard</a>
                        <a href="{{ path('app_character_index') }}" data-action="click->navbar#close" class="px-3 py-2.5 rounded-lg text-sm font-medium transition {{ route starts with 'app_character' ? 'text-white bg-gray-800' : 'text-gray-300 hover:text-white hover:bg-gray-800/60' }}">Personnages</a>
                    {% endif %}
                    <a href="{{ path('app_guild_index') }}" data-action="click->navbar#close" class="px-3 py-2.5 rounded-lg text-sm font-medium transition {{ route starts with 'app_guild' ? 'text-white bg-gray-800' : 'text-gray-300 hover:text-white hover:bg-gray-800/60' }}">Les guildes</a>
                    <a href="{{ path('app_raid_guide_index') }}" data-action="click->navbar#close" class="px-3 py-2.5 rounded-lg text-sm font-medium transition {{ route starts with 'app_raid_template_guide' or route == 'app_raid_guide_index' ? 'text-white bg-gray-800' : 'text-gray-300 hover:text-white hover:bg-gray-800/60' }}">Encyclopédie</a>
                    <a href="{{ path('app_raid_index') }}" data-action="click->navbar#close" class="px-3 py-2.5 rounded-lg text-sm font-semibold transition text-yellow-400 hover:text-yellow-300 hover:bg-yellow-400/10">⚔ Trouver un raid</a>

                    <a href="https://ko-fi.com/zeminal" target="_blank" rel="noopener"
                       class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm font-medium text-amber-400 hover:text-amber-300 hover:bg-amber-500/10 transition">
                        ☕ Faire un don
                    </a>

                    <div class="border-t border-gray-800 my-2"></div>

                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('admin_dashboard') }}" data-action="click->navbar#close" class="px-3 py-2.5 rounded-lg text-sm font-medium transition text-yellow-400 hover:bg-yellow-900/20">⚙ Admin</a>
                        {% endif %}
                        <a href="{{ path('app_notifications') }}" data-action="click->navbar#close" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition text-gray-300 hover:text-white hover:bg-gray-800/60">
                            Notifications
                            {% if _unread > 0 %}
                                <span class="min-w-[18px] h-[18px] bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center px-0.5 leading-none">{{ _unread > 9 ? '9+' : _unread }}</span>
                            {% endif %}
                        </a>
                        <div class="flex items-center justify-between px-3 py-2.5">
                            <div class="flex items-center gap-2.5">
                                <div class="w-6 h-6 rounded-full bg-indigo-600 flex items-center justify-center text-xs font-bold text-white shrink-0">
                                    {{ app.user.username|slice(0,1)|upper|default('?') }}
                                </div>
                                <span class="text-sm text-gray-200 font-medium">{{ app.user.username }}</span>
                            </div>
                            <a href="{{ path('app_logout') }}" class="text-sm text-gray-500 hover:text-white transition">Déconnexion</a>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" data-action="click->navbar#close" class="px-3 py-2.5 rounded-lg text-sm font-medium transition text-gray-300 hover:text-white hover:bg-gray-800/60">Connexion</a>
                        <a href="{{ path('app_register') }}" data-action="click->navbar#close" class="px-3 py-2.5 rounded-lg text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white text-center">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </nav>

        {# ── Flash messages ── #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="max-w-6xl mx-auto w-full px-6 mt-4">
                    {{ ui.alert(message, type in ['success','error','warning','info'] ? type : 'info') }}
                </div>
            {% endfor %}
        {% endfor %}

        <main class="flex-1">
            {% block body %}{% endblock %}
        </main>

        {# ── Bouton Ko-fi fixe ── #}
        <a href="https://ko-fi.com/zeminal" target="_blank" rel="noopener"
           class="kofi-fab fixed bottom-6 right-6 z-50 flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-gray-900 font-semibold text-sm px-4 py-2.5 rounded-2xl shadow-lg shadow-amber-500/25 transition-colors">
            <span class="text-base leading-none">☕</span>
            Faire un don
        </a>

        <footer class="border-t border-gray-800/60 mt-auto">
            <div class="max-w-6xl mx-auto px-6 py-10">
                <div class="grid gap-8 md:grid-cols-3">

                    {# Branding #}
                    <div>
                        <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 group mb-3">
                            <span class="text-indigo-400 text-lg group-hover:text-indigo-300 transition">⚔</span>
                            <span class="font-bold text-white tracking-tight">Zeminal</span>
                        </a>
                        <p class="text-xs text-gray-500 leading-relaxed max-w-xs">
                            La plateforme de gestion de raids pour les guildes Dofus. Gratuit, tous serveurs.
                        </p>
                    </div>

                    {# Navigation #}
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Navigation</p>
                        <ul class="space-y-2">
                            <li><a href="{{ path('app_raid_index') }}" class="text-xs text-gray-500 hover:text-gray-300 transition">Raids Dofus</a></li>
                            <li><a href="{{ path('app_guild_index') }}" class="text-xs text-gray-500 hover:text-gray-300 transition">Les guildes</a></li>
                            <li><a href="{{ path('app_raid_guide_index') }}" class="text-xs text-gray-500 hover:text-gray-300 transition">Encyclopédie</a></li>
                            {% if not app.user %}
                                <li><a href="{{ path('app_register') }}" class="text-xs text-gray-500 hover:text-gray-300 transition">Créer un compte</a></li>
                                <li><a href="{{ path('app_login') }}" class="text-xs text-gray-500 hover:text-gray-300 transition">Connexion</a></li>
                            {% endif %}
                        </ul>
                    </div>

                    {# Legal #}
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Légal</p>
                        <ul class="space-y-2">
                            <li><a href="{{ path('app_legal_mentions') }}" class="text-xs text-gray-500 hover:text-gray-300 transition">Mentions légales</a></li>
                            <li><a href="mailto:contact@zeminal.tech" class="text-xs text-gray-500 hover:text-gray-300 transition">Contact</a></li>
                            <li>
                                <a href="https://ko-fi.com/zeminal" target="_blank" rel="noopener"
                                   class="inline-flex items-center gap-1.5 text-xs text-amber-500 hover:text-amber-400 transition font-medium">
                                    ☕ Faire un don
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>

                <div class="border-t border-gray-800/60 mt-8 pt-6 flex flex-col sm:flex-row items-center justify-between gap-2">
                    <p class="text-xs text-gray-600">Zeminal &copy; {{ "now"|date("Y") }} — Tous droits réservés</p>
                    <p class="text-xs text-gray-700">Zeminal n'est pas affilié à Ankama Games</p>
                </div>
            </div>
        </footer>

    </body>
</html>
