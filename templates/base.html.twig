<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Zeminal – Organisez vos raids Dofus en guilde{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Zeminal est l'outil de gestion de raids pour guildes Dofus. Planifiez vos raids, gérez vos personnages et coordonnez votre guilde efficacement.{% endblock %}">
        <meta name="robots" content="{% block meta_robots %}index, follow{% endblock %}">
        <link rel="canonical" href="{{ app.request.uri }}">

        {# Open Graph #}
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Zeminal">
        <meta property="og:title" content="{% block og_title %}Zeminal – Organisez vos raids Dofus en guilde{% endblock %}">
        <meta property="og:description" content="{% block og_description %}Planifiez vos raids Dofus, gérez vos personnages et coordonnez votre guilde. Raids publics visibles par tous les serveurs.{% endblock %}">
        <meta property="og:url" content="{{ app.request.uri }}">

        {# Twitter Card #}
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content="{% block twitter_title %}Zeminal – Organisez vos raids Dofus en guilde{% endblock %}">
        <meta name="twitter:description" content="{% block twitter_description %}Planifiez vos raids Dofus, gérez vos personnages et coordonnez votre guilde.{% endblock %}">

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚔️</text></svg>">

        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebApplication",
            "name": "Zeminal",
            "url": "https://zeminal.tech",
            "description": "Plateforme gratuite de gestion de raids pour les guildes Dofus. Planifiez vos raids, gérez les candidatures et recrutez sur tous les serveurs.",
            "applicationCategory": "GameApplication",
            "operatingSystem": "Web",
            "inLanguage": "fr",
            "offers": {
                "@type": "Offer",
                "price": "0",
                "priceCurrency": "EUR"
            },
            "publisher": {
                "@type": "Organization",
                "name": "Zeminal",
                "url": "https://zeminal.tech"
            }
        }
        </script>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-gray-950 text-gray-100 flex flex-col">

        {% import 'components/_ui.html.twig' as ui %}
        {% set route = app.request.attributes.get('_route', '') %}

        {# ── Navbar ── #}
        <nav class="sticky top-0 z-40 bg-gray-900/90 backdrop-blur-md border-b border-white/5">
            <div class="max-w-6xl mx-auto px-6 h-16 flex items-center gap-6">

                {# Logo #}
                <a href="{{ path('app_home') }}" class="flex items-center gap-2 shrink-0 group">
                    <span class="text-indigo-400 text-xl group-hover:text-indigo-300 transition">⚔</span>
                    <span class="font-bold text-white text-lg tracking-tight">Zeminal</span>
                </a>

                {# Liens de navigation — visibles pour tous #}
                <div class="flex items-center gap-1">
                    {% if app.user %}
                        {% if route starts with 'app_character' %}
                            <a href="{{ path('app_character_index') }}" class="px-3 py-2 rounded-lg text-sm font-medium transition text-white bg-gray-800">Personnages</a>
                        {% else %}
                            <a href="{{ path('app_character_index') }}" class="px-3 py-2 rounded-lg text-sm font-medium transition text-gray-400 hover:text-white hover:bg-gray-800/60">Personnages</a>
                        {% endif %}
                    {% endif %}
                    {% if route starts with 'app_guild' %}
                        <a href="{{ path('app_guild_index') }}" class="px-3 py-2 rounded-lg text-sm font-medium transition text-white bg-gray-800">Guildes</a>
                    {% else %}
                        <a href="{{ path('app_guild_index') }}" class="px-3 py-2 rounded-lg text-sm font-medium transition text-gray-400 hover:text-white hover:bg-gray-800/60">Guildes</a>
                    {% endif %}
                    <span class="relative inline-flex shrink-0">
                        {% if route starts with 'app_raid' %}
                            <a href="{{ path('app_raid_index') }}" class="inline-flex items-center px-3 py-2 rounded-lg text-sm font-semibold transition border border-yellow-400 text-yellow-300">Trouver un raid</a>
                        {% else %}
                            <a href="{{ path('app_raid_index') }}" class="inline-flex items-center px-3 py-2 rounded-lg text-sm font-semibold transition border border-yellow-500/80 text-yellow-400 hover:border-yellow-400 hover:text-yellow-300 nav-cta-pulse">Trouver un raid</a>
                        {% endif %}
                        <span class="absolute -top-2 -right-2 bg-gray-900 px-0.5 rounded-full text-yellow-400 text-xs leading-none select-none pointer-events-none nav-cta-star">✦</span>
                    </span>
                </div>

                {% if app.user %}

                    {# Lien admin #}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_dashboard') }}"
                           class="px-3 py-2 rounded-lg text-sm font-medium transition text-yellow-400 hover:text-yellow-300 hover:bg-yellow-900/20 border border-yellow-800/30">
                            ⚙ Admin
                        </a>
                    {% endif %}

                    {# Profil + déconnexion #}
                    <div class="flex items-center gap-2 ml-auto">
                        <div class="flex items-center gap-2.5 bg-gray-800/60 border border-gray-700/50 rounded-xl px-3 py-1.5">
                            <div class="w-6 h-6 rounded-full bg-indigo-600 flex items-center justify-center text-xs font-bold text-white shrink-0">
                                {{ app.user.username|slice(0,1)|upper|default('?') }}
                            </div>
                            <span class="text-sm text-gray-200 font-medium">{{ app.user.username }}</span>
                        </div>
                        <a href="{{ path('app_logout') }}"
                           title="Déconnexion"
                           class="flex items-center gap-1.5 text-sm text-gray-500 hover:text-white transition px-2.5 py-2 rounded-lg hover:bg-gray-800/60">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h8a1 1 0 110 2H5v12h7a1 1 0 110 2H4a1 1 0 01-1-1V3zm10.293 4.293a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 01-1.414-1.414L14.586 11H7a1 1 0 110-2h7.586l-1.293-1.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                            </svg>
                            <span class="hidden sm:inline text-sm">Déconnexion</span>
                        </a>
                    </div>

                {% else %}

                    <div class="flex items-center gap-2 ml-auto">
                        <a href="{{ path('app_login') }}"
                           class="text-sm text-gray-400 hover:text-white transition px-3 py-2 rounded-lg hover:bg-gray-800/60">
                            Connexion
                        </a>
                        <a href="{{ path('app_register') }}"
                           class="text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg transition">
                            Inscription
                        </a>
                    </div>

                {% endif %}
            </div>
        </nav>

        {# ── Flash messages ── #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="max-w-6xl mx-auto w-full px-6 mt-4">
                    {{ ui.alert(message, type in ['success','error','warning','info'] ? type : 'info') }}
                </div>
            {% endfor %}
        {% endfor %}

        <main class="flex-1">
            {% block body %}{% endblock %}
        </main>

        <footer class="border-t border-gray-800/60 mt-auto">
            <div class="max-w-6xl mx-auto px-6 py-10">
                <div class="grid gap-8 md:grid-cols-3">

                    {# Branding #}
                    <div>
                        <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 group mb-3">
                            <span class="text-indigo-400 text-lg group-hover:text-indigo-300 transition">⚔</span>
                            <span class="font-bold text-white tracking-tight">Zeminal</span>
                        </a>
                        <p class="text-xs text-gray-500 leading-relaxed max-w-xs">
                            La plateforme de gestion de raids pour les guildes Dofus. Gratuit, tous serveurs.
                        </p>
                    </div>

                    {# Navigation #}
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Navigation</p>
                        <ul class="space-y-2">
                            <li><a href="{{ path('app_raid_index') }}" class="text-xs text-gray-500 hover:text-gray-300 transition">Raids Dofus</a></li>
                            <li><a href="{{ path('app_guild_index') }}" class="text-xs text-gray-500 hover:text-gray-300 transition">Guildes</a></li>
                            {% if not app.user %}
                                <li><a href="{{ path('app_register') }}" class="text-xs text-gray-500 hover:text-gray-300 transition">Créer un compte</a></li>
                                <li><a href="{{ path('app_login') }}" class="text-xs text-gray-500 hover:text-gray-300 transition">Connexion</a></li>
                            {% endif %}
                        </ul>
                    </div>

                    {# Legal #}
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Légal</p>
                        <ul class="space-y-2">
                            <li><a href="{{ path('app_legal_mentions') }}" class="text-xs text-gray-500 hover:text-gray-300 transition">Mentions légales</a></li>
                            <li><a href="mailto:contact@zeminal.tech" class="text-xs text-gray-500 hover:text-gray-300 transition">Contact</a></li>
                        </ul>
                    </div>

                </div>

                <div class="border-t border-gray-800/60 mt-8 pt-6 flex flex-col sm:flex-row items-center justify-between gap-2">
                    <p class="text-xs text-gray-600">Zeminal &copy; {{ "now"|date("Y") }} — Tous droits réservés</p>
                    <p class="text-xs text-gray-700">Zeminal n'est pas affilié à Ankama Games</p>
                </div>
            </div>
        </footer>

    </body>
</html>
