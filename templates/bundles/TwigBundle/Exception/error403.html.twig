{% extends 'base.html.twig' %}

{% block title %}Accès refusé — Zeminal{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-6 py-24 text-center">
    <div class="text-7xl mb-6 select-none">🔒</div>
    <p class="text-indigo-400 font-mono text-sm font-semibold uppercase tracking-widest mb-3">Erreur 403</p>
    <h1 class="text-2xl font-bold text-white mb-4">Accès refusé</h1>
    <p class="text-gray-400 mb-10 leading-relaxed">
        Tu n'as pas les droits pour accéder à cette page.
        {% if not app.user %}
            <br><span class="text-gray-500">Connecte-toi pour continuer.</span>
        {% endif %}
    </p>
    <div class="flex items-center justify-center gap-4 flex-wrap">
        {% if not app.user %}
            <a href="{{ path('app_login') }}"
               class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-6 py-3 rounded-xl transition">
                Se connecter
            </a>
        {% endif %}
        <a href="{{ path('app_home') }}"
           class="inline-flex items-center gap-2 bg-gray-800 hover:bg-gray-700 text-gray-200 font-semibold px-6 py-3 rounded-xl transition">
            ← Retour à l'accueil
        </a>
    </div>
</div>
{% endblock %}
