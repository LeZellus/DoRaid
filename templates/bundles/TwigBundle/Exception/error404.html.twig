{% extends 'base.html.twig' %}

{% block title %}Page introuvable — DoRaid{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-6 py-24 text-center">
    <div class="text-7xl mb-6 select-none">🗺️</div>
    <p class="text-indigo-400 font-mono text-sm font-semibold uppercase tracking-widest mb-3">Erreur 404</p>
    <h1 class="text-2xl font-bold text-white mb-4">Cette page n'existe pas</h1>
    <p class="text-gray-400 mb-10 leading-relaxed">
        La page que tu cherches a peut-être été supprimée ou l'adresse est incorrecte.
    </p>
    <div class="flex items-center justify-center gap-4 flex-wrap">
        <a href="{{ path('app_home') }}"
           class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-6 py-3 rounded-xl transition">
            ← Retour à l'accueil
        </a>
        <a href="{{ path('app_guild_index') }}"
           class="inline-flex items-center gap-2 bg-gray-800 hover:bg-gray-700 text-gray-200 font-semibold px-6 py-3 rounded-xl transition">
            Voir les guildes
        </a>
    </div>
</div>
{% endblock %}
