{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }} — Zeminal{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-6 py-24 text-center">
    <div class="text-7xl mb-6 select-none">⚠️</div>
    <p class="text-indigo-400 font-mono text-sm font-semibold uppercase tracking-widest mb-3">Erreur {{ status_code }}</p>
    <h1 class="text-2xl font-bold text-white mb-4">Quelque chose s'est mal passé</h1>
    <p class="text-gray-400 mb-10 leading-relaxed">
        Une erreur inattendue est survenue. Si le problème persiste, n'hésite pas à le signaler.
    </p>
    <a href="{{ path('app_home') }}"
       class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-6 py-3 rounded-xl transition">
        ← Retour à l'accueil
    </a>
</div>
{% endblock %}
