{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Inscription – Zeminal{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block body %}
<div class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 py-12">

    {# Gradient background #}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(99,102,241,0.12)_0%,transparent_60%)] pointer-events-none"></div>

    <div class="relative w-full max-w-md">

        {# Logo #}
        <div class="text-center mb-8">
            <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 group">
                <span class="text-indigo-400 text-2xl group-hover:text-indigo-300 transition">⚔</span>
                <span class="text-2xl font-bold text-white tracking-tight">Zeminal</span>
            </a>
            <p class="text-gray-500 text-sm mt-2">Rejoignez la communauté Dofus</p>
        </div>

        {# Card #}
        <div class="bg-gray-900/80 border border-gray-800/60 rounded-2xl p-8 shadow-2xl backdrop-blur-sm">

            {# Discord en premier #}
            {{ ui.discord_button("S'inscrire avec Discord", path('app_discord_connect')) }}

            {{ ui.divider('ou avec un email') }}

            {{ form_start(form, {attr: {class: 'space-y-5', novalidate: 'novalidate'}}) }}
                {{ form_row(form.username) }}
                {{ form_row(form.email) }}
                {{ form_row(form.plainPassword) }}
                {{ form_row(form.agreeTerms) }}

                {{ ui.button('Créer mon compte', 'primary', 'submit', 'w-full py-3') }}
            {{ form_end(form) }}
        </div>

        <p class="text-center text-sm text-gray-500 mt-6">
            Déjà un compte ?
            <a href="{{ path('app_login') }}" class="text-indigo-400 hover:text-indigo-300 font-medium transition">Se connecter</a>
        </p>
    </div>
</div>
{% endblock %}
