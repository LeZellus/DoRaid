{% extends 'base.html.twig' %}
{% import 'components/_ui.html.twig' as ui %}

{% block title %}Inscription – DoRaid{% endblock %}

{% block body %}
<div class="flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
        <h1 class="text-3xl font-bold text-white text-center mb-8">Créer un compte</h1>

        {{ form_start(form, {attr: {class: 'space-y-5', novalidate: 'novalidate'}}) }}
            {{ form_row(form.username) }}
            {{ form_row(form.email) }}
            {{ form_row(form.plainPassword) }}
            {{ form_row(form.agreeTerms) }}

            {{ ui.button('Créer mon compte', 'primary', 'submit', 'w-full') }}
        {{ form_end(form) }}

        {{ ui.divider('ou') }}

        {{ ui.discord_button("S'inscrire avec Discord", path('app_discord_connect')) }}

        <p class="text-center text-sm text-gray-500 mt-6">
            Déjà un compte ?
            <a href="{{ path('app_login') }}" class="text-indigo-400 hover:text-indigo-300">Se connecter</a>
        </p>
    </div>
</div>
{% endblock %}
